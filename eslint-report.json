 params?: Record<string, string>; body?: Record<string, unknown> };\n    const user = req.user as { id?: string; role?: string } | undefined;\n    if (!user?.id) {\n      throw new UnauthorizedException('Authentication required');\n    }\n\n    if (user.role === 'SUPER_ADMIN') {\n      return true;\n    }\n\n    const businessId = req.params?.businessId || req.body?.businessId;\n    this.logger.debug(`BusinessGuard checking businessId: ${businessId} for userId: ${user.id}`);\n    if (!businessId) {\n      throw new ForbiddenException('businessId is required');\n    }\n\n    if (!this.prisma?.client) {\n      this.logger.error('PrismaService not available, rejecting request');\n      throw new ForbiddenException('Service unavailable');\n    }\n\n    try {\n      const business = await this.prisma.client.business.findFirst({\n        where: {\n          id: businessId,\n          OR: [\n            { ownerId: user.id },\n            { members: { some: { userId: user.id } } },\n          ],\n        },\n      });\n\n      if (!business) {\n        throw new ForbiddenException('No access to this business');\n      }\n    } catch (err) {\n      if (err instanceof ForbiddenException || err instanceof UnauthorizedException) {\n        throw err;\n      }\n      this.logger.error(`BusinessGuard error: ${(err as Error).message}`);\n      throw new ForbiddenException('Unable to verify business access');\n    }\n\n    return true;\n  }\n\n  /**\n   * Run a callback within the tenant context of the current request.\n   * This ensures Prisma tenant isolation middleware can auto-filter queries.\n   */\n  static runInContext<T>(req: any, fn: () => T): T {\n    const businessId = req.params?.businessId || req.body?.businessId;\n    const userId = req.user?.id;\n    if (!businessId || !userId) return fn();\n    return runWithTenant(businessId, userId, fn);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\server\\src\\core\\auth\\module-