# Always install devDependencies, even when NODE_ENV=production.
#
# Render sets NODE_ENV=production for the service, and pnpm honours that at
# INSTALL time by skipping devDependencies. The build log said so directly:
#
#   devDependencies: skipped because NODE_ENV is set to production
#
# typescript and @types/node are devDependencies, so every `tsc` in the build
# ran without a compiler or node types. What it resolved to instead was a
# TypeScript 7 pulled in transitively by a production dependency, which has
# removed `baseUrl` and `moduleResolution: node10` — so it rejected tsconfig
# files that are perfectly valid for the TypeScript 5.9 this repo pins:
#
#   error TS2688: Cannot find type definition file for 'node'
#   error TS5102: Option 'baseUrl' has been removed
#   error TS5108: Option 'moduleResolution=node10' has been removed
#
# Setting it here rather than only as `--prod=false` in the build command means
# it holds no matter which host runs the install, including a Render service
# whose build command is managed in the dashboard rather than by render.yaml.
#
# This is a monorepo that compiles from source at deploy time; it needs its
# build toolchain present in every environment that builds it. The cost is a
# larger install on the deployment host, which is the right trade for a build
# that otherwise cannot run at all.
#
# UNVERIFIED against Render. It could not be reproduced locally: pnpm's own
# default for `prod` is already false, and on Windows the NODE_ENV prefix does
# not reach pnpm through its .cmd shim, so the skip never occurs here to be
# fixed. What IS confirmed is that an explicit --prod skips devDependencies and
# that pnpm documents --dev/--prod as applying "regardless of the NODE_ENV".
#
# Treat `--prod=false` in the build command as the reliable fix and this as
# defence in depth for hosts whose build command is not managed by render.yaml.
prod=false
