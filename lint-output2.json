w', includeUncontrolled: true }).then((clientList) => {\n      for (const client of clientList) {\n        if (client.url.includes(url) && 'focus' in client) {\n          return client.focus();\n        }\n      }\n      if (self.clients.openWindow) {\n        return self.clients.openWindow(url);\n      }\n    }),\n  );\n});\n\n} /* end production else block */\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\public\\widgets\\v1\\loader.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\scripts\\check-tool-routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\sentry.client.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\sentry.edge.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\sentry.server.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\_lib\\PresenceTracker.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\_lib