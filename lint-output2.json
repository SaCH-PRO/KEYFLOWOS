= 25;\n\n  const load = useCallback(async () => {\n    setLoading(true);\n    try {\n      const res = await fetchAdminUsers(search || undefined, limit, offset);\n      if (res.data) {\n        setUsers(res.data.items);\n        setTotal(res.data.total);\n      }\n    } catch (e) {\n      console.error(\"Failed to load users\", e);\n    } finally {\n      setLoading(false);\n    }\n  }, [search, offset]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-2xl font-semibold tracking-tight\">Users</h1>\n          <p className=\"text-sm text-muted-foreground\">Platform-wide user list with quick diagnostics.</p>\n        </div>\n        <div className=\"text-sm text-muted-foreground\">\n          <Users className=\"inline w-4 h-4 mr-1\" />\n          {total} total\n        </div>\n      </div>\n\n      <div className=\"relative\">\n        <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground\" />\n        <input\n          type=\"text\"\n          placeholder=\"Search users...\"\n          value={search}\n          onChange={(e) => { setSearch(e.target.value); setOffset(0); }}\n          className=\"w-full max-w-sm rounded-xl border border-border/60 bg-card/50 pl-9 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30\"\n        />\n      </div>\n\n      <div className=\"overflow-hidden rounded-2xl border border-border/70 bg-slate-950/70\">\n        <table className=\"min-w-full text-sm\">\n          <thead className=\"bg-slate-900/70 text-muted-foreground\">\n            <tr>\n              <th className=\"px-4 py-3 text-left font-medium\">User</th>\n              <th className=\"px-4 py-3 text-left font-medium\">Role</th>\n              <th className=\"px-4 py-3 text-left font-medium\">Businesses</th>\n              <th className=\"px-4 py-3 text-left font-medium\">Status</th>\n            </tr>\n          </thead>\n          <tbody>\n            {loading && users.length === 0 ? (\n              <tr><td colSpan={4} className=\"px-4 py-8 text-center text-muted-foreground\">Loading...</td></tr>\n            ) : users.length === 0 ? (\n              <tr><td colSpan={4} className=\"px-4 py-8 text-center text-muted-foreground\">No users found.</td></tr>\n            ) : (\n              users.map((u) => (\n                <tr key={u.id} className=\"border-t border-border/60\">\n                  <td className=\"px-4 py-3\">\n                    <div className=\"flex items-center gap-2\">\n                      {u.avatarUrl ? (\n                        <img src={u.avatarUrl} alt=\"\" className=\"w-6 h-6 rounded-full\" />\n                      ) : (\n                        <div className=\"w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center text-[10px] font-bold\">\n                          {u.name?.charAt(0)?.toUpperCase() || u.email.charAt(0).toUpperCase()}\n                        </div>\n                      )}\n                      <div>\n                        <div className=\"font-medium\">{u.name}</div>\n                        <div className=\"text-xs text-muted-foreground\">{u.email}</div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-4 py-3 text-muted-foreground\">{u.role}</td>\n                  <td className=\"px-4 py-3 text-muted-foreground\">{u.businessCount}</td>\n                  <td className=\"px-4 py-3\">\n                    <span className=\"inline-flex items-center gap-1 rounded-full border border-primary/40 bg-primary/10 px-2 py-1 text-[11px] text-primary\">\n                      <span className=\"h-1.5 w-1.5 rounded-full bg-primary\" />\n                      active\n                    </span>\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      {total > limit && (\n        <div className=\"flex items-center justify-between text-sm\">\n          <button\n            onClick={() => setOffset((o) => Math.max(0, o - limit))}\n            disabled={offset === 0}\n            className=\"px-3 py-1.5 rounded-lg border border-border/60 bg-card/50 disabled:opacity-40\"\n          >\n            Previous\n          </button>\n          <span className=\"text-muted-foreground text-xs\">\n            {offset + 1}–{Math.min(offset + limit, total)} of {total}\n          </span>\n          <button\n            onClick={() => setOffset((o) => o + limit)}\n            disabled={offset + limit >= total}\n            className=\"px-3 py-1.5 rounded-lg border border-border/60 bg-card/50 disabled:opacity-40\"\n          >\n            Next\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\api\\actions\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\api\\ai\\suggest\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\api\\bookings\\calendar\\callback\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\app\\api\\commerce\\gmail\\callback\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}