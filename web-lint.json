 eslint-disable-next-line react-hooks/purity -- audited: time-relative days-since computation\n> 465 |       const daysSince = lastTs ? Math.floor((Date.now() - lastTs) / 86400000) : 999;\n      |                                              ^^^^^^^^^^ Cannot call impure function\n  466 |       return {\n  467 |         totalRevenue: s.totalRevenue,\n  468 |         bookingsCount: s.bookingsCount,","line":465,"column":46,"nodeType":null,"endLine":465,"endColumn":56,"suppressions":[{"kind":"directive","justification":"audited: time-relative days-since computation"}]},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\contacts\\timeline-tab-panel.tsx:479:44\n  477 |     const lastTs = ts.length > 0 ? Math.max(...ts) : null;\n  478 |     // eslint-disable-next-line react-hooks/purity -- audited: time-relative days-since computation\n> 479 |     const daysSince = lastTs ? Math.floor((Date.now() - lastTs) / 86400000) : 999;\n      |                                            ^^^^^^^^^^ Cannot call impure function\n  480 |     const momentum = computeMomentumScore(events.length, bookings.length, paidRevenue, daysSince);\n  481 |     const engLevel: \"high\" | \"medium\" | \"low\" = events.length >= 10 ? \"high\" : events.length >= 3 ? \"medium\" : \"low\";\n  482 |     return { totalRevenue: paidRevenue, bookingsCount: bookings.length, lastInteractionTs: lastTs, momentum, engagementLevel: engLevel, daysSinceLastInteraction: daysSince };","line":479,"column":44,"nodeType":null,"endLine":479,"endColumn":54,"suppressions":[{"kind":"directive","justification":"audited: time-relative days-since computation"}]},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\contacts\\timeline-tab-panel.tsx:494:32\n  492 |       const d = new Date(e.timestamp);\n  493 |       // eslint-disable-next-line react-hooks/purity -- audited: time-relative grouping\n> 494 |       const diff = Math.floor((Date.now() - d.getTime()) / 86400000);\n      |                                ^^^^^^^^^^ Cannot call impure function\n  495 |       let label: string;\n  496 |       if (diff <= 0) label = \"Today\";\n  497 |       else if (diff === 1) label = \"Yesterday\";","line":494,"column":32,"nodeType":null,"endLine":494,"endColumn":42,"suppressions":[{"kind":"directive","justification":"audited: time-relative grouping"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\dev-hmr-error-suppressor.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\device\\capture-button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\device\\capture-sheet.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":405,"column":13,"nodeType":"JSXOpeningElement","endLine":409,"endColumn":15}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport { useState, useRef } from \"react\";\r\nimport { useRouter } from \"next/navigation\";\r\nimport {\r\n  Camera,\r\n  Upload,\r\n  CreditCard,\r\n  Receipt,\r\n  FileText,\r\n  Package,\r\n  Mic,\r\n  Loader2,\r\n  CheckCircle2,\r\n  AlertCircle,\r\n} from \"lucide-react\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport {\r\n  Sheet,\r\n  SheetContent,\r\n  SheetHeader,\r\n  SheetTitle,\r\n} from \"@/components/ui/sheet\";\r\nimport {\r\n  createCapture,\r\n  createContactFromCard,\r\n  type CaptureResult,\r\n} from \"@/lib/api/device\";\r\nimport { apiPostSimple } from \"@/lib/api\";\r\n\r\ninterface CaptureSheetProps {\r\n  businessId: string;\r\n  open: boolean;\r\n  onClose: () => void;\r\n  onCaptureCreated?: () => void;\r\n}\r\n\r\ntype CaptureMode =\r\n  | \"camera\"\r\n  | \"upload\"\r\n  | \"business_card\"\r\n  | \"receipt\"\r\n  | \"document\"\r\n  | \"product\"\r\n  | \"voice\";\r\n\r\ninterface CaptureOption {\r\n  id: CaptureMode;\r\n  label: string;\r\n  description: string;\r\n  icon: React.ReactNode;\r\n  capture?: string;\r\n  accept?: string;\r\n}\r\n\r\nconst OPTIONS: CaptureOption[] = [\r\n  {\r\n    id: \"camera\",\r\n    label: \"Take Photo\",\r\n    description: \"Capture anything with your camera\",\r\n    icon: <Camera className=\"h-5 w-5\" />,\r\n    capture: \"environment\",\r\n    accept: \"image/*\",\r\n  },\r\n  {\r\n    id: \"upload\",\r\n    label: \"Upload File\",\r\n    description: \"Choose from your device\",\r\n    icon: <Upload className=\"h-5 w-5\" />,\r\n    accept: \"image/*,video/*,audio/*,application/pdf\",\r\n  },\r\n  {\r\n    id: \"business_card\",\r\n    label: \"Scan Business Card\",\r\n    description: \"Extract contact details\",\r\n    icon: <CreditCard className=\"h-5 w-5\" />,\r\n    capture: \"environment\",\r\n    accept: \"image/*\",\r\n  },\r\n  {\r\n    id: \"receipt\",\r\n    label: \"Scan Receipt\",\r\n    description: \"Create expense record\",\r\n    icon: <Receipt className=\"h-5 w-5\" />,\r\n    capture: \"environment\",\r\n    accept: \"image/*\",\r\n  },\r\n  {\r\n    id: \"document\",\r\n    label: \"Scan Document\",\r\n    description: \"Save and summarize\",\r\n    icon: <FileText className=\"h-5 w-5\" />,\r\n    capture: \"environment\",\r\n    accept: \"image/*,application/pdf\",\r\n  },\r\n  {\r\n    id: \"product\",\r\n    label: \"Scan Product\",\r\n    description: \"Update inventory\",\r\n    icon: <Package className=\"h-5 w-5\" />,\r\n    capture: \"environment\",\r\n    accept: \"image/*\",\r\n  },\r\n  {\r\n    id: \"voice\",\r\n    label: \"Voice Note\",\r\n    description: \"Record or talk to KEY\",\r\n    icon: <Mic className=\"h-5 w-5\" />,\r\n    accept: \"audio/*\",\r\n  },\r\n];\r\n\r\nexport function CaptureSheet({\r\n  businessId,\r\n  open,\r\n  onClose,\r\n  onCaptureCreated,\r\n}: CaptureSheetProps) {\r\n  const [step, setStep] = useState<\r\n    \"menu\" | \"uploading\" | \"result\" | \"batch-done\" | \"error\"\r\n  >(\"menu\");\r\n  const [result, setResult] = useState<CaptureResult | null>(null);\r\n  const [error, setError] = useState<string>(\"\");\r\n  const fileInputRef = useRef<HTMLInputElement>(null);\r\n  const [pendingMode, setPendingMode] = useState<CaptureMode | null>(null);\r\n  const [batchProgress, setBatchProgress] = useState<{\r\n    current: number;\r\n    total: number;\r\n  } | null>(null);\r\n\r\n  const handleOptionClick = (option: CaptureOption) => {\r\n    setPendingMode(option.id);\r\n    if (fileInputRef.current) {\r\n      fileInputRef.current.accept = option.accept ?? \"*\";\r\n      fileInputRef.current.capture = option.capture ?? \"\";\r\n      fileInputRef.current.click();\r\n    }\r\n  };\r\n\r\n  const uploadFile = async (file: File, mode: CaptureMode) => {\r\n    // 1. Get presigned upload URL\r\n    const presignedRes = await apiPostSimple<{\r\n      uploadURL: string;\r\n      objectPath: string;\r\n    }>(\"/uploads/request-url\", {\r\n      name: file.name,\r\n      size: file.size,\r\n      contentType: file.type,\r\n    });\r\n    if (presignedRes.error || !presignedRes.data) {\r\n      throw new Error(presignedRes.error ?? \"Failed to get upload URL\");\r\n    }\r\n    const presigned = presignedRes.data;\r\n\r\n    // 2. Upload file directly to storage\r\n    const uploadRes = await fetch(presigned.uploadURL, {\r\n      method: \"PUT\",\r\n      body: file,\r\n      headers: { \"Content-Type\": file.type },\r\n    });\r\n    if (!uploadRes.ok) throw new Error(\"Upload failed\");\r\n\r\n    // 3. Create capture record\r\n    const mediaType: \"image\" | \"video\" | \"audio\" | \"document\" = file.type.startsWith(\r\n      \"image/\",\r\n    )\r\n      ? \"image\"\r\n      : file.type.startsWith(\"video/\")\r\n        ? \"video\"\r\n        : file.type.startsWith(\"audio/\")\r\n          ? \"audio\"\r\n          : \"document\";\r\n\r\n    const captureRes = await createCapture(businessId, {\r\n      objectPath: presigned.objectPath,\r\n      fileName: file.name,\r\n      contentType: file.type,\r\n      sizeBytes: file.size,\r\n      mediaType,\r\n      source: \"capture\",\r\n      captureMode: mode,\r\n    });\r\n    if (captureRes.error || !captureRes.data) {\r\n      throw new Error(captureRes.error ?? \"Failed to create capture\");\r\n    }\r\n\r\n    return captureRes.data;\r\n  };\r\n\r\n  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\r\n    const files = Array.from(e.target.files ?? []);\r\n    if (files.length === 0 || !pendingMode) return;\r\n\r\n    setStep(\"uploading\");\r\n    setError(\"\");\r\n    setBatchProgress({ current: 0, total: files.length });\r\n\r\n    try {\r\n      const results: CaptureResult[] = [];\r\n      for (let i = 0; i < files.length; i++) {\r\n        setBatchProgress({ current: i + 1, total: files.length });\r\n        const res = await uploadFile(files[i], pendingMode);\r\n        results.push(res);\r\n      }\r\n\r\n      if (files.length === 1 && results[0]) {\r\n        setResult(results[0]);\r\n        setStep(\"result\");\r\n      } else {\r\n        setStep(\"batch-done\");\r\n      }\r\n\r\n      onCaptureCreated?.();\r\n    } catch (err) {\r\n      setError(err instanceof Error ? err.message : \"Capture failed\");\r\n      setStep(\"error\");\r\n    } finally {\r\n      if (fileInputRef.current) fileInputRef.current.value = \"\";\r\n      setPendingMode(null);\r\n      setBatchProgress(null);\r\n    }\r\n  };\r\n\r\n  const handleReset = () => {\r\n    setStep(\"menu\");\r\n    setResult(null);\r\n    setError(\"\");\r\n  };\r\n\r\n  const handleDone = () => {\r\n    onClose();\r\n    handleReset();\r\n  };\r\n\r\n  return (\r\n    <Sheet\r\n      open={open}\r\n      onOpenChange={(v: boolean) => {\r\n        if (!v) {\r\n          onClose();\r\n          handleReset();\r\n        }\r\n      }}\r\n    >\r\n      <SheetContent className=\"w-full sm:max-w-md overflow-y-auto\">\r\n        <SheetHeader>\r\n          <SheetTitle className=\"flex items-center gap-2\">\r\n            <Camera className=\"h-5 w-5\" />\r\n            Capture\r\n          </SheetTitle>\r\n        </SheetHeader>\r\n\r\n        <input\r\n          ref={fileInputRef}\r\n          type=\"file\"\r\n          multiple\r\n          className=\"hidden\"\r\n          onChange={handleFileChange}\r\n        />\r\n\r\n        {step === \"menu\" && (\r\n          <div className=\"grid grid-cols-1 gap-3 mt-6\">\r\n            <p className=\"text-sm text-muted-foreground mb-2\">\r\n              Capture something for your business\r\n            </p>\r\n            {OPTIONS.map((opt) => (\r\n              <button\r\n                key={opt.id}\r\n                onClick={() => handleOptionClick(opt)}\r\n                className=\"flex items-start gap-4 p-4 rounded-xl border bg-card hover:bg-accent transition-colors text-left\"\r\n              >\r\n                <div className=\"mt-0.5 text-primary\">{opt.icon}</div>\r\n                <div>\r\n                  <div className=\"font-medium\">{opt.label}</div>\r\n                  <div className=\"text-sm text-muted-foreground\">\r\n                    {opt.description}\r\n                  </div>\r\n                </div>\r\n              </button>\r\n            ))}\r\n          </div>\r\n        )}\r\n\r\n        {step === \"uploading\" && (\r\n          <div className=\"flex flex-col items-center justify-center py-16 gap-4\">\r\n            <Loader2 className=\"h-10 w-10 animate-spin text-primary\" />\r\n            <p className=\"text-muted-foreground\">\r\n              {batchProgress\r\n                ? `Uploading ${batchProgress.current} of ${batchProgress.total}…`\r\n                : \"Uploading and analyzing…\"}\r\n            </p>\r\n          </div>\r\n        )}\r\n\r\n        {step === \"result\" && result && (\r\n          <CaptureResultView\r\n            result={result}\r\n            businessId={businessId}\r\n            onReset={handleReset}\r\n            onClose={handleDone}\r\n          />\r\n        )}\r\n\r\n        {step === \"batch-done\" && (\r\n          <div className=\"flex flex-col items-center justify-center py-16 gap-4\">\r\n            <CheckCircle2 className=\"h-10 w-10 text-green-600\" />\r\n            <p className=\"font-medium\">Uploads complete</p>\r\n            <p className=\"text-sm text-muted-foreground\">\r\n              Your captures have been uploaded and are being processed.\r\n            </p>\r\n            <Button onClick={handleDone}>Done</Button>\r\n          </div>\r\n        )}\r\n\r\n        {step === \"error\" && (\r\n          <div className=\"flex flex-col items-center justify-center py-16 gap-4\">\r\n            <AlertCircle className=\"h-10 w-10 text-destructive\" />\r\n            <p className=\"text-destructive font-medium\">Capture failed</p>\r\n            <p className=\"text-sm text-muted-foreground text-center max-w-xs\">\r\n              {error}\r\n            </p>\r\n            <Button onClick={handleReset}>Try Again</Button>\r\n          </div>\r\n        )}\r\n      </SheetContent>\r\n    </Sheet>\r\n  );\r\n}\r\n\r\nfunction CaptureResultView({\r\n  result,\r\n  businessId,\r\n  onReset,\r\n  onClose,\r\n}: {\r\n  result: CaptureResult;\r\n  businessId: string;\r\n  onReset: () => void;\r\n  onClose: () => void;\r\n}) {\r\n  const router = useRouter();\r\n  const { asset, intake, classification } = result;\r\n  const [actionLoading, setActionLoading] = useState<string | null>(null);\r\n\r\n  const handleAction = async (action: Record<string, unknown>) => {\r\n    const type = action.type as string;\r\n    if (!type) {\r\n      onClose();\r\n      return;\r\n    }\r\n\r\n    if (type === \"create_contact\") {\r\n      if (!intake) {\r\n        onClose();\r\n        return;\r\n      }\r\n      const data = classification?.extractedData ?? {};\r\n      setActionLoading(\"contact\");\r\n      try {\r\n        const res = await createContactFromCard(businessId, {\r\n          visualIntakeId: intake.id,\r\n          name: data.name as string | undefined,\r\n          phone: data.phone as string | undefined,\r\n          email: data.email as string | undefined,\r\n          company: data.company as string | undefined,\r\n          title: data.title as string | undefined,\r\n          website: data.website as string | undefined,\r\n        });\r\n        if (res.error) throw new Error(res.error);\r\n      } catch {\r\n        // silently fail; user can retry from detail page\r\n      } finally {\r\n        setActionLoading(null);\r\n        onClose();\r\n      }\r\n      return;\r\n    }\r\n\r\n    if (type === \"create_expense\") {\r\n      const data = classification?.extractedData ?? {};\r\n      const prefill = encodeURIComponent(JSON.stringify(data));\r\n      router.push(`/app/expenses?prefill=${prefill}`);\r\n      return;\r\n    }\r\n\r\n    if (type === \"review\" || type === \"review_manually\") {\r\n      router.push(`/app/capture/${asset.id}`);\r\n      return;\r\n    }\r\n\r\n    // Default fallback for unknown actions\r\n    onClose();\r\n  };\r\n\r\n  return (\r\n    <div className=\"mt-6 space-y-4\">\r\n      <div className=\"flex items-center gap-2 text-green-600\">\r\n        <CheckCircle2 className=\"h-5 w-5\" />\r\n        <span className=\"font-medium\">Captured successfully</span>\r\n      </div>\r\n\r\n      {asset.publicUrl && (\r\n        <div className=\"rounded-lg overflow-hidden border bg-muted\">\r\n          {asset.mediaType === \"image\" ? (\r\n            <img\r\n              src={asset.publicUrl}\r\n              alt={asset.fileName ?? \"capture\"}\r\n              className=\"w-full h-48 object-cover\"\r\n            />\r\n          ) : (\r\n            <div className=\"h-48 flex items-center justify-center text-muted-foreground\">\r\n              {asset.fileName}\r\n            </div>\r\n          )}\r\n        </div>\r\n      )}\r\n\r\n      {classification && (\r\n        <div className=\"rounded-lg border p-4 space-y-2\">\r\n          <div className=\"flex items-center justify-between\">\r\n            <span className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">\r\n              Detected\r\n            </span>\r\n            <ConfidenceBadge score={classification.confidenceScore} />\r\n          </div>\r\n          <p className=\"font-medium capitalize\">\r\n            {classification.detectedType.replace(/_/g, \" \")}\r\n          </p>\r\n          <p className=\"text-sm text-muted-foreground\">\r\n            {classification.summary}\r\n          </p>\r\n\r\n          {classification.extractedData &&\r\n            Object.keys(classification.extractedData).length > 0 && (\r\n              <div className=\"pt-2\">\r\n                <p className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-1\">\r\n                  Extracted\r\n                </p>\r\n                <dl className=\"grid grid-cols-2 gap-x-4 gap-y-1 text-sm\">\r\n                  {Object.entries(classification.extractedData).map(\r\n                    ([key, value]) => (\r\n                      <div key={key} className=\"contents\">\r\n                        <dt className=\"text-muted-foreground capitalize\">\r\n                          {key.replace(/_/g, \" \")}\r\n                        </dt>\r\n                        <dd className=\"font-medium\">{String(value)}</dd>\r\n                      </div>\r\n                    ),\r\n                  )}\r\n                </dl>\r\n              </div>\r\n            )}\r\n\r\n          {classification.recommendedActions.length > 0 && (\r\n            <div className=\"pt-2 space-y-2\">\r\n              <p className=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground\">\r\n                Suggested Actions\r\n              </p>\r\n              {classification.recommendedActions.map(\r\n                (action: Record<string, unknown>, i: number) => (\r\n                  <Button\r\n                    key={i}\r\n                    variant=\"outline\"\r\n                    size=\"sm\"\r\n                    className=\"w-full justify-start\"\r\n                    loading={actionLoading === `action-${i}`}\r\n                    disabled={!!actionLoading}\r\n                    onClick={() => handleAction(action)}\r\n                  >\r\n                    {action.label ? String(action.label) : \"Action\"}\r\n                  </Button>\r\n                ),\r\n              )}\r\n            </div>\r\n          )}\r\n        </div>\r\n      )}\r\n\r\n      <div className=\"flex gap-2 pt-2\">\r\n        <Button variant=\"outline\" className=\"flex-1\" onClick={onReset}>\r\n          <Camera className=\"h-4 w-4 mr-2\" />\r\n          Capture Another\r\n        </Button>\r\n        <Button className=\"flex-1\" onClick={onClose}>\r\n          Done\r\n        </Button>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nfunction ConfidenceBadge({ score }: { score: number }) {\r\n  if (score >= 80) {\r\n    return (\r\n      <span className=\"text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400\">\r\n        {score}% confidence\r\n      </span>\r\n    );\r\n  }\r\n  if (score >= 60) {\r\n    return (\r\n      <span className=\"text-xs font-medium px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400\">\r\n        {score}% confidence\r\n      </span>\r\n    );\r\n  }\r\n  return (\r\n    <span className=\"text-xs font-medium px-2 py-0.5 rounded-full bg-red-500/10 text-red-400\">\r\n      {score}% confidence\r\n    </span>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\dormant-feature-gate.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\dormant-route.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\email\\compose-context.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\email\\compose-fab.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\email\\compose-modal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\finance\\currency-input.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\finance\\inline-line-item-builder.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'idx' is defined but never used. Allowed unused args must match /^_/u.","line":123,"column":31,"nodeType":"Identifier","messageId":"unusedVar","endLine":123,"endColumn":34}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useCallback, useMemo } from \"react\";\nimport { Plus, Trash2, AlertCircle } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\n\nexport interface LineItem {\n  id: string;\n  accountId?: string;\n  accountName?: string;\n  productId?: string;\n  productName?: string;\n  description: string;\n  quantity?: number;\n  unitPrice?: number;\n  debit?: number;\n  credit?: number;\n  memo?: string;\n}\n\ninterface InlineLineItemBuilderProps {\n  items: LineItem[];\n  onChange: (items: LineItem[]) => void;\n  mode: \"journal\" | \"product\";\n  accounts?: Array<{ id: string; name: string; code?: string | null }>;\n  products?: Array<{ id: string; name: string; sku?: string | null; stock?: number }>;\n  currency?: string;\n  errors?: Record<string, string>;\n  disabled?: boolean;\n}\n\nexport function InlineLineItemBuilder({\n  items,\n  onChange,\n  mode,\n  accounts = [],\n  products = [],\n  currency = \"TTD\",\n  errors = {},\n  disabled = false,\n}: InlineLineItemBuilderProps) {\n  const generateId = () => `li_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n\n  const addRow = useCallback(() => {\n    onChange([\n      ...items,\n      {\n        id: generateId(),\n        description: \"\",\n        quantity: mode === \"product\" ? 1 : undefined,\n        unitPrice: mode === \"product\" ? 0 : undefined,\n        debit: mode === \"journal\" ? 0 : undefined,\n        credit: mode === \"journal\" ? 0 : undefined,\n        memo: \"\",\n      },\n    ]);\n  }, [items, onChange, mode]);\n\n  const removeRow = useCallback(\n    (id: string) => {\n      onChange(items.filter((item) => item.id !== id));\n    },\n    [items, onChange]\n  );\n\n  const updateRow = useCallback(\n    (id: string, patch: Partial<LineItem>) => {\n      onChange(\n        items.map((item) => {\n          if (item.id !== id) return item;\n          const next = { ...item, ...patch };\n          if (mode === \"product\") {\n            const qty = Number(next.quantity ?? 0);\n            const price = Number(next.unitPrice ?? 0);\n            next.debit = qty * price;\n          }\n          return next;\n        })\n      );\n    },\n    [items, onChange, mode]\n  );\n\n  const { journalTotals, productTotal } = useMemo(() => {\n    if (mode === \"journal\") {\n      const debit = items.reduce((sum, i) => sum + (Number(i.debit) || 0), 0);\n      const credit = items.reduce((sum, i) => sum + (Number(i.credit) || 0), 0);\n      return { journalTotals: { debit, credit, balanced: Math.abs(debit - credit) < 0.001 }, productTotal: undefined };\n    }\n    const total = items.reduce((sum, i) => sum + (Number(i.debit) || 0), 0);\n    return { journalTotals: undefined, productTotal: total };\n  }, [items, mode]);\n\n  const fmt = (n: number) =>\n    `${currency} ${n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n\n  return (\n    <div className=\"space-y-3\">\n      <div className=\"rounded-lg border border-border/40 overflow-hidden\">\n        <table className=\"w-full text-sm\">\n          <thead className=\"bg-muted/40 text-xs uppercase text-muted-foreground\">\n            <tr>\n              {mode === \"journal\" ? (\n                <>\n                  <th className=\"px-3 py-2 text-left font-medium\">Account</th>\n                  <th className=\"px-3 py-2 text-left font-medium w-32\">Debit</th>\n                  <th className=\"px-3 py-2 text-left font-medium w-32\">Credit</th>\n                  <th className=\"px-3 py-2 text-left font-medium\">Memo</th>\n                </>\n              ) : (\n                <>\n                  <th className=\"px-3 py-2 text-left font-medium\">Product</th>\n                  <th className=\"px-3 py-2 text-left font-medium\">Description</th>\n                  <th className=\"px-3 py-2 text-left font-medium w-24\">Qty</th>\n                  <th className=\"px-3 py-2 text-left font-medium w-32\">Unit Price</th>\n                  <th className=\"px-3 py-2 text-left font-medium w-32\">Amount</th>\n                </>\n              )}\n              <th className=\"px-3 py-2 text-right font-medium w-10\"></th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-border/40\">\n            {items.map((item, idx) => (\n              <tr key={item.id} className=\"group hover:bg-muted/20\">\n                {mode === \"journal\" ? (\n                  <>\n                    <td className=\"px-3 py-2\">\n                      <select\n                        value={item.accountId ?? \"\"}\n                        onChange={(e) => {\n                          const account = accounts.find((a) => a.id === e.target.value);\n                          updateRow(item.id, {\n                            accountId: e.target.value,\n                            accountName: account?.name,\n                          });\n                        }}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                      >\n                        <option value=\"\">Select account</option>\n                        {accounts.map((account) => (\n                          <option key={account.id} value={account.id}>\n                            {account.code ? `${account.code} — ` : \"\"}\n                            {account.name}\n                          </option>\n                        ))}\n                      </select>\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"number\"\n                        min={0}\n                        step={0.01}\n                        value={item.debit ?? \"\"}\n                        onChange={(e) => updateRow(item.id, { debit: parseFloat(e.target.value) || 0 })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                        placeholder=\"0.00\"\n                      />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"number\"\n                        min={0}\n                        step={0.01}\n                        value={item.credit ?? \"\"}\n                        onChange={(e) => updateRow(item.id, { credit: parseFloat(e.target.value) || 0 })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                        placeholder=\"0.00\"\n                      />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"text\"\n                        value={item.memo ?? \"\"}\n                        onChange={(e) => updateRow(item.id, { memo: e.target.value })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                        placeholder=\"Memo\"\n                      />\n                    </td>\n                  </>\n                ) : (\n                  <>\n                    <td className=\"px-3 py-2\">\n                      <select\n                        value={item.productId ?? \"\"}\n                        onChange={(e) => {\n                          const product = products.find((p) => p.id === e.target.value);\n                          updateRow(item.id, {\n                            productId: e.target.value,\n                            productName: product?.name,\n                            description: product?.name ?? item.description,\n                          });\n                        }}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                      >\n                        <option value=\"\">Select product</option>\n                        {products.map((product) => (\n                          <option key={product.id} value={product.id}>\n                            {product.sku ? `${product.sku} — ` : \"\"}\n                            {product.name}\n                            {product.stock != null ? ` (${product.stock})` : \"\"}\n                          </option>\n                        ))}\n                      </select>\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"text\"\n                        value={item.description}\n                        onChange={(e) => updateRow(item.id, { description: e.target.value })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                        placeholder=\"Description\"\n                      />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"number\"\n                        min={0}\n                        step={1}\n                        value={item.quantity ?? \"\"}\n                        onChange={(e) => updateRow(item.id, { quantity: parseFloat(e.target.value) || 0 })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                      />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <input\n                        type=\"number\"\n                        min={0}\n                        step={0.01}\n                        value={item.unitPrice ?? \"\"}\n                        onChange={(e) => updateRow(item.id, { unitPrice: parseFloat(e.target.value) || 0 })}\n                        disabled={disabled}\n                        className=\"w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20\"\n                        placeholder=\"0.00\"\n                      />\n                    </td>\n                    <td className=\"px-3 py-2\">\n                      <span className=\"text-sm font-medium tabular-nums\">\n                        {fmt(Number(item.debit) || 0)}\n                      </span>\n                    </td>\n                  </>\n                )}\n                <td className=\"px-3 py-2 text-right\">\n                  <button\n                    type=\"button\"\n                    onClick={() => removeRow(item.id)}\n                    disabled={disabled || items.length <= 1}\n                    className=\"inline-flex items-center justify-center rounded-md p-1.5 text-muted-foreground hover:bg-destructive/10 hover:text-destructive disabled:opacity-30\"\n                    aria-label=\"Remove row\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n        {items.length === 0 && (\n          <div className=\"px-3 py-6 text-center text-sm text-muted-foreground\">\n            No line items. Add one to get started.\n          </div>\n        )}\n      </div>\n\n      <div className=\"flex items-center justify-between\">\n        <Button type=\"button\" variant=\"outline\" size=\"sm\" onClick={addRow} disabled={disabled}>\n          <Plus className=\"w-4 h-4 mr-1.5\" />\n          Add line\n        </Button>\n\n        {mode === \"journal\" && journalTotals ? (\n          <div className=\"flex items-center gap-4 text-sm\">\n            <span className=\"tabular-nums\">\n              Debit: <strong>{fmt(journalTotals.debit)}</strong>\n            </span>\n            <span className=\"tabular-nums\">\n              Credit: <strong>{fmt(journalTotals.credit)}</strong>\n            </span>\n            {!journalTotals.balanced && (\n              <span className=\"inline-flex items-center gap-1 text-xs text-amber-600 bg-amber-500/10 px-2 py-1 rounded-md\">\n                <AlertCircle className=\"w-3.5 h-3.5\" />\n                Out of balance: {fmt(Math.abs(journalTotals.debit - journalTotals.credit))}\n              </span>\n            )}\n            {journalTotals.balanced && items.length > 0 && (\n              <span className=\"text-xs text-emerald-600 bg-emerald-500/10 px-2 py-1 rounded-md\">Balanced</span>\n            )}\n          </div>\n        ) : (\n          <div className=\"text-sm tabular-nums\">\n            Total: <strong>{fmt(productTotal ?? 0)}</strong>\n          </div>\n        )}\n      </div>\n\n      {Object.keys(errors).length > 0 && (\n        <div className=\"rounded-md border border-destructive/20 bg-destructive/5 p-3 text-sm text-destructive\">\n          <ul className=\"space-y-1\">\n            {Object.entries(errors).map(([key, msg]) => (\n              <li key={key} className=\"flex items-center gap-1.5\">\n                <AlertCircle className=\"w-3.5 h-3.5\" />\n                {msg}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\finance\\smart-entity-search.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\functional\\key-contextual-suggestions.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Downloads\\KEYFLOWOS\\apps\\web\\src\\components\\functional\\keyboard-shortcuts-help.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\sachd\\Do