{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node dist/main.js",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:ci": "pnpm test:unit && pnpm test:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@keyflow/api": "workspace:*",
    "@keyflow/db": "workspace:*",
    "@keyflow/shared": "workspace:*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.1.27",
    "@paypal/paypal-server-sdk": "^2.2.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.86.0",
    "@trpc/server": "^10.45.2",
    "@types/sanitize-html": "^2.16.1",
    "@vercel/node": "^5.3.24",
    "axios": "^1.13.5",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "csv-parse": "^5.4.0",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.96.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "reflect-metadata": "^0.2.2",
