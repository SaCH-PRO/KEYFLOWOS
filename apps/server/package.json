{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node dist/main.js",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:ci": "vitest run",
    "proof:k12": "node -e \"require('fs').mkdirSync('.proof',{recursive:true})\" && vitest run src/core/config/proof-admission.spec.ts src/core/config/proof-resource-admission.spec.ts --reporter=json --outputFile=.proof/k12-vitest.json && node ../../scripts/proof-admission/evaluate.mjs --manifest ../../scripts/proof-admission/manifests/k12-self.json --report .proof/k12-vitest.json",
    "proof:manifests": "node ../../scripts/proof-admission/run-manifests.mjs",
    "proof:release0": "node ../../scripts/proof-admission/release0.mjs",
    "backfill:google-identities": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=../../.env scripts/backfill-google-identities.ts",
    "cleanup:custom-field-values": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=../../.env scripts/cleanup-cross-tenant-custom-field-values.ts",
    "backfill:timeline-contacts": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=../../.env scripts/backfill-timeline-contact-links.ts",
    "backfill:owner-memberships": "tsx --tsconfig scripts/tsconfig.json --env-file-if-exists=../../.env scripts/backfill-owner-memberships.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@e2b/code-interpreter": "^2.9.1",
    "@growthbook/growthbook": "^1.6.5",
    "@keyflow/api": "workspace:*",
    "@keyflow/db": "workspace:*",
    "@keyflow/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.1.27",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.119.0",
    "@trpc/server": "^10.45.2",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/node": "^5.3.24",
    "axios": "^1.21.1",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "csv-parse": "^5.4.0",
    "date-fns": "^4.4.0",
    "docx": "^9.15.3",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "livekit-server-sdk": "^2.19.3",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.96.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "stripe": "^18.0.0",
    "tsx": "^4.23.15",
    "twilio": "^6.3.0",
    "undici": "^6.25.0",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "^2.0.8",
    "@nestjs/testing": "^11.1.19",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.17.7",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^2.1.1"
  }
}
