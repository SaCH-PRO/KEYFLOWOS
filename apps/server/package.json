  "devDependencies": {
    "@golevelup/ts-vitest": "^2.0.8",
    "@nestjs/testing": "^11.1.19",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.17.6",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.16",
