###############################################################################
# KEYFLOWOS environment configuration
#
# Copy this file to `.env` and fill in the values that apply to your setup.
# Almost everything has a sensible default for local Docker dev — only the
# DATABASE, AUTH and OBJECT_STORAGE sections are required to boot the app.
#
# See MIGRATION.md for a step-by-step guide to running KeyflowOS off Replit.
###############################################################################


# -----------------------------------------------------------------------------
# Public URLs (REQUIRED in non-Replit environments)
#
# Precedence used by both apps:
#   APP_URL / API_URL                 (most explicit)
#   PUBLIC_BASE_URL                   (umbrella for both)
#   REPLIT_DEV_DOMAIN                 (auto-set inside a Repl)
#   http://localhost:5000 / :3001     (dev fallback)
#
# OAUTH_REDIRECT_BASE controls where Google/Meta/etc. redirect back to.
# Set it explicitly only if it differs from APP_URL (e.g. behind an edge
# worker). Otherwise leave unset.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5000
API_URL=http://localhost:3001
# PUBLIC_BASE_URL=
# OAUTH_REDIRECT_BASE=

# Frontend-visible mirrors of the URLs above (Next.js needs the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SITE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Comma-separated extra hostnames for Next.js dev-mode CSRF protection.
# NEXT_PUBLIC_DEV_ORIGINS=my-tunnel.ngrok.io,my-team.cloudflareaccess.com

# Comma-separated extra origins to allow through the API CORS layer in prod.
# CORS_ALLOWED_ORIGINS=https://app.keyflowos.com,https://admin.keyflowos.com


# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001


# -----------------------------------------------------------------------------
# Database (REQUIRED)
#
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL bypasses the pooler — required only by Prisma migrate.
# Local Docker Compose default values are below; override with your Supabase
# (or any Postgres) URL in production.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://keyflow:keyflow@db:5432/keyflowos?schema=public
DIRECT_URL=postgresql://keyflow:keyflow@db:5432/keyflowos?schema=public


# -----------------------------------------------------------------------------
# Authentication — Supabase (REQUIRED)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-signing-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional standalone JWT for service tokens (independent of Supabase).
JWT_SECRET=change-me-to-a-long-random-string


# -----------------------------------------------------------------------------
# Object storage — any S3-compatible service (REQUIRED for uploads)
#
# Examples:
#   - AWS S3:           leave S3_ENDPOINT empty, set S3_REGION=us-east-1
#   - Cloudflare R2:    S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   - MinIO (local):    S3_ENDPOINT=http://minio:9000  S3_FORCE_PATH_STYLE=true
#   - Supabase Storage: S3_ENDPOINT=https://<proj>.supabase.co/storage/v1/s3
#   - Wasabi:           S3_ENDPOINT=https://s3.wasabisys.com
#
# PRIVATE_OBJECT_DIR and PUBLIC_OBJECT_SEARCH_PATHS are bucket key prefixes
# (NOT GCS-style /<bucket>/<path>).
# -----------------------------------------------------------------------------
S3_BUCKET=keyflowos-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public/branding,public/avatars


# -----------------------------------------------------------------------------
# AI providers (set whichever you plan to use)
# -----------------------------------------------------------------------------
# OpenAI
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Anthropic Claude
ANTHROPIC_API_KEY=
# xAI (Grok)
XAI_API_KEY=

# AES-256 secret used to encrypt user-supplied (BYOK) provider keys at rest.
BYOK_ENCRYPTION_SECRET=


# -----------------------------------------------------------------------------
# Google OAuth (Gmail, Calendar, Drive, Contacts)
#
# Set the client ID/secret once. Redirect URIs default to OAUTH_REDIRECT_BASE
# (above) — only override per-product if you route them differently.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_STATE_SECRET=change-me-to-a-long-random-string
# Optional explicit overrides (otherwise derived from OAUTH_REDIRECT_BASE):
# GOOGLE_REDIRECT_URI=https://app.example.com/api/crm/google/callback
# GMAIL_REDIRECT_URI=https://app.example.com/api/commerce/gmail/callback
# CALENDAR_REDIRECT_URI=https://api.example.com/bookings/calendar/callback
# DRIVE_REDIRECT_URI=https://app.example.com/api/drive/callback


# -----------------------------------------------------------------------------
# Payment gateways
# -----------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Google Pay (frontend-only display config)
NEXT_PUBLIC_GOOGLE_PAY_ENV=TEST
NEXT_PUBLIC_GOOGLE_PAY_GATEWAY=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=

# WiPay (Caribbean)
WIPAY_API_KEY=
WIPAY_ACCOUNT_NUMBER=


# -----------------------------------------------------------------------------
# Communications
# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# HMAC secret for tracking pixel/link signing.
TRACKING_HMAC_SECRET=change-me-to-a-long-random-string

# AES key for encrypting per-tenant connector credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-string


# -----------------------------------------------------------------------------
# Optional: Nango (used for some connector OAuth flows)
# -----------------------------------------------------------------------------
NANGO_SECRET_KEY=
NANGO_HOST_URL=https://api.nango.dev


# -----------------------------------------------------------------------------
# Demo / development conveniences
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_BUSINESS_ID=
# NEXT_PUBLIC_AI_SUGGEST_URL=
