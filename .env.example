###############################################################################
# KEYFLOWOS environment configuration
#
# Copy this file to `.env` and fill in the values that apply to your setup.
# Almost everything has a sensible default for local Docker dev — only the
# Database, Auth and Object Storage sections are required to boot the app.
#
# See DEPLOYMENT.md for platform-specific deploy guides.
###############################################################################


# -----------------------------------------------------------------------------
# Public URLs
#
# Precedence used by both apps:
#   APP_URL / API_URL                 (most explicit)
#   PUBLIC_BASE_URL                   (umbrella for both)
#   http://localhost:5000 / :3001     (dev fallback)
#
# OAUTH_REDIRECT_BASE controls where Google/Meta/etc. redirect back to.
# Set it explicitly only if it differs from APP_URL (e.g. behind an edge
# worker). Otherwise leave unset.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5000
API_URL=http://localhost:3001
# PUBLIC_BASE_URL=
# OAUTH_REDIRECT_BASE=

# Frontend-visible mirrors of the URLs above (Next.js needs NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Comma-separated extra hostnames for Next.js dev-mode CSRF protection.
# Useful for ngrok, Cloudflare tunnels, or custom dev domains.
NEXT_PUBLIC_DEV_ORIGINS=

# Comma-separated extra origins to allow through the API CORS layer in prod.
# CORS_ALLOWED_ORIGINS=https://app.keyflowos.com,https://admin.keyflowos.com

# Optional explicit override for the public site URL used in verification links.
# SITE_URL=https://app.keyflow.os


# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001


# -----------------------------------------------------------------------------
# Database (REQUIRED)
#
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL bypasses the pooler — required only by Prisma migrate.
# Local Docker Compose default values are below; override with your Supabase
# (or any Postgres) URL in production.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://keyflow:keyflow@db:5432/keyflowos?schema=public
DIRECT_URL=postgresql://keyflow:keyflow@db:5432/keyflowos?schema=public


# -----------------------------------------------------------------------------
# Redis (required for BullMQ job queues)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# Authentication — Supabase (REQUIRED)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-signing-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key (REQUIRED when AUTH_REQUIRE_EMAIL_VERIFICATION=true).
# Used server-side ONLY for admin operations like createUser and
# generateLink. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional standalone JWT for service tokens (independent of Supabase).
JWT_SECRET=change-me-to-a-long-random-string


# -----------------------------------------------------------------------------
# Signup / verification flow
#
# When AUTH_REQUIRE_EMAIL_VERIFICATION=true the server creates new accounts
# unconfirmed and emails a verification link via Resend. When false (the
# default for non-production), accounts are auto-confirmed and the user is
# signed in immediately. If unset, defaults to `true` in production.
#
# When verification is required, the server fails fast at boot if any of
# SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY or EMAIL_FROM_ADDRESS are missing.
# -----------------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@keyflow.os
EMAIL_FROM_NAME=Keyflow


# -----------------------------------------------------------------------------
# Object storage — any S3-compatible service (REQUIRED for uploads)
#
# Examples:
#   - AWS S3:           leave S3_ENDPOINT empty, set S3_REGION=us-east-1
#   - Cloudflare R2:    S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   - MinIO (local):    S3_ENDPOINT=http://minio:9000  S3_FORCE_PATH_STYLE=true
#   - Supabase Storage: S3_ENDPOINT=https://<proj>.supabase.co/storage/v1/s3
#   - Wasabi:           S3_ENDPOINT=https://s3.wasabisys.com
#
# PRIVATE_OBJECT_DIR and PUBLIC_OBJECT_SEARCH_PATHS are bucket key prefixes
# (NOT GCS-style /<bucket>/<path>).
# -----------------------------------------------------------------------------
S3_BUCKET=keyflowos-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public/branding,public/avatars


# -----------------------------------------------------------------------------
# MCP remote servers (optional) — JSON array of allowlisted remote MCP
# servers whose tools KEY can call (bridged as mcp__<key>__<tool>).
# Remote HTTP(S) only; static allowlist; per-server bearer via env var.
# Example: [{"key":"shopify","name":"Shopify MCP","url":"https://mcp.example.com/mcp","tokenEnvVar":"SHOPIFY_MCP_TOKEN","readOnlyPrefixes":["get","list","search"]}]
MCP_REMOTE_SERVERS=

# AI providers (set whichever you plan to use)
# -----------------------------------------------------------------------------
# OpenAI (used by model gateway, embeddings and AI usage tracking)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# AES-256 secret used to encrypt user-supplied (BYOK) provider keys at rest.
BYOK_ENCRYPTION_SECRET=


# -----------------------------------------------------------------------------
# Google OAuth (Gmail, Calendar, Drive, Contacts)
#
# Set the client ID/secret once. Redirect URIs default to OAUTH_REDIRECT_BASE
# (above) — only override per-product if you route them differently.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_STATE_SECRET=change-me-to-a-long-random-string

# Optional explicit overrides (otherwise derived from OAUTH_REDIRECT_BASE):
# GOOGLE_REDIRECT_URI=https://app.example.com/api/crm/google/callback
# GMAIL_REDIRECT_URI=https://app.example.com/api/commerce/gmail/callback
# CALENDAR_REDIRECT_URI=https://api.example.com/bookings/calendar/callback
# DRIVE_REDIRECT_URI=https://app.example.com/api/drive/callback

# Number of days to backfill on the first Gmail -> KEYInbox sync (default: 30)
# GMAIL_INGESTION_BACKFILL_DAYS=30


# -----------------------------------------------------------------------------
# Cross-Account Protection (RISC) for Google Sign-In
#
# GOOGLE_CLIENT_ID is the web client ID used by the Sign In With Google button.
# GOOGLE_CLIENT_IDS is a comma-separated allowlist of all client IDs that may
# appear as the `aud` claim in a RISC security event token.
#
# RISC_SERVICE_ACCOUNT_JSON is the JSON content of the service account key
# downloaded from GCP (the one with the RISC Configuration Admin role). It can
# also be a filesystem path to the JSON file if you prefer not to inline it.
# RISC_RECEIVER_URL is the public HTTPS URL Google will POST events to.
# RISC_EVENT_RETENTION_DAYS controls how long received RISC events are kept
# (default: 90). They contain a Google Account identifier, which is personal
# data, so they are purged automatically by a nightly job.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com
# RISC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# RISC_RECEIVER_URL=https://api.example.com/webhooks/risc
# RISC_EVENT_RETENTION_DAYS=90


# -----------------------------------------------------------------------------
# Payment gateways
# -----------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Google Pay (frontend-only display config)
NEXT_PUBLIC_GOOGLE_PAY_ENV=TEST
NEXT_PUBLIC_GOOGLE_PAY_GATEWAY=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=

# WiPay (Caribbean)
WIPAY_API_KEY=
WIPAY_ACCOUNT_NUMBER=


# -----------------------------------------------------------------------------
# Communications
# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Twilio (WhatsApp / SMS / inbound voice)
#
# TWILIO_AUTH_TOKEN is what verifies that an inbound voice webhook really came
# from Twilio. Without it, POST /api/v1/cortex/phone/inbound REFUSES — it used
# to accept the call unverified, which meant anyone could hand it a businessId
# and get back that business's voice-bridge WebSocket URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Accept inbound voice webhooks WITHOUT a Twilio signature. Local development
# only, against a tunnel where Twilio signs a URL the server cannot reconstruct.
# Must be exactly "1"; every use is logged. Never set this in production.
PHONE_VOICE_ALLOW_UNVERIFIED=

# HMAC secret for tracking pixel/link signing.
TRACKING_HMAC_SECRET=change-me-to-a-long-random-string

# AES key for encrypting per-tenant connector credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-string


# -----------------------------------------------------------------------------
# Admin local auth (separate from Supabase)
# Allows super-admin login without Supabase auth.
# -----------------------------------------------------------------------------
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@keyflow.os


# -----------------------------------------------------------------------------
# Push notifications (web-push)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keyflow.os


# -----------------------------------------------------------------------------
# Sentry (error tracking & performance monitoring)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
NEXT_PUBLIC_SENTRY_ENVIRONMENT=${SENTRY_ENVIRONMENT}
NEXT_PUBLIC_SENTRY_RELEASE=${SENTRY_RELEASE}
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=${SENTRY_TRACES_SAMPLE_RATE}

# -----------------------------------------------------------------------------
# Langfuse (LLM observability — tracing, cost & eval for KEY)
# Leave the keys blank to disable; the gateway routes and costs calls as normal.
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Per-request ingestion timeout in ms (default 5000) — bounds each fire-and-forget trace.
LANGFUSE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# GrowthBook (feature flags & experimentation)
# Leave the client key blank to disable; every flag then resolves to the
# code-supplied fallback. Use the SDK client key (not a personal API key).
# -----------------------------------------------------------------------------
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# -----------------------------------------------------------------------------
# Apollo (CRM contact enrichment)
# Leave the key blank to disable; the enrich endpoint then returns
# "not_configured" without touching contacts. Enrichment only fills blank fields.
# -----------------------------------------------------------------------------
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_TIMEOUT_MS=8000


# -----------------------------------------------------------------------------
# Turborepo remote cache (optional — local cache works without these)
#
# Set TURBO_TOKEN + TURBO_TEAM to enable Vercel Remote Cache across machines/CI.
# If you use signed artifacts, also set TURBO_REMOTE_CACHE_SIGNATURE_KEY and
# add "remoteCache": { "signature": true } to turbo.json.
# -----------------------------------------------------------------------------
# TURBO_TOKEN=
# TURBO_TEAM=
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=


# -----------------------------------------------------------------------------
# Demo / development conveniences
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_BUSINESS_ID=
# NEXT_PUBLIC_AI_SUGGEST_URL=

# DANGER: Setting KEYFLOW_DEV_AUTH_BYPASS=true disables all authentication.
# The server will refuse to boot if this is set. Use only for isolated
# debugging, never in production or shared environments.
# KEYFLOW_DEV_AUTH_BYPASS=false

# Skip boot-time env validation (e.g. for one-off scripts).
# KEYFLOW_SKIP_ENV_VALIDATION=false

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LiveKit (in-app KEY voice). Dev defaults match docker-compose livekit service;
# production should use LiveKit Cloud or a secured self-hosted server.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Chatwoot L1 support desk (optional). Run scripts/chatwoot-setup.sh after first boot.
CHATWOOT_URL=http://localhost:3100
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_BUSINESS_ID=
CHATWOOT_WEBHOOK_SECRET=

# Code executor backend. Default: local child-process sandbox. Set E2B_API_KEY
# (e2b.dev) + PUBLIC_API_URL (public URL of this API, for the tool bridge) to
# run custom logic in E2B cloud microVMs instead. Force with CODE_EXECUTOR_BACKEND=local|e2b.
E2B_API_KEY=
PUBLIC_API_URL=
# CODE_EXECUTOR_BACKEND=

# Raise the global per-IP API rate limit for local dev (default 200/min is
# too low for the app's parallel page-load fan-out; 429s hang pages).
RATE_LIMIT_MAX_REQUESTS=2000

# Meta / WhatsApp Business (see docs/CONNECTORS_SETUP.md)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_SOCIAL_VERIFY_TOKEN=
GOOGLE_REDIRECT_URI=

