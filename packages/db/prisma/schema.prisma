// ---
// MODULE 8: BUSINESS AUTOPILOT
// ---
model AutopilotTask {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  
  title       String
  description String?
  category    String   // SETUP, LEGAL, MARKETING, SALES, OPERATIONS, FINANCE
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, AWAITING_APPROVAL, COMPLETED, SKIPPED, AUTO_EXECUTED
  
  // Autopilot execution
  autoExecutable Boolean  @default(false) @map("auto_executable")
  executedAt     DateTime? @map("executed_at")
  executedBy     String?   @map("executed_by") // USER, SYSTEM, AI
  
  // Approval flow
  requiresApproval Boolean  @default(false) @map("requires_approval")
  approvalData     Json?    @map("approval_data") // What the user needs to approve
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  
  // Scheduling
  scheduledFor DateTime? @map("scheduled_for")
  dueDate      DateTime? @map("due_date")
  
  // Linking to related entities
  relatedType  String?  @map("related_type") // CONTACT, INVOICE, BOOKING, etc.
  relatedId    String?  @map("related_id")
  
  // AI-generated context
  aiContext    Json?    @map("ai_context")
  
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  
  @@index([businessId, status])
  @@index([businessId, scheduledFor])
  @@map("autopilot_tasks")
}

model DelegationLoop {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")

  loopType    String   @map("loop_type")
  name        String
  description String?
  enabled     Boolean  @default(false)
  riskTier    Int      @default(2) @map("risk_tier")

  config      Json?    @default("{}")
  stats       Json?    @default("{}")

  lastRunAt   DateTime? @map("last_run_at")
  nextRunAt   DateTime? @map("next_run_at")
  intervalMin Int       @default(360) @map("interval_min")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs        DelegationLoopRun[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, loopType])
  @@index([businessId, enabled])
  @@map("delegation_loops")
}

model DelegationLoopRun {
  id             String   @id @default(cuid())
  loopId         String   @map("loop_id")
  businessId     String   @map("business_id")

  status         String   @default("running")
  startedAt      DateTime @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  itemsScanned   Int      @default(0) @map("items_scanned")
  itemsMatched   Int      @default(0) @map("items_matched")
  actionsCreated Int      @default(0) @map("actions_created")
  actionsBlocked Int      @default(0) @map("actions_blocked")

  results        Json?    @default("[]")
  error          String?

  loop           DelegationLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([loopId, startedAt])
  @@index([businessId, startedAt])
  @@map("delegation_loop_runs")
}

