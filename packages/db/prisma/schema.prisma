  status            String   @default("OPEN")
  priority          Int      @default(50)
  urgency           Int      @default(50)
  impactScore       Int      @default(0) @map("impact_score")
  expectedValue     Decimal? @db.Decimal(18, 4) @map("expected_value")
  currency          String?
  /// 1 low, 2 medium, 3 high, 4 critical
  riskTier          Int      @default(1)
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  executableByKey   Boolean  @default(false) @map("executable_by_key")
  executionTool     String?  @map("execution_tool")
  executionPayload  Json?    @map("execution_payload")
  /// SYSTEM | KEY | USER | WORKFLOW
  recommendedBy     String?  @map("recommended_by")
  /// USER | ROLE | KEY
  ownerType         String?  @map("owner_type")
  ownerId           String?  @map("owner_id")
  contactId         String?  @map("contact_id")
  entityType        String?  @map("entity_type")
  entityId          String?  @map("entity_id")
  dueAt             DateTime? @map("due_at")
  snoozedUntil      DateTime? @map("snoozed_until")
  completedAt       DateTime? @map("completed_at")
  dismissedAt       DateTime? @map("dismissed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([businessId, sourceModule, sourceType, sourceId, actionType])
  @@index([businessId, status, priority])
  @@index([businessId, category, status])
  @@index([businessId, sourceModule, sourceId])
  @@map("command_items")
}

/// FIN8 — Finance intelligence detector output. One row per active
/// detection. Mirrors into RevenueAction (FIN_*) so the same item also
/// surfaces in KEYFLOW Today via the existing R3 action queue.
model FinanceActionItem {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// CASHFLOW_RISK | SLOW_PAYER | MARGIN_DECLINE | OVERSPENDING |
  /// MISSING_RECEIPT | UNCATEGORISED | TAX_RESERVE_GAP | DUPLICATE_EXPENSE
  kind         String
  /// INFO | WARNING | CRITICAL
  severity     String   @default("WARNING")
  title        String
  body         String

  /// Polymorphic backref to the source object the detection is about.
  /// Defaults to '' (not null) so the (businessId, kind, entityType,
  /// entityId) unique key works without Postgres NULL semantics tripping
  /// idempotent re-detection.
  entityType   String   @default("") @map("entity_type")
  entityId     String   @default("") @map("entity_id")

  /// Recommended next action — usually a deep link e.g.
  /// "/app/expenses/<id>" or "/app/finance/reconciliation". Used by the
  /// Overview one-click resolvers.
  recommendedAction String? @map("recommended_action")

  /// Structured datapoints used to compute the detection — exposed by
  /// the API so every action is explainable. Schema varies per kind.
  evidence     Json?
  amount       Float?

  /// OPEN | RESOLVED | DISMISSED | SUPERSEDED
  status       String   @default("OPEN")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedBy   String?   @map("resolved_by")
  resolution   String?

  /// Mirror handle into RevenueAction (R3). Set when a FIN_* twin row is
  /// created so that resolving on either side can be reflected.
  mirroredActionId String? @map("mirrored_action_id")

  detectedAt   DateTime @default(now()) @map("detected_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([businessId, kind, entityType, entityId])
  @@index([businessId, status, severity])
  @@index([businessId, kind, status])
  @@map("finance_action_items")
}

