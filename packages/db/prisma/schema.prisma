// ---
// MODULE 9: EXPENSE TRACKING (ProfitLens)
// ---
model ExpenseCategory {
  id         String   @id @default(cuid())
  name       String
  icon       String?
  color      String?
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  budgets    ExpenseBudget[]
  recurringExpenses RecurringExpense[]
  bankRules  BankRule[]

  // FIN1: link expense categories to a Chart of Account row so reports can
  // group spend by COA bucket. Nullable until FIN3 backfills the mapping.
  chartOfAccountId String?         @map("chart_of_account_id")
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, chartOfAccountId])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  // FIN7 — Tax paid on this purchase (input VAT). Used by
  // TaxLiabilityService to compute tax recoverable for the period.
  taxAmount   Float?   @default(0) @map("tax_amount")
  // FIN7 — Canonical TaxRate FK. `taxAmount` (numeric) is retained as
  // the legacy fallback for older rows that pre-date the picker.
  taxRateId   String?  @map("tax_rate_id")
  taxRateRef  TaxRate? @relation("ExpenseTaxRate", fields: [taxRateId], references: [id], onDelete: SetNull)
  currency    String   @default("TTD")
  date        DateTime @default(now())
  vendor      String?
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  paymentMethod String? @map("payment_method")
  tags        String[] @default([])
  isRecurring Boolean  @default(false) @map("is_recurring")
  recurringFrequency String? @map("recurring_frequency")

  // FIN3 — Bill (unpaid expense) support. Defaults to PAID so existing
  // rows behave unchanged. Lifecycle: BILL -> PAID (via mark-paid) or
  // BILL/PAID -> VOID (replaced by a reversal posting).
  status      String    @default("PAID") // PAID, BILL, VOID
  dueDate     DateTime? @map("due_date")
  paidAt      DateTime? @map("paid_at")

  /// Multi-line split items: [{ amount, categoryId, description?, taxRateId? }].
  /// When absent, the expense posts as a single-line against categoryId.
  items       Json?     @map("items")

  categoryId String?          @map("category_id")
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  projectId  String?  @map("project_id")
  contactId  String?  @map("contact_id")
  serviceId  String?  @map("service_id")

  recurringExpenseId String?           @map("recurring_expense_id")
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId, date])
  @@index([businessId, categoryId])
  @@index([businessId, vendor])
  @@index([businessId, projectId])
  @@index([businessId, contactId])
  @@index([businessId, serviceId])
  @@index([businessId, status, dueDate])
  @@index([businessId, recurringExpenseId])
  @@map("expenses")
}

model RecurringExpense {
  id          String   @id @default(cuid())
  name        String
  frequency   String   // WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextRunDate DateTime @map("next_run_date")
  lastRunDate DateTime? @map("last_run_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  runCount    Int      @default(0) @map("run_count")
  failureCount   Int       @default(0) @map("failure_count")
  lastFailureAt  DateTime? @map("last_failure_at")
  lastError      String?   @map("last_error")
  cancelledAt    DateTime? @map("cancelled_at")

  // Snapshot used by the generator each cycle.
  description   String
  amount        Float
  currency      String   @default("TTD")
  vendor        String?
  paymentMethod String?  @map("payment_method")
  notes         String?
  // When true the generator emits the Expense as status=BILL (Dr Op Exp /
  // Cr AP) so the user can mark-paid later. When false it posts as paid.
  createsBill   Boolean  @default(false) @map("creates_bill")
  // Default offset for dueDate when createsBill — days from issue date.
  dueOffsetDays Int?     @map("due_offset_days")

  categoryId String?          @map("category_id")
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  projectId  String?  @map("project_id")
  contactId  String?  @map("contact_id")
  serviceId  String?  @map("service_id")

  generatedExpenses Expense[]

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId, isActive])
  @@index([businessId, nextRunDate])
  @@map("recurring_expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Continental Operations — Delivery Notes, Goods Receipts, Stock Counts, Receipts
// ─────────────────────────────────────────────────────────────────────────────

/// Delivery Note authorizes release of goods from inventory. Cross-referenced
/// with Invoice. Signed by deliverer and receiver. Status: DRAFT → ISSUED → DELIVERED.
model DeliveryNote {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dnNumber          String   @map("dn_number")
  invoiceId         String   @map("invoice_id")
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  status            String   @default("DRAFT") // DRAFT | ISSUED | DELIVERED | CANCELLED
  deliveredAt       DateTime? @map("delivered_at")
  delivererName     String?  @map("deliverer_name")
  delivererSignature String? @map("deliverer_signature")
  receiverName      String? @map("receiver_name")
  receiverSignature String?  @map("receiver_signature")
  notes             String?
  items             Json     // [{ productId, description, quantity, unitPrice }]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, dnNumber])
  @@index([businessId])
  @@index([businessId, invoiceId])
  @@index([businessId, status])
  @@map("delivery_notes")
}

/// Goods Receipt records physical receipt of inventory against a PO or transfer.
/// Qty received is checked against qty ordered. Discrepancies logged.
model GoodsReceipt {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  grNumber          String   @map("gr_number")
  purchaseOrderId   String?  @map("purchase_order_id")
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  supplierName      String?  @map("supplier_name")
  receivedAt        DateTime @default(now()) @map("received_at")
  receivedBy        String?  @map("received_by")
  status            String   @default("PENDING") // PENDING | CHECKED | POSTED | DISCREPANCY
  notes             String?
  items             Json     // [{ productId, description, qtyOrdered, qtyReceived, qtyAccepted, qtyRejected, reason }]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, grNumber])
  @@index([businessId])
  @@index([businessId, purchaseOrderId])
  @@index([businessId, status])
  @@map("goods_receipts")
}

/// Physical stock count with discrepancy audit.
model StockCount {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  countNumber       String   @map("count_number")
  countDate         DateTime @default(now()) @map("count_date")
  countedBy         String?  @map("counted_by")
  status            String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ADJUSTED
  notes             String?
  items             Json     // [{ productId, description, systemQty, countedQty, variance, varianceValue }]

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, countNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@map("stock_counts")
}

/// Formal payment receipt document. Linked to invoice and customer.
model Receipt {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  receiptNumber     String   @map("receipt_number")
  invoiceId         String   @map("invoice_id")
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount            Decimal  @db.Decimal(18, 4)
  currency          String   @default("TTD")
  paymentMethod     String   @map("payment_method") // cash | bank_transfer | card | cheque | other
  receivedFrom      String?  @map("received_from")
  receivedBy        String?  @map("received_by")
  receivedAt        DateTime @default(now()) @map("received_at")
  notes             String?

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@index([businessId, invoiceId])
  @@map("receipts")
}

model ExpenseBudget {
  id          String   @id @default(cuid())
  amount      Float
  month       Int
  year        Int
  alertAt     Float    @default(80) @map("alert_at")
  rollover    Boolean  @default(false)

  categoryId  String?          @map("category_id")
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, categoryId, month, year])
  @@index([businessId, month, year])
  @@map("expense_budgets")
}

// ---
// MODULE 10: RECURRING INVOICES
// ---
model RecurringInvoice {
  id              String   @id @default(cuid())
  name            String
  description     String?
  frequency       String   // WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, ANNUALLY, CUSTOM
