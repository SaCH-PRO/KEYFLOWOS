model ConversationAIInsight {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")

  // 'thread_summary' | 'message_analysis'
  kind       String

  // For message_analysis: source message id like 'wa:<id>' or 'event:<id>'.
  // For thread_summary: null.
  messageRef String?  @map("message_ref")

  // SHA256 of the inputs used to compute this insight; allows skipping
  // recomputation when the underlying thread hasn't changed.
  hash       String

  // Normalized signals surfaced in UI.
  sentiment  String?  // 'positive' | 'neutral' | 'negative' | 'mixed'
  intent     String?  // free-form short label e.g. 'pricing_question', 'booking_request'
  summary    String?  // short one-liner

  // Full structured payload returned by the model (suggestions, reasons, scores, etc.)
  payload    Json?

  modelUsed  String?  @map("model_used")
  feature    String?

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

