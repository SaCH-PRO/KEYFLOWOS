}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, ARCHIVED
  priority    String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  color       String?

  // Time tracking
  hourlyRate Float? @map("hourly_rate")

  // Scheduling & Budgeting (Phase 2/5)
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  budgetAmount Float?    @map("budget_amount")
  budgetHours  Float?    @map("budget_hours")

  businessId   String             @map("business_id")
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]
  milestones   ProjectMilestone[]
  changeOrders ChangeOrder[]

  // Goal linkage: projects serve strategic business goals
  goalId       String?       @map("goal_id")
  goal         BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectPlans ProjectPlan[]

  contactId String?   @map("contact_id")
  invoiceId String?   @map("invoice_id")
  bookingId String?   @map("booking_id")
  dueDate   DateTime? @map("due_date")

  timeEntries TimeEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@index([businessId, status])
  @@index([goalId])
  @@map("projects")
}

model ProjectTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean   @default(false) @map("is_completed")
  dueDate     DateTime? @map("due_date")
  priority    String    @default("NORMAL")
  sortOrder   Int       @default(0) @map("sort_order")
  assigneeId  String?   @map("assignee_id")

  // Kanban / Gantt (Phase 2)
  status    ProjectTaskStatus @default(TODO) // TODO, IN_PROGRESS, REVIEW, DONE, BLOCKED
  position  Int               @default(0) // for DnD ordering within a column
  startDate DateTime?         @map("start_date")
  endDate   DateTime?         @map("end_date")

  // Time tracking
  estimatedHours Float? @map("estimated_hours")
  trackedHours   Float  @default(0) @map("tracked_hours")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Phase 0: evidence requirement for task completion
  evidenceRequired Boolean @default(false) @map("evidence_required")

  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([businessId])
  @@index([projectId, status])
  @@index([projectId, position])
  @@map("project_tasks")
}

model TimeEntry {
  id              String    @id @default(cuid())
  description     String?
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  durationMinutes Int?      @map("duration_minutes")

  billable   Boolean @default(true)
  billed     Boolean @default(false)
