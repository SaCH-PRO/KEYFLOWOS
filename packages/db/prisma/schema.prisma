// ---
// MODULE 3: COMMERCE (QUOTES, INVOICES, PAYMENTS)
// ---
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("TTD") // Caribbean localization
  category    String   @default("SERVICE") // SERVICE, PRODUCT, PACKAGE
  duration    Int?     // Duration in minutes (for services)
  imageUrl    String?  @map("image_url")
  sku         String?  // Stock keeping unit
  isActive    Boolean  @default(true) @map("is_active")

  // Execution model tiers (DIY, AI_ASSISTED, HYBRID, FULL_SERVICE)
  executionModel    String?  @map("execution_model")
  executionMeta     Json?    @map("execution_meta")      // { deliverables, whatYouGet, pricingNote } per tier

  // Mission 2: Fulfillment & inventory extensions
  fulfillmentModel  String?  @map("fulfillment_model")   // local_stock, dropship, preorder, manual, hybrid
  inventoryMode     String?  @map("inventory_mode")      // tracked, untracked, virtual
  outOfStockBehavior String? @default("hide") @map("out_of_stock_behavior") // hide, show_oos, allow_backorder
  compareAtPrice    Float?   @map("compare_at_price")

  // Resource Marketplace (Community Phase 5)
  resourceType      String?  @map("resource_type")       // TEMPLATE, PROMPT_LIBRARY, PROCESS_DOC, EDU_CONTENT, CANVA_KIT, OTHER
  downloadUrl       String?  @map("download_url")
  previewUrl        String?  @map("preview_url")
  licenseTerms      String?  @map("license_terms")
  isFree            Boolean  @default(false) @map("is_free")
  fileSize          Int?     @map("file_size")           // bytes

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  quoteItems      QuoteItem[]
  invoiceItems    InvoiceItem[]
  projectTemplate ProjectTemplate? // Link to a project template
  marketplaceListings MarketplaceListing[]
  inventoryStocks InventoryStock[]
  preOrders       PreOrder[]
  orderItems      MarketplaceOrderItem[]
  variants        ProductVariant[]
  sourceLinks     ProductSourceLink[]
  costProfile     ProductCostProfile?
  marginSnapshots MarginSnapshot[]
  resourceDownloads ResourceDownload[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@map("products")
}

model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @map("quote_number")
  status      String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED (VIEWED/EXPIRED/INVOICED/PAID derived)
  subtotal    Float    @default(0)
  taxRate     Float?   @default(0) @map("tax_rate")
  taxAmount   Float?   @default(0) @map("tax_amount")
  discountType  String?  @map("discount_type") // PERCENT or FIXED
  discountValue Float?   @default(0) @map("discount_value")
  discountAmount Float?  @default(0) @map("discount_amount")
  total       Float
  currency    String   @default("TTD")
  notes       String?
  issueDate   DateTime @default(now()) @map("issue_date")
  expiryDate  DateTime? @map("expiry_date")

  // Public-link signed token (R2). Anyone with the URL can view, accept
  // or reject the quote without an authenticated session.
  viewToken  String?  @unique @map("view_token")
  sentAt     DateTime? @map("sent_at")
  viewedAt   DateTime? @map("viewed_at")
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")
  // R3: timestamp of the most recent stale-quote follow-up reminder.
  // When set after `sentAt`, the quote is considered "freshly nudged"
  // and is excluded from the daily stale-quote scan so the same row
  // doesn't keep re-surfacing in the Action Queue.
  lastFollowUpAt DateTime? @map("last_follow_up_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String   @map("contact_id")
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY: Do not delete quote if contact is deleted

  items     QuoteItem[]
  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@unique([businessId, quoteNumber])
  @@index([businessId, contactId])
  @@index([businessId, status, sentAt])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float   @map("unit_price")
  total       Float

  quoteId   String   @map("quote_id")
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade) // Safe to cascade
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction) // DATA INTEGRITY: Keep item history

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @map("invoice_number")
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, VOID, OVERDUE, FAILED
  subtotal      Float    @default(0)
  taxRate       Float?   @default(0) @map("tax_rate")
  taxAmount     Float?   @default(0) @map("tax_amount")
  // FIN7 — Canonical TaxRate FK. Numeric `taxRate` retained as legacy
  // fallback for older rows that pre-date the picker.
  taxRateId     String?  @map("tax_rate_id")
  taxRateRef    TaxRate? @relation("InvoiceTaxRate", fields: [taxRateId], references: [id], onDelete: SetNull)
  discountType  String?  @map("discount_type") // PERCENTAGE or FIXED
  discountValue Float?   @default(0) @map("discount_value")
  discountAmount Float?  @default(0) @map("discount_amount")
  total         Float
  currency      String   @default("TTD")
  notes         String?
  issueDate     DateTime @default(now()) @map("issue_date")
  dueDate       DateTime? @map("due_date")
  paidAt        DateTime? @map("paid_at")
  sentAt        DateTime? @map("sent_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String   @map("contact_id")
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY

  items        InvoiceItem[]
  payments     Payment[]
  paymentLinks PaymentLink[]
  booking      Booking?
  depositForBooking Booking? @relation("BookingDepositInvoice")
  quote    Quote?    @relation(fields: [quoteId], references: [id], onUpdate: NoAction, onDelete: NoAction) // DATA INTEGRITY
  quoteId  String?   @unique @map("quote_id")
  contentRequest ContentRequest?

  campaignId String?       @map("campaign_id")
  campaign   EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  externalAccountingSource String? @map("external_accounting_source") // 'quickbooks' | 'xero'
  externalAccountingId     String? @map("external_accounting_id")
  externalAccountingSyncedAt DateTime? @map("external_accounting_synced_at")

  recurringInvoiceId String?           @map("recurring_invoice_id")
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  receiptSentAt      DateTime?         @map("receipt_sent_at")

  timeEntries TimeEntry[]
  creditNotes CreditNote[]
  deliveryNotes DeliveryNote[]
  receipts    Receipt[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@unique([businessId, invoiceNumber])
  @@index([businessId, contactId])
  @@index([businessId, externalAccountingSource, externalAccountingId])
  @@index([businessId, recurringInvoiceId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float   @map("unit_price")
  total       Float

  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Safe to cascade
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction) // DATA INTEGRITY

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(cuid())
  amount            Float
  currency          String
  status            String   // PENDING, SUCCESSFUL, FAILED
  provider          String   // "wipay", "paypal", "cash", "bank_transfer", "card"
  method            String?  @default("card") // card, cash, bank_transfer, paypal, wipay, check, other
  providerPaymentId String   @unique @map("provider_payment_id")
  reference         String?
  notes             String?
  recordedBy        String?  @map("recorded_by")
  /// FIN2: processor fee retained by Stripe/PayPal/WiPay etc. Posted to
  /// EXPENSE_BANK_FEES on payment recording so cash-deposit math is net.
  processorFee      Float?   @default(0) @map("processor_fee")
  evidenceUrl       String?  @map("evidence_url")
  evidenceMimeType  String?  @map("evidence_mime_type")
  createdAt         DateTime @default(now()) @map("created_at")

  businessId String  @map("business_id")
  invoiceId  String  @map("invoice_id")
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: NoAction)

  @@index([businessId, invoiceId])
  @@map("payments")
}

/// Idempotency / dedup table for inbound payment-provider webhooks. We
/// upsert on (provider, providerEventId) BEFORE running side-effects so a
/// re-delivered event becomes a no-op even if the per-row Payment unique
/// constraint would otherwise allow duplicate processing.
model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   // 'stripe' | 'paypal' | 'wipay'
  providerEventId String   @map("provider_event_id")
  eventType       String?  @map("event_type")
  businessId      String?  @map("business_id")
  receivedAt      DateTime @default(now()) @map("received_at")

  @@unique([provider, providerEventId])
  @@index([businessId, receivedAt])
  @@map("webhook_events")
}

/// Tracks documents generated by the app and uploaded to external storage
/// (e.g. Google Drive). Each row represents one uploaded file with its
/// external reference, entity linkage, and metadata.
model GeneratedDocument {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  entityType  String   @map("entity_type") // 'invoice' | 'quote' | 'expense' | 'payment' | 'journal' | 'report'
  entityId    String   @map("entity_id")
  driveFileId String   @map("drive_file_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  folderPath  String   @map("folder_path") // e.g. 'Revenue/Invoices'
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([businessId, entityType, entityId])
  @@index([businessId, generatedAt])
  @@map("generated_documents")
}

model PaymentLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  businessId String  @map("business_id")
  active    Boolean  @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([businessId])
  @@map("payment_links")
}

// ---
// MODULE 4: BOOKINGS (SCHEDULING & TIME)
// ---
model StaffMember {
  id   String @id @default(cuid())
  name String

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // L4 Manager — capacity tracking
  maxHoursPerWeek Float? @default(40) @map("max_hours_per_week")
  hourlyRate      Float? @map("hourly_rate")
  skills Skill[]

  services       Service[]
  bookings       Booking[]
  availabilities Availability[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@map("staff_members")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int // Duration in minutes
  price       Float // Price for this service
  bufferMins  Int?    @map("buffer_mins")
  leadTimeMins Int?   @map("lead_time_mins")

  sourceProductId String? @map("source_product_id")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  bookings Booking[]
  staff    StaffMember[] // Staff who can perform this service

  // Storefront → Revenue gating (S2). Determines whether a booking
  // immediately produces an invoice (BOOKING) or only on completion
  // (COMPLETION), and whether a deposit invoice is required up-front.
  invoiceTiming    String?  @map("invoice_timing") // BOOKING | COMPLETION
  depositRequired  Boolean  @default(false) @map("deposit_required")
  depositType      String?  @map("deposit_type") // PERCENT | FIXED
  depositValue     Float?   @map("deposit_value")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@index([sourceProductId])
  @@map("services")
}

model Availability {
  id        String @id @default(cuid())
  dayOfWeek Int    @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime String @map("start_time") // "HH:MM"
  endTime   String @map("end_time") // "HH:MM"

  staffId String      @map("staff_id")
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade) // Safe to cascade

  @@index([staffId])
  @@map("availabilities")
}

// L4 Manager — skill taxonomy for workload routing
model Skill {
  id          String @id @default(cuid())
  name        String
  category    String @default("general") // design, writing, video, sales, support, operations, finance, marketing
  description String?

  memberships Membership[]
  staffMembers StaffMember[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name])
  @@map("skills")
}

model Booking {
  id        String   @id @default(cuid())
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED

  businessId String      @map("business_id")
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String      @map("contact_id")
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY
  serviceId  String      @map("service_id")
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: NoAction) // DATA INTEGRITY
  staffId    String?      @map("staff_id")
  staff      StaffMember? @relation(fields: [staffId], references: [id], onDelete: NoAction) // DATA INTEGRITY
  orgUnitId  String?      @map("org_unit_id")
  orgUnit    OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onUpdate: NoAction, onDelete: NoAction) // DATA INTEGRITY

  depositInvoiceId String?  @unique @map("deposit_invoice_id")
  depositInvoice   Invoice? @relation("BookingDepositInvoice", fields: [depositInvoiceId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  paymentStatus   String   @default("UNPAID") @map("payment_status") // UNPAID | DEPOSIT_PAID | PAID

  notes           String?
  location         String?
  locationPlaceId  String? @map("location_place_id")
  locationLatLng   Json?   @map("location_lat_lng")
  calendarEventId String? @map("calendar_event_id")
  reminderSentAt  DateTime? @map("reminder_sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId, staffId, startTime, endTime])
  @@index([businessId, contactId])
  @@index([businessId, orgUnitId])
  @@map("bookings")
}

// ---
// MODULE 5: SOCIAL INTELLIGENCE
// ---
model SocialConnection {
  id             String   @id @default(cuid())
  platform       String // "FACEBOOK", "INSTAGRAM", "LINKEDIN", "TWITTER"
  platformId     String?  @map("platform_id")
  accountName    String?  @map("account_name")
  profilePicture String?  @map("profile_picture")
  token          String
  refreshToken   String?  @map("refresh_token")
  expiresAt      DateTime? @map("expires_at")
  scopes         String?
  status         String   @default("CONNECTED") // CONNECTED, EXPIRED, ERROR

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, platform, platformId])
  @@index([businessId])
  @@index([businessId, platform])
  @@map("social_connections")
}

model SocialPost {
  id          String   @id @default(cuid())
  content     String
  mediaUrls   String[] @map("media_urls")
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, POSTED, FAILED
  scheduledAt DateTime? @map("scheduled_at")
  postedAt    DateTime? @map("posted_at")
  failedAt    DateTime? @map("failed_at")
  channelIds  String[] @default([]) @map("channel_ids")
  publishResults Json?  @map("publish_results")
  externalPostId String? @map("external_post_id")
  externalUrl    String? @map("external_url")
  lastError      String? @map("last_error")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId, status, scheduledAt])
  @@map("social_posts")
}

// ---
// MODULE 5B: UNIFIED COMMUNICATIONS ENGINE
// ---
model ChannelConnection {
  id            String   @id @default(cuid())
  provider      String   // META, GOOGLE, WHATSAPP, MANUAL
  label         String?
  accountEmail  String?  @map("account_email")
  token         String?
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime? @map("expires_at")
  scopes        String?
  providerMeta  Json?    @map("provider_meta")
  healthState   String   @default("Connected") // Connected, NeedsRefresh, Expired, MissingPermission, DestinationMissing, Disabled, Error
  healthMessage String?  @map("health_message")
  lastCheckedAt DateTime? @map("last_checked_at")

  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  destinations  ChannelDestination[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, provider])
  @@map("channel_connections")
}

model ChannelDestination {
  id             String   @id @default(cuid())
  connectionId   String   @map("connection_id")
  connection     ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform       String   // FACEBOOK_PAGE, INSTAGRAM_BUSINESS, EMAIL, WHATSAPP
  platformId     String?  @map("platform_id")
  displayName    String?  @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  capabilities   String[] @default([]) // supports_text_post, supports_image_post, supports_video_post, supports_campaign_email, etc.
  isActive       Boolean  @default(true) @map("is_active")
  destinationMeta Json?   @map("destination_meta")

  businessId     String   @map("business_id")

  deliveries     OutboundDelivery[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@index([connectionId])
  @@index([businessId])
  @@index([businessId, platform])
  @@map("channel_destinations")
}

model OutboundContent {
  id            String   @id @default(cuid())
  contentType   String   @default("social_post") @map("content_type") // social_post, campaign_email, direct_message
  subject       String?
  body          String?
  status        String   @default("Draft") // Draft, Scheduled, Queued, Sending, Sent, PartiallyFailed, Failed, Cancelled
  scheduledAt   DateTime? @map("scheduled_at")
  timezone      String   @default("America/Port_of_Spain")
  publishedAt   DateTime? @map("published_at")
  contentMeta   Json?    @map("content_meta")

  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  variants      OutboundVariant[]
  deliveries    OutboundDelivery[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([businessId, status])
  @@index([businessId, contentType])
  @@index([businessId, scheduledAt])
  @@map("outbound_content")
}

model OutboundVariant {
  id            String   @id @default(cuid())
  contentId     String   @map("content_id")
  content       OutboundContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform      String   // FACEBOOK_PAGE, INSTAGRAM_BUSINESS, EMAIL, WHATSAPP, DEFAULT
  textBody      String?  @map("text_body")
  htmlBody      String?  @map("html_body")
  mediaUrls     String[] @default([]) @map("media_urls")
  variantMeta   Json?    @map("variant_meta")

  deliveries    OutboundDelivery[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([contentId])
  @@index([contentId, platform])
  @@map("outbound_variants")
}

model OutboundDelivery {
  id              String   @id @default(cuid())
  contentId       String   @map("content_id")
  content         OutboundContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  variantId       String?  @map("variant_id")
  variant         OutboundVariant? @relation(fields: [variantId], references: [id])
  destinationId   String   @map("destination_id")
  destination     ChannelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  contactId       String?  @map("contact_id")
  recipientEmail  String?  @map("recipient_email")
  recipientPhone  String?  @map("recipient_phone")
  status          String   @default("Queued") // Queued, Scheduled, Sending, Sent, Published, Failed, RetryPending, Cancelled
  scheduledAt     DateTime? @map("scheduled_at")
  sentAt          DateTime? @map("sent_at")
  externalPostId  String?  @map("external_post_id")
  externalUrl     String?  @map("external_url")
  errorCode       String?  @map("error_code")
  errorMessage    String?  @map("error_message")
  retryCount      Int      @default(0) @map("retry_count")
  maxRetries      Int      @default(3) @map("max_retries")
  nextRetryAt     DateTime? @map("next_retry_at")
  resultSnapshot  Json?    @map("result_snapshot")

  businessId      String   @map("business_id")

  events          DeliveryEvent[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, status])
  @@index([contentId])
  @@index([destinationId])
  @@index([contactId])
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@map("outbound_deliveries")
}

model DeliveryEvent {
  id          String   @id @default(cuid())
  deliveryId  String   @map("delivery_id")
  delivery    OutboundDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type") // attempt, success, failure, retry_scheduled, cancelled
  statusBefore String? @map("status_before")
  statusAfter  String? @map("status_after")
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  resultData   Json?   @map("result_data")
  attemptNumber Int?   @map("attempt_number")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([deliveryId])
  @@index([deliveryId, eventType])
  @@map("delivery_events")
}

// ---
// WhatsApp Business Inbox
// ---
model WhatsAppContact {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  phoneNumber     String   @map("phone_number")
  displayName     String?  @map("display_name")
  contactId       String?  @map("contact_id")
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  lastMessageAt   DateTime? @map("last_message_at")
  lastMessageSnippet String? @map("last_message_snippet")

  messages        WhatsAppMessage[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, phoneNumber])
  @@index([businessId, lastMessageAt])
  @@index([contactId])
  @@map("whatsapp_contacts")
}

model WhatsAppMessage {
  id                 String   @id @default(cuid())
  businessId         String   @map("business_id")
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  whatsappContactId  String   @map("whatsapp_contact_id")
  whatsappContact    WhatsAppContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)

  direction          String   // INBOUND | OUTBOUND
  body               String?
  templateName       String?  @map("template_name")
  templateLanguage   String?  @map("template_language")
  templateParams     Json?    @map("template_params")

  status             String   @default("RECEIVED") // RECEIVED | SENT | SCHEDULED | SENDING | FAILED
  scheduledAt        DateTime? @map("scheduled_at")
  sentAt             DateTime? @map("sent_at")

  wamid              String?  @unique
  destinationId      String?  @map("destination_id")
  deliveryId         String?  @unique @map("delivery_id")
  errorMessage       String?  @map("error_message")

  mediaUrls          String[] @default([]) @map("media_urls")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  @@index([businessId, whatsappContactId, createdAt])
  @@index([businessId, createdAt])
  @@index([status, scheduledAt])
  @@map("whatsapp_messages")
}

model SocialEngagement {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform    String   // FACEBOOK | INSTAGRAM
  type        String   // COMMENT | DM | MENTION | REACTION
  postId      String?  @map("post_id")
  externalId  String?  @map("external_id")
  fromUserId  String?  @map("from_user_id")
  fromUserName String? @map("from_user_name")
  content     String?
  aiHandled   Boolean  @default(false) @map("ai_handled")
  aiResponse  String?  @map("ai_response")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([businessId, platform, aiHandled])
  @@index([businessId, createdAt])
  @@map("social_engagements")
}

// ---
// MODULE 6: MARKETING AUTOMATION & PROJECTS
// ---
model Automation {
  id      String  @id @default(cuid())
  name    String
  trigger String  // "invoice.paid", "booking.created"
  enabled Boolean @default(true)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  actionData Json? @map("action_data")
  condition  String?   @map("condition")
  lastRunAt  DateTime? @map("last_run_at")
  runCount   Int       @default(0) @map("run_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId, trigger])
  @@map("automations")
}

model CrossModuleWorkflow {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workflowKey String  @map("workflow_key")
  enabled     Boolean @default(true)
  config      Json?

  lastRunAt DateTime? @map("last_run_at")
  runCount  Int       @default(0) @map("run_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@unique([businessId, workflowKey])
  @@index([businessId])
  @@map("cross_module_workflows")
}

model ScheduledAgentJob {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  jobType    String   @map("job_type")
  entityId   String   @map("entity_id")
  checkpoint String
  status     String   @default("PENDING")
  payload    Json?
  scheduledFor DateTime @map("scheduled_for")
  executedAt   DateTime? @map("executed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@unique([businessId, entityId, checkpoint])
  @@index([status, scheduledFor])
  @@map("scheduled_agent_jobs")
}

model Activity {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  module     String   // "crm", "commerce", "bookings", "social", "automation"
  action     String   // "created", "updated", "paid", "published", "executed"
  entityType String   @map("entity_type") // "contact", "invoice", "booking", "post", "playbook"
  entityId   String?  @map("entity_id")
  title      String
  detail     String?
  icon       String?
  tone       String?  // "success", "info", "warning", "danger"
  data       Json?
  contactId  String?  @map("contact_id")

  // Business Event Ledger extensions (Phase 1 MD)
  category   String?  // CONTACT | COMMERCE | BOOKING | PAYMENT | AI | SYSTEM | STORE | TASK
  actorType  String?  @map("actor_type") // USER | AI | CUSTOMER | SYSTEM
  actorId    String?  @map("actor_id")
  status     String?  // SCHEDULED | COMPLETED | CANCELLED | FAILED | PENDING
  priority   String?  // LOW | NORMAL | HIGH | URGENT
  revenueImpact Float? @map("revenue_impact")
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  occurredAt DateTime @default(now()) @map("occurred_at")
  type       String?  // Convenience field for event type (e.g. "contact.created", "invoice.paid")

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, occurredAt])
  @@index([businessId, category, occurredAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, contactId, occurredAt])
  @@map("activities")
}

model Project {
  id          String @id @default(cuid())
  name        String
  description String?
  status      String @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, ARCHIVED
  priority    String @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  color       String?

  // Time tracking
  hourlyRate  Float?   @map("hourly_rate")

  // Scheduling & Budgeting (Phase 2/5)
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  budgetAmount Float?    @map("budget_amount")
  budgetHours  Float?    @map("budget_hours")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tasks      ProjectTask[]
  milestones ProjectMilestone[]
  changeOrders ChangeOrder[]

  // Goal linkage: projects serve strategic business goals
  goalId     String?      @map("goal_id")
  goal       BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectPlans ProjectPlan[]

  contactId  String?  @map("contact_id")
  invoiceId  String?  @map("invoice_id")
  bookingId  String?  @map("booking_id")
  dueDate    DateTime? @map("due_date")

  timeEntries TimeEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@index([businessId, status])
  @@index([goalId])
  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  dueDate     DateTime? @map("due_date")
  priority    String   @default("NORMAL")
  sortOrder   Int      @default(0) @map("sort_order")
  assigneeId  String?  @map("assignee_id")

  // Kanban / Gantt (Phase 2)
  status      String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE, BLOCKED
  position    Int      @default(0)      // for DnD ordering within a column
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  // Time tracking
  estimatedHours Float?  @map("estimated_hours")
  trackedHours   Float   @default(0) @map("tracked_hours")

  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Phase 0: evidence requirement for task completion
  evidenceRequired Boolean @default(false) @map("evidence_required")

  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([businessId])
  @@index([projectId, status])
  @@index([projectId, position])
  @@map("project_tasks")
}

model TimeEntry {
