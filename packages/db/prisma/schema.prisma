model BusinessSnapshot {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshotType      String   @map("snapshot_type") // daily | weekly | monthly
  snapshotDate      DateTime @map("snapshot_date")

  // Revenue
  totalRevenue      Decimal? @db.Decimal(18, 4) @map("total_revenue")
  invoiceCount      Int?     @map("invoice_count")
  paidInvoiceCount  Int?     @map("paid_invoice_count")
  overdueInvoiceCount Int?   @map("overdue_invoice_count")
  totalOverdueAmount Decimal? @db.Decimal(18, 4) @map("total_overdue_amount")
  averageInvoiceValue Decimal? @db.Decimal(18, 4) @map("average_invoice_value")
  collectionRate    Float?   @map("collection_rate")

  // Contacts & CRM
  totalContacts     Int?     @map("total_contacts")
  newContacts       Int?     @map("new_contacts")
  activeLeads       Int?     @map("active_leads")
  leadConversionRate Float?  @map("lead_conversion_rate")
  customerRetentionRate Float? @map("customer_retention_rate")

  // Bookings & Calendar
  totalBookings     Int?     @map("total_bookings")
  upcomingBookings  Int?     @map("upcoming_bookings")
  completedBookings Int?     @map("completed_bookings")
  noShowRate        Float?   @map("no_show_rate")

  // Commerce
  totalQuotes       Int?     @map("total_quotes")
  acceptedQuotes    Int?     @map("accepted_quotes")
  quoteAcceptanceRate Float? @map("quote_acceptance_rate")
  totalDeals        Int?     @map("total_deals")
  openDealsValue    Decimal? @db.Decimal(18, 4) @map("open_deals_value")

  // Automation
  activeFlows       Int?     @map("active_flows")
  flowRuns          Int?     @map("flow_runs")
  flowSuccessRate   Float?   @map("flow_success_rate")

  // Engagement
  messagesSent      Int?     @map("messages_sent")
  messagesReceived  Int?     @map("messages_received")
  responseRate      Float?   @map("response_rate")
  averageResponseTimeMinutes Int? @map("avg_response_time_min")

  // Storefront
  storefrontVisits  Int?     @map("storefront_visits")
  ordersReceived    Int?     @map("orders_received")
  cartAbandonmentRate Float? @map("cart_abandonment_rate")

  // Composite
  healthScore       Int?     @map("health_score")
  momentumScore     Int?     @map("momentum_score")
  growthRate        Float?   @map("growth_rate")

  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([businessId, snapshotType, snapshotDate])
  @@index([businessId, snapshotType, snapshotDate])
  @@index([snapshotDate])
  @@map("business_snapshots")
}


