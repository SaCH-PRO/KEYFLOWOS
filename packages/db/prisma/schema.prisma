// ---
// MODULE 21: CUSTOMER JOURNEY & GROWTH INTELLIGENCE (Phase 10)
// ---

// Aggregated journey state for a contact across all channels — first-class entity
// linked to the Business Graph that summarizes the contact's lifecycle.
model CustomerJourney {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  contactId    String   @unique @map("contact_id")

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Lifecycle stage derived from touchpoints + commerce events
  stage        String   @default("AWARENESS") // AWARENESS, INTEREST, CONSIDERATION, CONVERSION, RETENTION, ADVOCACY, CHURNED

  // Timing
  firstTouchAt DateTime? @map("first_touch_at")
  lastTouchAt  DateTime? @map("last_touch_at")
  convertedAt  DateTime? @map("converted_at")

  // First-touch attribution
  firstTouchChannel String? @map("first_touch_channel")
  firstTouchSource  String? @map("first_touch_source")
  firstTouchCampaign String? @map("first_touch_campaign")

  // Last-touch attribution
  lastTouchChannel  String? @map("last_touch_channel")
  lastTouchSource   String? @map("last_touch_source")
  lastTouchCampaign String? @map("last_touch_campaign")

  // Aggregates
  touchpointCount Int     @default(0) @map("touchpoint_count")
  channels        String[] @default([])
  totalRevenue    Decimal @default(0) @db.Decimal(12, 2) @map("total_revenue")
  conversionValue Decimal @default(0) @db.Decimal(12, 2) @map("conversion_value")
  daysToConversion Int?   @map("days_to_conversion")

  // Health & insights
  momentum       Int      @default(0)
  healthScore    Int      @default(50) @map("health_score")
  riskLevel      String   @default("none") @map("risk_level") // none, low, medium, high
  metadata       Json?

  touchpoints    JourneyTouchpoint[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@index([businessId, stage])
  @@index([businessId, lastTouchAt])
  @@index([businessId, healthScore])
  @@map("customer_journeys")
}

// Individual touchpoint events that make up the journey.
model JourneyTouchpoint {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  contactId    String   @map("contact_id")
  journeyId    String   @map("journey_id")

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  journey      CustomerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  // Channel taxonomy (organic, social, email, paid, referral, direct, form, sms, whatsapp, etc.)
  channel      String
  // Source within the channel (e.g. "instagram", "mailchimp", "typeform", "wipay")
  source       String
  // Optional campaign id (links to EmailCampaign or SocialPost or external campaign)
  campaignId   String?  @map("campaign_id")
  campaignName String?  @map("campaign_name")
  contentId    String?  @map("content_id")

  // Touchpoint type — engagement, conversion, retention, etc.
  touchpointType String  @map("touchpoint_type") // page_view, form_submit, email_open, email_click, social_engagement, message, call, quote, booking, payment, review
  // Pre-computed stage hint so the journey aggregator can promote the contact
  stageHint     String?  @map("stage_hint")

  value         Decimal? @db.Decimal(12, 2)
  currency      String?  @default("TTD")

  // Free-form context (UTM data, post id, etc.)
  metadata      Json?

  // Pre-computed attribution weights for the three models stored on the journey
  firstTouchWeight  Float @default(0) @map("first_touch_weight")
  lastTouchWeight   Float @default(0) @map("last_touch_weight")
  linearWeight      Float @default(0) @map("linear_weight")

  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([businessId, contactId, occurredAt])
  @@index([businessId, channel, occurredAt])
  @@index([businessId, source, occurredAt])
  @@index([journeyId, occurredAt])
  @@index([businessId, campaignId])
  @@map("journey_touchpoints")
}

// Pre-computed attribution rollups for fast dashboard reads.
model AttributionResult {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Bucket dimension — channel, source, or campaign
  dimension    String   // "channel", "source", "campaign"
  dimensionKey String   @map("dimension_key")
  dimensionLabel String? @map("dimension_label")

  // Attribution model
  model        String   // "first_touch", "last_touch", "linear"

  // Period
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")

  // Metrics
  attributedRevenue Decimal @default(0) @db.Decimal(12, 2) @map("attributed_revenue")
  conversions       Int     @default(0)
  touchpoints       Int     @default(0)
  uniqueContacts    Int     @default(0) @map("unique_contacts")
  costSpent         Decimal @default(0) @db.Decimal(12, 2) @map("cost_spent")
  roas              Float?  // Return on ad spend

  computedAt   DateTime @default(now()) @map("computed_at")

  @@unique([businessId, dimension, dimensionKey, model, periodStart, periodEnd])
  @@index([businessId, model, periodEnd])
  @@index([businessId, dimension, model])
  @@map("attribution_results")
}

// AI-generated growth insights surfaced on the Growth Intelligence dashboard.
model GrowthInsight {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  category     String   // channel_performance, campaign_health, acquisition_cost, ltv, churn_risk, recommendation
  insightType  String   @map("insight_type") // best_channel, underperforming, cost_trend, ltv_pattern, next_action
  severity     String   @default("info") // info, opportunity, warning, critical
  title        String
  description  String?
  // What the system recommends
  recommendation String? @map("recommendation")
  // LLM-written context: short rationale explaining *why* this matters and a concrete first step
  rationale       String? @map("rationale")
  suggestedAction String? @map("suggested_action")
  // Source of the rationale/recommendation: 'heuristic' (rules only) or 'ai' (LLM-enriched)
  source          String  @default("heuristic") @map("source")
  // Estimated impact (money or % uplift)
  estimatedImpact Decimal? @db.Decimal(12, 2) @map("estimated_impact")
  impactCurrency  String?   @default("TTD") @map("impact_currency")

  // Where to take action
  actionLabel  String?  @map("action_label")
  actionRoute  String?  @map("action_route")

  // Supporting data + dimensions
  dimension    String?  // channel, campaign, contact, segment
  dimensionKey String?  @map("dimension_key")
  metrics      Json?    // Raw numbers to display in card

  status       String   @default("active") // active, acknowledged, dismissed, applied
  acknowledgedAt DateTime? @map("acknowledged_at")
  appliedAt    DateTime? @map("applied_at")
  expiresAt    DateTime? @map("expires_at")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@index([businessId, status, createdAt])
  @@index([businessId, category, status])
  @@index([businessId, severity, status])
  @@map("growth_insights")
}

// =====================================================================
// Auth hardening (Tier 2): per-IP/email rate limiting + audit trail
// =====================================================================

/// Sliding-window rate-limit ledger. One row per attempt; the limiter
/// counts rows in (NOW() - windowMs) and rejects when threshold reached.
/// A periodic prune deletes rows older than the longest active window.
model AuthRateLimit {
  id     String   @id @default(cuid())
  /// Logical bucket key, e.g. "login:ip:1.2.3.4" or "signup:email:foo@bar.com".
  /// Always lower-cased and namespace-prefixed by the limiter.
  bucket String
  hitAt  DateTime @default(now()) @map("hit_at")

  @@index([bucket, hitAt])
  @@map("auth_rate_limits")
}

/// Runtime-configurable feature flags. Each row identifies a workspace
/// nav feature (or any other gated capability) and stores whether it is
/// currently in a "coming soon" state plus a list of user emails that
/// bypass the lock. Rows are seeded lazily by the API the first time the
/// owner console reads them; missing rows behave as "not coming soon".
// ---
// KEY-1: BUSINESS BLUEPRINT — operating DNA
// ---
//
// One row per Business. Acts as the canonical, mutable description of the
// business that every later system (KEY orchestrator, storefront builder,
// contact intelligence, procurement) reads from. Replaces the scattered
// data living across Business.metaData, BusinessGuidanceProfile, and the
// onboarding-concierge JSON blobs.
//
// Sections are JSON columns so the shape can iterate without migrations
// while we settle on the right ontology. `schemaVersion` lets us migrate
// in code when a section's shape stabilises. `completeness` is the
// server-side weighted score surfaced to operators.
//
// Source-of-truth precedence when computing recommendations:
//   1. BusinessBlueprint (this table) — operator-confirmed truth
//   2. BusinessGuidanceProfile sub-profiles — legacy, sunset in KEY-9
//   3. Business profile fields — legacy, sunset in KEY-9
//
model BusinessBlueprint {
  id            String   @id @default(cuid())
  businessId    String   @unique @map("business_id")
  schemaVersion Int      @default(1) @map("schema_version")

  /// { name, tagline, missionStatement, visionStatement, story,
  ///   archetype, industry, foundedAt, country, languagesServed[] }
  identity       Json     @default("{}")

  /// { revenueModel, deliveryMethod, fulfillmentStyle, teamSize,
  ///   timeCommitment, capacity: { mode, slotsPerWeek }, weeklyHours,
  ///   pricingModel, paymentTerms, leadTime }
  operatingModel Json     @default("{}") @map("operating_model")

  /// { primaryGoal, northStarMetric, horizonMonths, revenueTarget,
  ///   newCustomersTarget, focusAreas[] }
  goals          Json     @default("{}")

  /// { budgetCeiling, timeAvailable, regulatoryFlags[], geographic[],
  ///   doNotDoList[], complianceNotes }
  constraints    Json     @default("{}")

  /// { primaryColor, secondaryColor, accentColor, voice, tone, keywords[],
  ///   positioningStatement, doNotSay[], referenceBrands[] }
  brand          Json     @default("{}")

  /// { targetSegments[], demographics, painPoints[], buyingTriggers[],
  ///   acquisitionChannels[], lifetimeValueTtd, repeatRatePct,
  ///   referralPropensity }
  customerModel  Json     @default("{}") @map("customer_model")

  /// { priceRange: { low, high }, avgMargin, costStructure[], runwayMonths,
  ///   cashPositionTier, processorMix[] }
  financials     Json     @default("{}")

  /// AI-inferred patterns + provenance. Mostly written by the KEY
  /// orchestrator and the timeline ledger. Operators do NOT edit this
  /// directly — they edit upstream sections and the AI reconciles.
  /// { lastInferenceAt, eventCount, inferredPatterns[], aiSummary,
  ///   confidence, provenance: { source, lastSyncAt }[] }
  intelligence   Json     @default("{}")

  /// Workflow model: service-based, project-based, retainer-based,
  /// walk-in, ecommerce, custom-inquiry delivery workflows.
  /// { primaryWorkflow, appointmentBooking, projectManagement,
  ///   retainerCycle, walkInQueue, ecommerceFulfillment, customInquiryFlow }
  workflowModel  Json?    @map("workflow_model")

  /// AI preferences: autonomy level, tone, notification settings,
  /// approved actions, voice input enabled.
  /// { autonomyLevel, tone, notifyOnRecommendations, notifyOnAlerts,
  ///   approvedActions[], voiceEnabled }
  aiPreferences  Json?    @map("ai_preferences")

  // --- Business Genesis sections (Patch 1) --------------------------------

  /// { founderName, background, skills[], weaknesses[], riskTolerance,
  ///   weeklyAvailabilityHours, visionStatement }
  founderProfile Json? @map("founder_profile")

  /// { country, jurisdiction, hasPhysicalLocation, recommendedEntityType,
  ///   entityTypeReason, regulatedIndustry, regulatedIndustryNotes[],
  ///   legalRiskFlags[], disclaimerAcceptedAt }
  legalProfile Json? @map("legal_profile")

  /// { businessNameStatus, companiesRegistryStatus, birStatus,
  ///   nisEmployerStatus, vatStatus, businessBankStatus,
  ///   requiredLicenses[], missingRegistrationSteps[] }
  registrationProfile Json? @map("registration_profile")

  /// { country, taxIdStatus, vatThresholdWatch, estimatedAnnualRevenue,
  ///   payrollExpected, contractorPaymentsExpected, taxReadinessScore }
  taxProfile Json? @map("tax_profile")

  /// { hasPartners, owners[], needsShareholderAgreement,
  ///   unresolvedOwnershipRisks[] }
  ownershipProfile Json? @map("ownership_profile")

  /// { targetGeography, marketCategory, marketStage, trends[],
  ///   barriersToEntry[], demandSignals[], marketOpportunityScore }
  marketProfile Json? @map("market_profile")

  /// { coreOffer, offerLadder[], pricingTiers[], upsells[],
  ///   recurringRevenueOpportunities[] }
  offerArchitecture Json? @map("offer_architecture")

  /// { salesChannels[], pipelineStages[], leadSources[],
  ///   conversionAssumptions, followUpCadence }
  salesSystem Json? @map("sales_system")

  /// { channels[], contentPillars[], campaignIdeas[], brandNarrative,
  ///   launchPlan[] }
  marketingSystem Json? @map("marketing_system")

  /// { coreWorkflows[], dailyChecklist[], weeklyChecklist[],
  ///   fulfillmentProcess[], customerSupportProcess[], vendorProcess[] }
  operationsSystem Json? @map("operations_system")

  /// { startupCapital, startupCosts, monthlyFixedCosts,
  ///   variableCostPercent, avgTicket, expectedMonthlyUnits,
  ///   conservativeMonthlyUnits, aggressiveMonthlyUnits, breakEvenUnits,
  ///   breakEvenRevenue, runwayMonths, monthByMonth[] }
  projectionProfile Json? @map("projection_profile")

  /// { financialRisks[], legalRisks[], marketRisks[], operationalRisks[],
  ///   founderRisks[], riskScore, mitigationPlan[] }
  riskProfile Json? @map("risk_profile")

  /// { complianceItems[], complianceScore }
  complianceProfile Json? @map("compliance_profile")

  /// { today[], sevenDayPlan[], thirtyDayPlan[], ninetyDayPlan[],
  ///   twelveMonthMilestones[] }
  executionRoadmap Json? @map("execution_roadmap")

  /// { generatedDocuments[], missingDocuments[] }
  documentProfile Json? @map("document_profile")

  /// 0–100 Genesis readiness score. Separate from core completeness so the
  /// existing onboarding guard remains stable while Genesis modules mature.
  readinessScore Int @default(0) @map("readiness_score")

  /// Per-section confidence scores { identity, operatingModel, goals,
  ///   customerModel, brand, financials, constraints, workflowModel }
  confidenceScores Json?  @default("{}") @map("confidence_scores")

  /// 0–100 weighted completeness score. Identity 25, operatingModel 20,
  /// goals 15, customerModel 15, brand 10, financials 10, constraints 5.
  completeness  Int      @default(0)

  lastAnalyzedAt DateTime? @map("last_analyzed_at")

  // Business Genome Phase 1 cache/state fields
  genomeIntegrity     Int?     @map("genome_integrity")
  genomeDnaScores     Json?    @default("{}") @map("genome_dna_scores")
  genomeDnaConfidence Json?    @default("{}") @map("genome_dna_confidence")
  genomeStage         String?  @map("genome_stage")
  genesisCompleted    Boolean? @default(false) @map("genesis_completed")

  constitutionVersion     Int?      @default(1) @map("constitution_version")
  constitutionGeneratedAt DateTime? @map("constitution_generated_at")

  // Architecture hooks for Phase 2+
  lastGenomeSyncAt        DateTime? @map("last_genome_sync_at")
  businessAssets          Json?     @default("{}") @map("business_assets")
  executiveReadinessScore Int?      @map("executive_readiness_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([completeness])
  @@map("business_blueprints")
}

model GenomeChatMessage {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  role       String
  content    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("genome_chat_messages")
}

model FeatureFlag {
  id           String   @id @default(cuid())
  /// Stable key used in code (e.g. "nav.workspaces.seo").
  key          String   @unique
  /// Human readable label shown in the owner console.
  label        String
  /// Optional grouping (e.g. "Workspaces", "Studio") for the admin UI.
  category     String?
  /// When true the feature is presented as a locked "coming soon" item.
  comingSoon   Boolean  @default(false) @map("coming_soon")
  /// Lower-cased list of user emails permitted to bypass the lock.
  bypassEmails String[] @default([])    @map("bypass_emails")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@map("feature_flags")
}

/// Append-only audit log of every authentication-relevant event:
/// signup, login_success, login_failure, resend_verification, rate_limited.
/// Surfaced in the admin Security UI; retained for forensic review.
model AuthAuditLog {
  id        String   @id @default(cuid())
  /// signup | login_success | login_failure | resend_verification | rate_limited
  event     String
  /// Outcome bucket: success | failure | rate_limited | error
  outcome   String
  email     String?
  userId    String?  @map("user_id")
  ip        String?
  userAgent String?  @map("user_agent")
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("auth_audit_logs")
}

// ---
// MODULE M7: PER-CONTACT AUDIT LOG + GDPR EXPORT/FORGET
// ---

/// Tamper-evident per-contact audit log. One row per mutation against a
/// Contact (or its child rows: communications, deals, notes, attachments).
/// On hard purge during the GDPR "forget" flow, identifiers in this table
/// are replaced with one-way hashes so the compliance trail survives but
/// no PII does. Append-only by convention.
model ContactAuditEntry {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  contactId   String?  @map("contact_id")
  /// Stable hashed contact identifier — survives purge; format
  /// "sha256:<hex>". Always populated.
  contactHash String   @map("contact_hash")
  /// Canonical action: created | updated | deleted | restored | merged |
  /// reassigned | shared | imported | exported | forget_requested |
  /// forget_cancelled | forget_purged | note_added | note_updated |
  /// note_deleted | task_added | task_updated | task_deleted |
  /// communication_logged | child_updated.
  action      String
  /// Which child entity this entry concerns: contact | note | task |
  /// event | invoice | quote | booking | media | sequence.
  entityType  String   @default("contact") @map("entity_type")
  entityId    String?  @map("entity_id")
  /// Free-form actor info: { type: USER|SYSTEM|API, id?, label? }.
  actor       Json?
  before      Json?
  after       Json?
  /// Computed list of changed field names for fast filtering.
  changedFields String[] @default([]) @map("changed_fields")
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([businessId, contactId, createdAt])
  @@index([businessId, contactHash, createdAt])
  @@index([businessId, action, createdAt])
  @@map("contact_audit_entries")
}

/// One-time signed download bundle for a "Export contact data" request.
/// Stores the bundle in object storage and gates downloads via a
/// random token + expiry. Each successful download writes a
/// `exported` audit entry on the contact.
model ContactExportJob {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  contactId    String   @map("contact_id")
  requestedById String? @map("requested_by_id")
  /// Random URL-safe token used by the public download endpoint.
  token        String   @unique
  /// Object-storage key for the JSON bundle.
  jsonKey      String   @map("json_key")
  /// Object-storage key for the ZIP bundle (contains the JSON + any
  /// referenced attachment metadata files).
  zipKey       String   @map("zip_key")
  byteSize     Int?     @map("byte_size")
  expiresAt    DateTime @map("expires_at")
  /// Maximum number of times the token may be redeemed for a signed
  /// URL. Defaults to 1 (one-time download) per GDPR compliance.
  maxDownloads Int      @default(1) @map("max_downloads")
  downloadCount Int     @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([businessId, contactId])
  @@index([expiresAt])
  @@map("contact_export_jobs")
}

/// "Forget contact" request. The contact is soft-deleted immediately
/// and recoverable until `purgeAt`; a scheduled job then hard-deletes
/// the contact + child rows and replaces identifiers in the audit log
/// with hashed values. One active request per contact.
// ---
// MODULE: PRESENCE EDITOR (S3)
// Draft → Preview → Published state machine for the public site composition.
// Payload is a typed JSON document of branding, sections (ordered), seo, slug,
// custom domain, and mobile preview state. The published payload is what the
// public renderer reads; the draft is what the operator edits.
// ---
model SitePageDraft {
  id               String    @id @default(cuid())
  businessId       String    @unique @map("business_id")
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  version          Int       @default(1)
  payload          Json      @default("{}")
  status           String    @default("DRAFT") // DRAFT | PREVIEW
  previewToken     String?   @unique @map("preview_token")
  previewExpiresAt DateTime? @map("preview_expires_at")
  lastSavedById    String?   @map("last_saved_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("site_page_drafts")
}

model SitePagePublished {
  id            String    @id @default(cuid())
  businessId    String    @unique @map("business_id")
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  version       Int       @default(1)
  payload       Json      @default("{}")
  publishedAt   DateTime  @default(now()) @map("published_at")
  publishedById String?   @map("published_by_id")
  unpublishedAt DateTime? @map("unpublished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("site_pages_published")
}

model ContactForgetRequest {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  /// Nullable + ON DELETE SET NULL: the request must survive the
  /// hard-purge of the contact so compliance reviewers can see the
  /// historical forget action even after PII is gone. `contactHash`
  /// preserves an opaque pointer to the original contact.
  contactId   String?  @unique @map("contact_id")
  contactHash String?  @map("contact_hash")
  requestedById String? @map("requested_by_id")
  reason      String?
  /// requested | purged | cancelled
  status      String   @default("requested")
  requestedAt DateTime @default(now()) @map("requested_at")
  purgeAt     DateTime @map("purge_at")
  purgedAt    DateTime? @map("purged_at")
  cancelledAt DateTime? @map("cancelled_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([status, purgeAt])
  @@index([contactHash])
  @@map("contact_forget_requests")
}


/// Per-revenue-event attribution row written every time a storefront-originated
/// (or other) revenue event is recorded. Powers GrowthStack/ProfitLens
/// "where did this revenue come from?" queries without re-deriving it from
/// scratch each time.
///
/// `revenueType` is one of: ORDER | INVOICE | BOOKING.
/// `revenueId` references the corresponding row id (MarketplaceOrder.id,
/// Invoice.id, Booking.id) — not enforced as an FK because the kind varies.
model RevenueAttribution {
  id                 String   @id @default(cuid())
  businessId         String   @map("business_id")
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  source             String   // storefront | quote | recurring | manual | community | ...
  sourceDetail       String?  @map("source_detail") // storefront slug, etc.
  revenueType        String   @map("revenue_type") // ORDER | INVOICE | BOOKING
  revenueId          String   @map("revenue_id")

  contactId          String?  @map("contact_id")
  referralContactId  String?  @map("referral_contact_id")
  referralCode       String?  @map("referral_code")
  visitorId          String?  @map("visitor_id")

  // R5: optional secondary attribution targets so a revenue row can be linked
  // to the campaign / staff member that drove it. Single dominant source is
  // assumed for v1 (no multi-touch); `attributionPercent` defaults to 100.
  campaignId         String?  @map("campaign_id")
  staffId            String?  @map("staff_id")
  attributionPercent Float    @default(100) @map("attribution_percent")
  editedAt           DateTime? @map("edited_at")
  editedBy           String?  @map("edited_by")

  amount             Float
  currency           String   @default("TTD")

  occurredAt         DateTime @default(now()) @map("occurred_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([businessId, revenueType, revenueId])
  @@index([businessId, occurredAt])
  @@index([businessId, source, occurredAt])
  @@index([businessId, referralContactId])
  @@index([businessId, contactId])
  @@index([businessId, campaignId])
  @@index([businessId, staffId])
  @@map("revenue_attributions")
}

/// R5: Time-cost ledger. One row = one block of minutes spent on a related
/// invoice/quote/booking/project/order, with optional staff cost rate so we
/// can compute revenue-per-hour and "what did this client cost us in time?"
/// rollups.
///
/// `refType` is one of: INVOICE | QUOTE | BOOKING | PROJECT | ORDER. The
/// `refId` is intentionally NOT a foreign key because the kind varies; we
/// treat it as a polymorphic pointer + always carry `businessId` for tenant
/// isolation.
model TimeCostEntry {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")

  refType     String   @map("ref_type")
  refId       String   @map("ref_id")
  contactId   String?  @map("contact_id")
  staffId     String?  @map("staff_id")
  userId      String?  @map("user_id")

  minutes     Int
  costRate    Float?   @map("cost_rate")    // per-hour cost in business currency
  costAmount  Float?   @map("cost_amount")  // computed = minutes/60 * costRate
  currency    String   @default("TTD")
  notes       String?
  source      String   @default("manual")   // manual | timer | import

  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([businessId, refType, refId])
  @@index([businessId, contactId, occurredAt])
  @@index([businessId, staffId, occurredAt])
  @@index([businessId, occurredAt])
  @@map("time_cost_entries")
}

/// Daily aggregate of storefront conversion funnel events.
/// One row per (businessId, day, kind, refId?) where:
///   kind = 'product' | 'service' | 'overall'
///   refId = product.id | service.id | null (for overall)
/// Populated by StorefrontConversionService.aggregateDay() — idempotent upsert
/// keyed on (businessId, day, kind, refId).
model StorefrontConversionDaily {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  day         DateTime @db.Date
  kind        String   // product | service | overall
  refId       String   @default("") @map("ref_id")

  views       Int      @default(0)
  cartAdds    Int      @default(0) @map("cart_adds")
  checkouts   Int      @default(0)
  orders      Int      @default(0)
  bookings    Int      @default(0)
  revenue     Float    @default(0)
  currency    String   @default("TTD")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, day, kind, refId])
  @@index([businessId, day])
  @@index([businessId, kind, day])
  @@map("storefront_conversion_daily")
}

/// Anonymous public-storefront events captured before identification.
/// On identification, `contactId` is back-stitched and a canonical
/// ContactEvent is also written via CrmTimelineService for visibility
/// in the contact timeline.
model PublicVisitorEvent {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  visitorId    String    @map("visitor_id")
  contactId    String?   @map("contact_id")
  type         String
  sourceDetail String?   @map("source_detail")
  referralCode String?   @map("referral_code")
  data         Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  identifiedAt DateTime? @map("identified_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, visitorId])
  @@index([businessId, contactId])
  @@index([businessId, type, createdAt])
  @@map("public_visitor_events")
}

/// First-party public-page event capture (S4). Schema-level superset of
/// PublicVisitorEvent — `PublicEvent` is the raw, batched ingestion table
/// from the browser SDK (page views, item views, clicks, share, etc).
/// Nightly aggregation rolls these up into PresenceDailyStat. Raw events
/// are subject to TTL-based cleanup (default 90 days).
model PublicEvent {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  visitorId  String   @map("visitor_id")
  sessionId  String?  @map("session_id")
  contactId  String?  @map("contact_id")
  type       String
  path       String?
  source     String?  // utm_source or referrer host
  medium     String?  // utm_medium
  campaign   String?  // utm_campaign
  referrer   String?
  payload    Json     @default("{}")
  ipHash     String?  @map("ip_hash")
  ts         DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, ts])
  @@index([businessId, type, ts])
  @@index([businessId, visitorId])
  @@index([businessId, sessionId])
  @@map("public_events")
}

/// Persistent first-touch attribution for an anonymous visitor cookie.
/// Created on first PublicEvent and propagated to any Contact created via
/// storefront flows (S2 hand-off).
model PublicVisitor {
  businessId    String   @map("business_id")
  visitorId     String   @map("visitor_id") // value of kf_vid cookie
  firstSource   String?  @map("first_source")
  firstMedium   String?  @map("first_medium")
  firstCampaign String?  @map("first_campaign")
  firstReferrer String?  @map("first_referrer")
  firstPath     String?  @map("first_path")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  contactId     String?  @map("contact_id")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, visitorId])
  @@index([businessId, lastSeenAt])
  @@index([businessId, contactId])
  @@map("public_visitors")
}

/// Daily roll-up of public events per business / metric / dimension.
/// `metric` is one of: visit, view, conv_started, conv_completed,
/// share, whatsapp_click, form_submit, etc. `dimension` describes how
/// `dimKey` is keyed: 'all' | 'page' | 'product' | 'service' | 'source'
/// | 'medium' | 'campaign' | 'referrer'.
model PresenceInsightSnapshot {
  id            String   @id @default(cuid())
  businessId    String   @unique @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Schema version for the payload shape so older cached rows can be evicted.
  version       Int      @default(1)

  /// Window (UTC days) used to derive these insights.
  windowDays    Int      @default(30) @map("window_days")

  /// Full snapshot payload — see StorefrontIntelligenceService for the typed
  /// shape ({ generatedAt, narrative, categories: { money, time, people, services, goods } }).
  payload       Json

  /// True when underlying data has changed and a recompute is pending.
  stale         Boolean  @default(false)

  /// "ai" when narration was produced by the AI gateway, "template" when the
  /// deterministic fallback was used.
  narrativeSource String? @map("narrative_source")
  modelUsed     String?  @map("model_used")

  computedAt    DateTime @default(now()) @map("computed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([businessId, computedAt])
  @@index([businessId, stale])
  @@map("presence_insight_snapshots")
}

model PresenceDailyStat {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  day        DateTime @db.Date
  metric     String
  dimension  String
  dimKey     String   @map("dim_key")
  count      Int      @default(0)
  uniques    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day, metric, dimension, dimKey])
  @@index([businessId, day])
  @@index([businessId, metric, day])
  @@map("presence_daily_stats")
}

// ---
// MODULE 25: FINANCE OS (FIN1)
// ---
// Schema foundation for the unified Financial Operating System. The audit
// at attached_assets/gh_1777950587461.docx specifies these primitives. All
// monetary fields use Decimal(18,4) (NOT Float) because rounding drift
// accumulates over a ledger and breaks reconciliation.
//
// Architectural rules:
//  - LedgerEntry rows are append-only. Reversals create offsetting entries
//    via FinancialTransaction.reversalOfId.
//  - Every monetary write must go through PostingService. Direct INSERTs
//    into LedgerEntry from anywhere except PostingService are forbidden.
//  - businessId scoping is enforced inside services, not at the route layer.

/// Cash container — bank account, payment processor, credit card, loan,
/// equity account, etc. Each FinancialAccount maps 1:1 to a ChartOfAccount
/// row of asset/liability/equity type so balances roll up into reports.
model FinancialAccount {
  id               String   @id @default(cuid())
  businessId       String   @map("business_id")
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  chartOfAccountId String   @map("chart_of_account_id")
  chartOfAccount   ChartOfAccount @relation("FinancialAccountChartLink", fields: [chartOfAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name             String
  type             String   // CASH, BANK, PAYMENT_PROCESSOR, CREDIT_CARD, LOAN, EQUITY, TAX, OTHER
  subtype          String?  // e.g. "wipay", "paypal", "stripe", "savings"
  currency         String   @default("TTD")
  openingBalance   Decimal  @default(0) @db.Decimal(18, 4) @map("opening_balance")
  currentBalance   Decimal  @default(0) @db.Decimal(18, 4) @map("current_balance")
  institution      String?
  accountLast4     String?  @map("account_last4")
  isDefault        Boolean  @default(false) @map("is_default")
  isActive         Boolean  @default(true)  @map("is_active")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]
  bankConnections  BankConnection[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, isActive])
  @@index([businessId, chartOfAccountId])
  @@map("financial_accounts")
}

/// Chart of Accounts — the accounting buckets every ledger entry posts
/// against (Cash, Accounts Receivable, Revenue, COGS, Operating Expense
/// sub-buckets, Tax Payable, Owner Equity, etc.). System rows are seeded
/// per-business by ChartOfAccountsSeederService and cannot be deleted.
model ChartOfAccount {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  code        String?
  name        String
  type        String   // ASSET, LIABILITY, EQUITY, INCOME, COGS, EXPENSE
  subtype     String?
  /// Canonical key for system rows — lets services look up "the AR account"
  /// without hard-coding an id. e.g. CASH, BANK, ACCOUNTS_RECEIVABLE,
  /// ACCOUNTS_PAYABLE, REVENUE, COGS, TAX_PAYABLE, OWNER_EQUITY.
  systemKey   String?  @map("system_key")

  parentId    String?  @map("parent_id")
  parent      ChartOfAccount?  @relation("CoaParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ChartOfAccount[] @relation("CoaParent")

  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true)  @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  ledgerEntries     LedgerEntry[]
  expenseCategories ExpenseCategory[]
  financialAccounts FinancialAccount[] @relation("FinancialAccountChartLink")
  bankRules         BankRule[]

  @@unique([businessId, systemKey])
  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, parentId])
  @@map("chart_of_accounts")
}

/// Unified transaction wrapper. One FinancialTransaction owns N LedgerEntry
/// rows whose debits must equal credits (validated by PostingService).
model FinancialTransaction {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type          String   // INCOME, EXPENSE, TRANSFER, REFUND, TAX, ADJUSTMENT, REVERSAL, OPENING_BALANCE
  status        String   @default("POSTED") // DRAFT, POSTED, VOID, REVERSED
  date          DateTime
  description   String?
  amount        Decimal  @default(0) @db.Decimal(18, 4)
  currency      String   @default("TTD")

  contactId     String?  @map("contact_id")
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Source pointer for traceability — e.g. ('Invoice', 'inv_123').
  sourceType    String?  @map("source_type")
  sourceId      String?  @map("source_id")

  /// Idempotency key. Deterministic external ref of the form
  /// `${sourceType}:${sourceId}:${kind}` lets re-posting be a no-op.
  /// Scoped per business via the @@unique([businessId, externalRef])
  /// composite index — never global, to prevent cross-tenant collision.
  externalRef   String?  @map("external_ref")

  reversalOfId  String?  @unique @map("reversal_of_id")
  reversalOf    FinancialTransaction?  @relation("TxnReversal", fields: [reversalOfId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reversedBy    FinancialTransaction?  @relation("TxnReversal")

  reference     String?
  notes         String?
  metadata      Json?
  postedAt      DateTime? @map("posted_at")
  createdById   String?  @map("created_by_id")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  entries       LedgerEntry[]

  @@unique([businessId, externalRef])
  @@index([businessId, date])
  @@index([businessId, sourceType, sourceId])
  @@index([businessId, type])
  @@index([businessId, contactId])
  @@map("financial_transactions")
}

/// Append-only double-entry ledger row. Every monetary movement is at least
/// two entries summing to zero (debits == credits) on the parent
/// FinancialTransaction. Locked entries (post-reconciliation) cannot be
/// reversed without admin override (FIN6 enforces).
model LedgerEntry {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  transactionId String   @map("transaction_id")
  /// Restrict (NoAction) — ledger rows are append-only. Deleting a
  /// FinancialTransaction must be blocked at the DB level so reversals
  /// stay the only path to "undo" a posting.
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// ChartOfAccount this entry posts against (e.g. Cash, AR, Revenue).
  accountId     String   @map("account_id")
  account       ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  debit         Decimal  @default(0) @db.Decimal(18, 4)
  credit        Decimal  @default(0) @db.Decimal(18, 4)
  currency      String   @default("TTD")
  date          DateTime
  memo          String?

  /// Set by FIN6 reconciliation completion; locked entries reject reversal
  /// from PostingService unless admin-overridden.
  lockedByReconciliationId String? @map("locked_by_reconciliation_id")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([businessId, date])
  @@index([businessId, accountId, date])
  @@index([transactionId])
  @@index([lockedByReconciliationId])
  @@map("ledger_entries")
}

/// Imported bank statement row (CSV upload in FIN6). Auto-matched against
/// system payments/expenses; status flows UNMATCHED -> MATCHED -> IGNORED.
model BankTransaction {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  accountId   String   @map("account_id")
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  amount      Decimal  @db.Decimal(18, 4)
  currency    String   @default("TTD")
  reference   String?

  matchedTransactionId String? @map("matched_transaction_id")
  status      String   @default("UNMATCHED") // UNMATCHED, MATCHED, IGNORED
  rawData     Json?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([businessId, accountId, date])
  @@index([businessId, status])
  @@index([businessId, accountId, status])
  @@map("bank_transactions")
}

/// Bank-statement reconciliation session. On completion, all in-period
/// LedgerEntry rows on the account are stamped with this row's id and
/// become locked.
model Reconciliation {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  accountId       String   @map("account_id")
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  statementBalance Decimal  @db.Decimal(18, 4) @map("statement_balance")
  systemBalance    Decimal  @db.Decimal(18, 4) @map("system_balance")
  difference       Decimal  @db.Decimal(18, 4)

  status          String   @default("OPEN") // OPEN, RECONCILED, NEEDS_REVIEW
  notes           String?

  completedAt     DateTime? @map("completed_at")
  completedById   String?   @map("completed_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  @@index([businessId, accountId, periodEnd])
  @@index([businessId, status])
  @@map("reconciliations")
}

/// Per-period tax rollup (VAT, sales tax, business levy, withholding).
/// FIN7 fills these via TaxLiabilityRollupScheduler.
model TaxLiability {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type         String   // VAT, SALES_TAX, WITHHOLDING, BUSINESS_LEVY, OTHER
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  taxableSales Decimal  @default(0) @db.Decimal(18, 4) @map("taxable_sales")
  taxCollected Decimal  @default(0) @db.Decimal(18, 4) @map("tax_collected")
  taxPaid      Decimal  @default(0) @db.Decimal(18, 4) @map("tax_paid")
  amountDue    Decimal  @default(0) @db.Decimal(18, 4) @map("amount_due")
  dueDate      DateTime? @map("due_date")
  status       String   @default("OPEN") // OPEN, FILED, PAID, AMENDED
  notes        String?

  /// Explicit amendment lineage — set on rows produced by recompute()
  /// against a FILED/PAID period. The original row is never mutated.
  amendsTaxLiabilityId String? @map("amends_tax_liability_id")
  amends               TaxLiability?  @relation("TaxLiabilityAmendments", fields: [amendsTaxLiabilityId], references: [id], onDelete: SetNull)
  amendments           TaxLiability[] @relation("TaxLiabilityAmendments")
  /// Monotonic version per (businessId, type, period). 1 = original.
  version              Int     @default(1)
  isAmendment          Boolean @default(false) @map("is_amendment")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@index([businessId, status])
  @@index([businessId, type, periodEnd])
  @@index([amendsTaxLiabilityId])
  @@map("tax_liabilities")
}

/// Per-business tax rate (FIN5). Used as a picker source on invoices/quotes
/// and as the default applied when none is selected. One rate per
/// (businessId, name); multiple rates may exist (e.g. VAT 12.5%, Zero 0%).
model TaxRate {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  rate        Decimal  @db.Decimal(8, 4)
  /// Free-form e.g. "VAT", "Sales Tax". Optional.
  type        String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true)  @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  // FIN7 — Reverse relations for canonical FK support.
  invoices    Invoice[] @relation("InvoiceTaxRate")
  expenses    Expense[] @relation("ExpenseTaxRate")

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("tax_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance OS: Control Layer — Bank rules, recurring journals, credit notes,
// period close, bank feeds, FX, and fixed assets.
// ─────────────────────────────────────────────────────────────────────────────

/// User-defined pattern rules for auto-categorizing imported bank transactions.
/// When a bank row description/reference matches the pattern, the system can
/// auto-create a categorized ledger transaction or at least pre-fill the match.
model BankRule {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name              String
  priority          Int      @default(0)
  pattern           String
  matchType         String   @default("contains") @map("match_type") // contains | starts_with | equals | regex
  accountId         String   @map("account_id")
  account           ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  expenseCategoryId String?  @map("expense_category_id")
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, priority])
  @@map("bank_rules")
}

/// Scheduled double-entry journal entries that emit on a recurring cadence.
/// Mirrors the RecurringExpense scheduler pattern but posts directly via
/// PostingService with type = ADJUSTMENT.
model RecurringJournalEntry {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  frequency   String   // WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | YEARLY
  nextRunDate DateTime @map("next_run_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")

  /// Array of { accountId, debit?, credit?, memo? } — validated by service layer.
  entries     Json

  runCount        Int      @default(0) @map("run_count")
  failureCount    Int      @default(0) @map("failure_count")
  lastError       String?  @map("last_error")
  lastRunDate     DateTime? @map("last_run_date")
  cancelledAt     DateTime? @map("cancelled_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, nextRunDate])
  @@map("recurring_journal_entries")
}

/// Formal credit memo against an invoice. Issuing a credit note reduces the
/// invoice balance and posts a reversal journal via PostingService.
model CreditNote {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoiceId         String   @map("invoice_id")
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  creditNoteNumber  String   @map("credit_note_number")
  status            String   @default("DRAFT") // DRAFT | ISSUED | APPLIED | VOID
  amount            Decimal  @db.Decimal(18, 4)
  reason            String?
  items             Json?
  appliedAt         DateTime? @map("applied_at")
  voidedAt          DateTime? @map("voided_at")

  /// Link to the reversal journal transaction created on issue.
  reversalTransactionId String? @map("reversal_transaction_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, creditNoteNumber])
  @@index([businessId])
  @@index([businessId, invoiceId])
  @@index([businessId, status])
  @@map("credit_notes")
}

/// Formal accounting period (month/year bucket). Closing a period stamps all
/// in-period FinancialTransaction rows and prevents back-dated edits unless
/// an admin reopens it.
model AccountingPeriod {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  year          Int
  month         Int      // 1-12
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("OPEN") // OPEN | CLOSED
  closedAt      DateTime? @map("closed_at")
  closedById    String?  @map("closed_by_id")

  /// Set on all FinancialTransaction rows whose date falls inside the period
  /// when the period is closed. Used to enforce the lock.
  lockedTransactionStamp String? @map("locked_transaction_stamp")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, year, month])
  @@index([businessId, status])
  @@map("accounting_periods")
}

/// Live bank feed connection metadata (Plaid, Yodlee, etc.).
model BankConnection {
  id                  String   @id @default(cuid())
  businessId          String   @map("business_id")
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  financialAccountId  String   @map("financial_account_id")
  financialAccount    FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  provider            String   // plaid | yodlee | salt_edge | open_banking
  providerItemId      String?  @map("provider_item_id")
  accessToken         String?  @map("access_token")
  status              String   @default("ACTIVE") // ACTIVE | ERROR | EXPIRED | DISCONNECTED
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncCursor      String?  @map("last_sync_cursor")
  errorMessage        String?  @map("error_message")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, financialAccountId])
  @@map("bank_connections")
}

/// Daily exchange rate snapshot for multi-currency revaluation.
model ExchangeRate {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fromCurrency String  @map("from_currency")
  toCurrency   String  @map("to_currency")
  rate         Decimal @db.Decimal(18, 8)
  date         DateTime @db.Date
  source       String? // ecb | xe | manual

  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([businessId, fromCurrency, toCurrency, date])
  @@index([businessId, fromCurrency, toCurrency])
  @@map("exchange_rates")
}

/// Fixed asset register with depreciation tracking.
model FixedAsset {
  id                     String   @id @default(cuid())
  businessId             String   @map("business_id")
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name                   String
  category               String   // equipment | vehicle | property | furniture | technology
  purchaseDate           DateTime @map("purchase_date")
  purchaseCost           Decimal  @db.Decimal(18, 4) @map("purchase_cost")
  salvageValue           Decimal? @db.Decimal(18, 4) @map("salvage_value")
  usefulLifeMonths       Int      @map("useful_life_months")
  depreciationMethod     String   @default("straight_line") @map("depreciation_method") // straight_line | reducing_balance

  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 4) @map("accumulated_depreciation")
  netBookValue           Decimal  @db.Decimal(18, 4) @map("net_book_value")

  disposalDate           DateTime? @map("disposal_date")
  disposalProceeds       Decimal?  @db.Decimal(18, 4) @map("disposal_proceeds")
  status                 String   @default("ACTIVE") // ACTIVE | FULLY_DEPRECIATED | DISPOSED

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, status])
  @@map("fixed_assets")
}

