/// R3: Revenue Action Queue. Each row is an actionable card surfaced in the
/// Revenue → Actions tab. Generated by `RevenueActionService` from canonical
/// commerce events (invoice.overdue, quote.stale, quote.accepted,
/// invoice.paid, payment.failed) and a 5-minute reconciliation scheduler.
model RevenueAction {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId     String?  @map("contact_id")

  /// One of: OVERDUE_INVOICE | STALE_QUOTE | ACCEPTED_QUOTE_NO_INVOICE
  ///         | PAID_INVOICE_NO_RECEIPT | RECURRING_FAILURE | DORMANT_HIGH_VALUE
  type          String
  title         String
  detail        String?
  /// 1 = high, 2 = medium, 3 = low. Lower number = higher urgency.
  priority      Int      @default(2)
  /// PENDING | COMPLETED | DISMISSED | SNOOZED
  status        String   @default("PENDING")
  dueAt         DateTime? @map("due_at")
  /// When status = SNOOZED, the action stays hidden until this timestamp.
  snoozedUntil  DateTime? @map("snoozed_until")

  /// Polymorphic link back to the source object the action is about.
  /// e.g. relatedType="invoice", relatedId="<invoice cuid>".
  relatedType   String?  @map("related_type")
  relatedId     String?  @map("related_id")

  /// Currency-agnostic numeric "money on the table" attached to this action.
  /// e.g. invoice total for OVERDUE_INVOICE, quote total for STALE_QUOTE,
  /// recent revenue for DORMANT_HIGH_VALUE.
  amountAtRisk  Float?   @map("amount_at_risk")

  /// AI-drafted (with template fallback) explanation + prefilled draft.
  /// Shape: { explanation: string, suggestedAction: string, draft?: { subject?, body? }, source: 'ai' | 'template' }
  recommendation Json?   @map("recommendation")

  completedAt   DateTime? @map("completed_at")
  resolvedBy    String?   @map("resolved_by")
  resolution    String?   // notes on dismiss/complete

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, type, relatedType, relatedId])
  @@index([businessId, status, priority])
  @@index([businessId, type, status])
  @@index([businessId, contactId])
  @@map("revenue_actions")
}

/// Universal Command Queue — OS-1
/// Consolidated execution queue for business actions across all modules.
model CommandItem {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceModule      String   @map("source_module")
  sourceType        String?  @map("source_type")
  sourceId          String?  @map("source_id")
  title             String
  description       String?
  /// MONEY | TIME | PEOPLE | WORK | SALES | MARKETING | GOVERNANCE | STRATEGY | SYSTEM
  category          String
