model Subscription {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan     String             @default("FREE") // FREE, FLOW, KEYFLOW
  status   SubscriptionStatus @default(ACTIVE) // ACTIVE, TRIALING, PAST_DUE, CANCELLED, EXPIRED
  currency String             @default("TTD") // TTD or USD

  priceMonthly       Float     @default(0) @map("price_monthly")
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelledAt        DateTime? @map("cancelled_at")

  // Payment gateway info
  gateway           String? // wipay, paypal
  gatewaySubId      String? @map("gateway_sub_id")
  gatewayCustomerId String? @map("gateway_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments SubscriptionPayment[]

  @@index([businessId, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  businessId     String       @map("business_id")

  amount       Float
  currency     String                    @default("TTD")
  method       String // wipay, paypal, bank_transfer, cash, manual
  status       SubscriptionPaymentStatus @default(COMPLETED) // COMPLETED, PENDING, FAILED
  reference    String?
  notes        String?
  gateway      String?
  gatewayTxnId String?                   @map("gateway_txn_id")

  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@index([subscriptionId])
  @@map("subscription_payments")
}

model AiUsageLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")

  feature          String
  model            String  @default("gpt-5.2")
  provider         String  @default("openai")
  promptTokens     Int     @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  totalTokens      Int     @default(0) @map("total_tokens")
  estimatedCost    Float   @default(0) @map("estimated_cost")
  creditsUsed      Int     @default(1) @map("credits_used")
  latencyMs        Int?    @map("latency_ms")
  fallbackUsed     Boolean @default(false) @map("fallback_used")
  fallbackProvider String? @map("fallback_provider")
  errorCode        String? @map("error_code")
  taskCategory     String? @map("task_category")

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, feature])
  @@index([businessId, provider])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model AiUsageAlert {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  type        String
  threshold   Int?
  triggeredAt DateTime @default(now()) @map("triggered_at")
  notified    Boolean  @default(false)
  metadata    Json?

  @@index([businessId, type])
  @@index([notified, triggeredAt])
  @@map("ai_usage_alerts")
}

// ---
// MODULE 9: EXPENSE TRACKING (ProfitLens)
// ---
model ExpenseCategory {
  id                String             @id @default(cuid())
  name              String
  icon              String?
  color             String?
  businessId        String             @map("business_id")
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgets           ExpenseBudget[]
  recurringExpenses RecurringExpense[]
  bankRules         BankRule[]

  // FIN1: link expense categories to a Chart of Account row so reports can
  // group spend by COA bucket. Nullable until FIN3 backfills the mapping.
  chartOfAccountId String?         @map("chart_of_account_id")
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")