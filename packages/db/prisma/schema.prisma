/// Commercial Document Templates (INVOICE | QUOTE | RECEIPT)
/// Full branding customization with live preview support.
model CommercialDocumentTemplate {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type        String   // INVOICE | QUOTE | RECEIPT
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  /// { layout, colors, fonts, logo, header, footer, items, meta }
  config      Json     @default("{}")
  previewData Json?    @map("preview_data")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([businessId, type, name])
  @@index([businessId, type])
  @@map("commercial_document_templates")
}

/// KEY Command — every user interaction with the AI orchestrator.
/// Tracks intent, grounding, planning, risk, approval, and execution.
model KeyCommand {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id")

  rawInput    String   @map("raw_input")
  inputMode   String   @default("TEXT") @map("input_mode") // TEXT | VOICE
  /// { domain, action, entities, filters, timeframe, modifiers }
  intent      Json     @default("{}")
  /// Relevant business data fetched during grounding step
  groundedData Json?   @map("grounded_data")
  planSummary String?  @map("plan_summary")

  status      String   @default("RECEIVED") // RECEIVED | PLANNED | APPROVED | EXECUTED | FAILED | REJECTED
  riskLevel   String   @default("LOW") @map("risk_level") // LOW | MEDIUM | HIGH | CRITICAL
  autonomyLevel Int    @default(0) @map("autonomy_level") // 0-4
  mode        String   @default("do") @map("mode") // ask | do | plan | auto

  /// { success, outputs, errors, durationMs }
  executionResult Json? @map("execution_result")
  /// Step-by-step execution trace
  executionLogs Json?   @map("execution_logs")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId, status, createdAt])
  @@index([businessId, userId, createdAt])
  @@map("key_commands")
}

/// Procurement Request — AI-guided service package generation.
/// User describes a need in plain language; KEY generates packages and a brief.
model ProcurementRequest {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId String? @map("requested_by_user_id")

  status      String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | PO_ISSUED | VENDOR_ACKNOWLEDGED | FULFILLED | INVOICED | COMPLETED
  userPrompt  String   @map("user_prompt")
  /// AI-extracted structured need { category, urgency, scope, constraints }
  interpretedNeed Json  @default("{}") @map("interpreted_need")
  /// Generated package options [{ name, description, estimatedCost, timeline, deliverables }]
  recommendedPackages Json @default("{}") @map("recommended_packages")
  /// Compiled internal brief for owner review
  brief       Json     @default("{}")
  estimatedBudget Json? @map("estimated_budget")
  priority    String?
  internalNotes String? @map("internal_notes")

  supplierConnectionId String? @map("supplier_connection_id")
  purchaseOrderId      String? @map("purchase_order_id")
  poIssuedAt           DateTime? @map("po_issued_at")
  vendorAcknowledgedAt DateTime? @map("vendor_acknowledged_at")
  fulfilledAt          DateTime? @map("fulfilled_at")
  invoicedAt           DateTime? @map("invoiced_at")

  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, supplierConnectionId])
  @@map("procurement_requests")
}


// ---
// PHASE 0: OPERATING KERNEL — Business Event Log, Evidence, Assignment, Content, Calls, Approvals, Assets
// ---

/// Unified business event log. Every important mutation creates a BusinessEvent.
/// This replaces fragmented audit tables (TeamActivityLog, ContactAuditEntry, etc.)
model BusinessEvent {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId    String?  @map("branch_id")
  eventType   String   @map("event_type")
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  actorType   String   @map("actor_type") // "human" | "ai" | "system" | "integration"
  actorId     String   @map("actor_id")
  action      String   // "create", "update", "delete", "approve", "execute", "complete"
  before      Json?    // snapshot before mutation
  after       Json?    // snapshot after mutation
  evidenceIds String[] @map("evidence_ids")
  messageIds  String[] @map("message_ids")
  approvalId  String?  @map("approval_id")
  riskScore   Int?     @map("risk_score")
  source      String   // "web" | "mobile" | "email" | "whatsapp" | "api" | "worker" | "ai"
  metadata    Json?    // extensible context

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, eventType])
  @@index([subjectType, subjectId])
  @@index([actorType, actorId])
  @@index([businessId, eventType, createdAt])
  @@map("business_events")
}

/// Evidence / proof attached to tasks, approvals, contacts, or work orders.
/// Golden Rule: no completion without evidence when evidence is required.
model Evidence {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  evidenceType String   @map("evidence_type") // "photo", "file", "signature", "checklist", "message", "note", "document"
  url          String
  storageKey   String   @map("storage_key") // S3 key or Drive file ID
  checksum     String?  // SHA-256 for integrity verification
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  submittedBy  String   @map("submitted_by") // userId or "key_ai"
  submittedAt  DateTime @default(now()) @map("submitted_at")
  verifiedBy   String?  @map("verified_by")
  verifiedAt   DateTime? @map("verified_at")
  linkedType   String   @map("linked_type") // "Task", "ApprovalRequest", "Contact", "WorkOrder", "CallLog"
  linkedId     String   @map("linked_id")
  metadata     Json?    // e.g., GPS coords, timestamp, device info

  @@index([businessId, linkedType, linkedId])
  @@index([businessId, evidenceType])
  @@index([businessId, submittedAt])
  @@map("evidence")
}

/// Polymorphic task assignment junction table.
/// Replaces loose assigneeId strings on ContactTask and ProjectTask.
model TaskAssignment {
  id             String   @id @default(cuid())
  taskType       String   @map("task_type") // "ContactTask" | "ProjectTask" | "AutopilotTask"
  taskId         String   @map("task_id")
  assignableType String   @map("assignable_type") // "User" | "StaffMember" | "Contractor" | "KeyflowStaff" | "KEY"
  assignableId   String   @map("assignable_id")
  assignedBy     String   @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at")
  unassignedAt   DateTime? @map("unassigned_at")
  reason         String?

  @@unique([taskType, taskId, assignableType, assignableId])
  @@index([taskType, taskId])
  @@index([assignableType, assignableId])
  @@index([assignedBy])
  @@map("task_assignments")
}

/// Content request / work order for content operations.
/// Need -> Request -> Brief -> Assignment -> Production -> QA -> Approval -> Drive Upload -> Delivery
model ContentRequest {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  requestedBy       String   @map("requested_by") // userId or "key_ai"
  source            String   // "user_request" | "key_recommendation" | "campaign_calendar" | "sales_signal" | "inventory_signal" | "customer_signal"
  status            String   @default("draft")
  // DRAFT -> SUBMITTED -> ASSIGNED -> IN_PRODUCTION -> INTERNAL_REVIEW -> USER_REVIEW -> APPROVED -> UPLOADED_TO_DRIVE -> DELIVERED

  contentTypes      String[] @map("content_types") // "blog_post", "social_post", "email", "video_script", "flyer", "whitepaper"
  businessGoal      String   @map("business_goal")
  targetAudience    String?  @map("target_audience")
  offer             String?
  productOrService  String?  @map("product_or_service")
  branch            String?
  tone              String?
  dueDate           DateTime? @map("due_date")
  priority          String   @default("normal")
  requiredInputs    String[] @map("required_inputs")
  attachedAssetIds  String[] @map("attached_asset_ids")
  assignedTeamMemberIds String[] @map("assigned_team_member_ids")
  googleDriveFolderId String? @map("google_drive_folder_id")
  deliveryFileIds   String[] @map("delivery_file_ids")
  approvalRequired  Boolean  @default(true) @map("approval_required")
  approvedBy        String?  @map("approved_by")

  // L4 Manager — workload estimation
  estimatedHours    Float?   @map("estimated_hours")

  invoiceOnDelivery Boolean  @default(false) @map("invoice_on_delivery")
  invoiceId         String?  @unique @map("invoice_id")
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([businessId, priority])
  @@map("content_requests")
}

/// Content delivery package — tracks final files uploaded to Google Drive.
model ContentDeliveryPackage {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contentRequestId  String   @map("content_request_id")
  destinationType   String   @default("google_drive") @map("destination_type")
  destinationFolderId String @map("destination_folder_id")
  status            String   @default("pending") // pending | uploading | uploaded | failed | delivered
  uploadedBy        String   @map("uploaded_by") // "system" | "keyflow_staff"
  uploadedFileIds   String[] @map("uploaded_file_ids")
  userNotified      Boolean  @default(false) @map("user_notified")
  deliveredAt       DateTime? @map("delivered_at")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([businessId, contentRequestId])
  @@index([businessId, status])
  @@map("content_delivery_packages")
}

/// Manual call task logging. Tracks phone follow-ups with outcomes.
model CallLog {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contactId      String?  @map("contact_id")
  taskId         String?  @map("task_id") // linked ContactTask
  callerId       String   @map("caller_id") // userId or staffMemberId
  scheduledAt    DateTime? @map("scheduled_at")
  completedAt    DateTime? @map("completed_at")
  duration       Int?     // seconds
  outcome        String?  // "reached" | "no_answer" | "voicemail" | "wrong_number" | "callback_requested" | "not_interested"
  notes          String?
  script         String?  // talking points used
  recordingUrl   String?  @map("recording_url")
  evidenceIds    String[] @map("evidence_ids")
  followUpTaskId String?  @map("follow_up_task_id")

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([businessId, contactId])
  @@index([businessId, callerId])
  @@index([businessId, scheduledAt])
  @@index([businessId, outcome])
  @@map("call_logs")
}

/// General approval request for business processes (expense, PO, discount, content delivery).
/// Extends beyond AI-centric AiApprovalItem.
model ApprovalRequest {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  requestType String   @map("request_type") // "quote_discount" | "expense" | "content_delivery" | "refund" | "po" | "time_off"
  requesterId String   @map("requester_id")
  title       String
  description String?
  payload     Json     // the actual data being approved (e.g., quote object, expense details)
  status      String   @default("pending") // pending | approved | rejected | escalated | delegated
  threshold   Float?   // auto-approve under this amount
  currentStep Int      @default(0) @map("current_step")

  createdAt   DateTime @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolution  String?  // "approved" | "rejected" | "escalated"

  steps       ApprovalStep[]

  @@index([businessId, status])
  @@index([businessId, requestType])
  @@index([businessId, requesterId])
  @@map("approval_requests")
}

/// Approval step in a multi-step approval chain.
model ApprovalStep {
  id                String  @id @default(cuid())
  approvalRequestId String  @map("approval_request_id")
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  stepOrder     Int      @map("step_order")
  approverId    String   @map("approver_id")
  status        String   @default("pending") // pending | approved | rejected | delegated
  delegatedTo   String?  @map("delegated_to")
  decidedAt     DateTime? @map("decided_at")
  decision      String?  // "approved" | "rejected"
  comment       String?

  @@index([approvalRequestId, stepOrder])
  @@map("approval_steps")
}

/// Asset / media library for creative files and general uploads.
