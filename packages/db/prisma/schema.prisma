  downloaderBusinessId String  @map("downloader_business_id")
  downloader          Business @relation("ResourceDownloader", fields: [downloaderBusinessId], references: [id], onDelete: Cascade)

  pricePaid           Float    @default(0) @map("price_paid")
  currency            String   @default("TTD")
  source              String?                                  // marketplace, profile, opportunity

  createdAt           DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([downloaderBusinessId, createdAt])
  @@map("community_resource_downloads")
}

model AiSuggestionEvent {
  id               String   @id @default(cuid())
  businessId       String   @map("business_id")
  business         Business @relation("AiSuggestionEventFrom", fields: [businessId], references: [id], onDelete: Cascade)
  targetBusinessId String?  @map("target_business_id")
  targetBusiness   Business? @relation("AiSuggestionEventTo", fields: [targetBusinessId], references: [id], onDelete: SetNull)

  // Event type. One of:
  // SUGGESTION_CLICKED, INTRO_DRAFT_GENERATED, INTRO_DRAFT_USED,
  // MESSAGE_SENT, CONNECTION_MADE, QUOTE_REQUESTED, COLLAB_CREATED, DEAL_WON
  eventType String  @map("event_type")
  // Where the suggestion came from.
  // recommendations | relationship_insights | need_match | quote_request_modal | message_modal | send_message_modal
  source    String
  score     Int?
  matchType String? @map("match_type")
  metadata  Json?   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, eventType])
  @@index([businessId, source])
  @@index([targetBusinessId])
  @@map("ai_suggestion_events")
}

