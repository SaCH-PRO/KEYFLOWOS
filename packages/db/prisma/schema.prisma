/// Links a won Deal back to a sequence enrollment when the deal is won
/// within the per-business attribution window after enrollment start.
/// Populated by the sequence-attribution listener on `deal.won` events.
model SequenceAttribution {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  sequenceId      String   @map("sequence_id")
  enrollmentId    String   @map("enrollment_id")
  dealId          String   @map("deal_id")
  contactId       String   @map("contact_id")
  attributedValue Decimal? @db.Decimal(12, 2) @map("attributed_value")
  currency        String?
  wonAt           DateTime @map("won_at")
  enrolledAt      DateTime @map("enrolled_at")
  windowDays      Int      @map("window_days")
  createdAt       DateTime @default(now()) @map("created_at")

  enrollment CrmSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([dealId])
  @@index([businessId, sequenceId])
  @@index([businessId, wonAt])
  @@map("sequence_attributions")
}

