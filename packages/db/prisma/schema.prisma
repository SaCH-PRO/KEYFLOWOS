// ---
// SMART PROJECT PLANNER: bridges AI plan drafts to real projects
// ---

model ProjectPlan {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Link to the AI-generated draft plan
  aiPlanId String? @unique @map("ai_plan_id")
  aiPlan   AiPlan? @relation(fields: [aiPlanId], references: [id], onDelete: SetNull)

  // Link to goal that inspired this plan
  goalId String?       @map("goal_id")
  goal   BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Once approved, materializes into a Project
  projectId String?  @unique @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status          String  @default("draft") // draft | reviewing | approved | materialized | rejected
  userIdea        String  @map("user_idea") // Original user input
  strategySummary String? @map("strategy_summary") // Key's strategic rationale

  // Resource estimates (AI-generated, user-adjustable)
  estimatedTotalHours   Float? @map("estimated_total_hours")
  estimatedBudget       Float? @map("estimated_budget")
  estimatedPeople       Int?   @map("estimated_people")
  estimatedDurationDays Int?   @map("estimated_duration_days")

  // Risk & impact analysis (stored as JSON for flexibility)
  riskAnalysis Json? @map("risk_analysis") // { risks[], mitigation[], overallRiskScore }
  swotAnalysis Json? @map("swot_analysis") // { strengths[], weaknesses[], opportunities[], threats[] }

  // Timeline events (tasks + milestones in sequence)
  timelineEvents ProjectPlanEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("project_plans")
}

model ProjectPlanEvent {
  id     String      @id @default(cuid())
  planId String      @map("plan_id")
  plan   ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Event sequencing
  sortOrder Int @default(0) @map("sort_order")

  // Event classification
  eventType String @map("event_type") // task | milestone | decision_gate | review

  // Content
  title       String
  description String?

  // Execution context
  executionContext String @map("execution_context") // IN_APP | OUT_APP

  // For IN_APP: which tool to use
  automationTool   String? @map("automation_tool") // e.g., "commerce_create_quote", "crm_search_contacts"
  toolPayload      Json?   @map("tool_payload") // Pre-filled tool arguments
  autoExecute      Boolean @default(false) @map("auto_execute") // Whether to auto-run once permitted
  requiresApproval Boolean @default(false) @map("requires_approval") // From governance tier

  // For OUT_APP: manual instructions
  manualInstructions     String? @map("manual_instructions")
  manualEvidenceRequired Boolean @default(false) @map("manual_evidence_required")

  // Scheduling
  estimatedHours Float?    @map("estimated_hours")
  estimatedStart DateTime? @map("estimated_start")
  estimatedEnd   DateTime? @map("estimated_end")

  // Dependencies (stored as array of event IDs)
  dependsOn String[] @default([]) @map("depends_on")

  // Resource estimates
  requiredRoles String[] @default([]) @map("required_roles") // e.g., ["designer", "developer"]
  estimatedCost Float?   @map("estimated_cost")

  // Once materialized, links to real entities
  projectTaskId      String? @map("project_task_id")
  projectMilestoneId String? @map("project_milestone_id")

  // Status tracking
  status String @default("pending") // pending | in_progress | completed | skipped | blocked

  // Impact analysis cache (populated when rearranged)
  impactAnalysis Json? @map("impact_analysis") // { effortDelta, timeDelta, costDelta, riskDelta, pros[], cons[] }

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([planId, sortOrder])
  @@index([planId, status])
  @@map("project_plan_events")
}

