model Activity {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  module     String // "crm", "commerce", "bookings", "social", "automation"
  action     String // "created", "updated", "paid", "published", "executed"
  entityType String  @map("entity_type") // "contact", "invoice", "booking", "post", "playbook"
  entityId   String? @map("entity_id")
  title      String
  detail     String?
  icon       String?
  tone       String? // "success", "info", "warning", "danger"
  data       Json?
  contactId  String? @map("contact_id")

  // Business Event Ledger extensions (Phase 1 MD)
  category      String? // CONTACT | COMMERCE | BOOKING | PAYMENT | AI | SYSTEM | STORE | TASK
  actorType     String?   @map("actor_type") // USER | AI | CUSTOMER | SYSTEM
  actorId       String?   @map("actor_id")
  status        String? // SCHEDULED | COMPLETED | CANCELLED | FAILED | PENDING
  priority      String? // LOW | NORMAL | HIGH | URGENT
  revenueImpact Float?    @map("revenue_impact")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  occurredAt    DateTime  @default(now()) @map("occurred_at")
