  actor           Business @relation("NetworkActivityActor", fields: [actorBusinessId], references: [id], onDelete: Cascade)

  type            String                                   // OPPORTUNITY_POSTED, OPPORTUNITY_AWARDED, PARTNERSHIP_FORMED,
                                                           // RESOURCE_PUBLISHED, REVIEW_RECEIVED, MILESTONE_REACHED, COHORT_JOINED,
                                                           // BUSINESS_VERIFIED, ENDORSEMENT_RECEIVED
  refType         String?  @map("ref_type")                // opportunity, partner_program, product, review, ...
  refId           String?  @map("ref_id")
  title           String
  body            String?
  metadata        Json?
  visibility      String   @default("PUBLIC")              // PUBLIC, FOLLOWERS, PRIVATE

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([actorBusinessId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("community_network_activities")
}

model ResourceDownload {
