model ConversationAIInsight {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  contactId  String @map("contact_id")

  // 'thread_summary' | 'message_analysis'
  kind String

  // For message_analysis: source message id like 'wa:<id>' or 'event:<id>'.
  // For thread_summary: null.
  messageRef String? @map("message_ref")

  // SHA256 of the inputs used to compute this insight; allows skipping
  // recomputation when the underlying thread hasn't changed.
  hash String

  // Normalized signals surfaced in UI.
  sentiment String? // 'positive' | 'neutral' | 'negative' | 'mixed'
  intent    String? // free-form short label e.g. 'pricing_question', 'booking_request'
  summary   String? // short one-liner

  // Full structured payload returned by the model (suggestions, reasons, scores, etc.)
  payload Json?

  modelUsed String? @map("model_used")
  feature   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, contactId, kind, messageRef])
  @@index([businessId, contactId, kind])
  @@index([businessId, contactId, createdAt])
  @@index([businessId, hash])
  @@map("conversation_ai_insights")
}

/// Cached AI-generated insight card for a contact. One snapshot per contact;
/// recomputed in background when relationship-changing events fire.
model ContactInsightSnapshot {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  contactId  String @unique @map("contact_id")

  /// Schema version for the payload shape so older cached rows can be evicted.
  version Int @default(1)

  /// Full snapshot payload (relationship summary, channels, topics, lifetime value,
  /// open deals, churn risk, suggested next action, etc.). See ContactInsightService
  /// for the typed shape.
  payload Json

  /// True when an event has invalidated this snapshot and a recompute is pending.
  stale Boolean @default(false)

  modelUsed String? @map("model_used")

  computedAt DateTime @default(now()) @map("computed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, stale])
  @@index([businessId, computedAt])
  @@map("contact_insight_snapshots")
}

