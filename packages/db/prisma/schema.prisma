generator client {
  provider = "prisma-client-js"
}

// This is your datasource, pointing to your Supabase Postgres DB
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---
// MODULE 1: IDENTITY & ACCOUNTS
// ---
model User {
  id        String  @id @default(cuid()) // Corresponds to Supabase auth.users.id
  email     String  @unique
  name      String?
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")
  role      String  @default("USER") // USER | SUPER_ADMIN
  referralCode String? @unique @map("referral_code")
  referredByUserId String? @map("referred_by_user_id")
  referredBy    User?   @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referralsMade User[]  @relation("UserReferrals")

  businesses Membership[]
  sessions   Session[]

  aiExecutionLogs    AiExecutionLog[]    @relation("UserAiExecutionLogs")
  aiApprovalItems    AiApprovalItem[]    @relation("UserAiApprovalItems")
  aiApprovalResolutions AiApprovalItem[] @relation("UserAiApprovalResolutions")
  aiPlans            AiPlan[]            @relation("UserAiPlans")
  contactShares      ContactShare[]      @relation("UserContactShares")
  assignedTickets    SupportTicket[]
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model Business {
  id       String  @id @default(cuid())
  name     String
  ownerId  String  @map("owner_id")
  slug     String? @unique
  timezone String  @default("America/Port_of_Spain")
  currency String  @default("TTD")

  // Business Profile
  logoUrl      String?  @map("logo_url")
  tagline      String?
  description  String?
  address      String?
  city         String?
  country      String?
  phone        String?
  email        String?
  website      String?

  // Social Handles
  facebook     String?
  instagram    String?
  twitter      String?
  linkedin     String?
  tiktok       String?
  youtube      String?
  whatsapp     String?

  // Community Profile
  headline          String?
  bio               String?
  skills            String[] @default([])
  businessStage     String?  @map("business_stage")       // IDEA, STARTUP, GROWTH, ESTABLISHED, SCALING
  interests         String[] @default([])

  // Transactional Presence
  acceptingWork          Boolean  @default(true) @map("accepting_work")
  currentCapacity        String?  @map("current_capacity")        // OPEN, LIMITED, FULL
  leadTime               String?  @map("lead_time")
  preferredProjectTypes  String[] @default([]) @map("preferred_project_types")
  budgetFit              String?  @map("budget_fit")
  positioningStatement   String?  @map("positioning_statement")
  profileCompleteness Int    @default(0) @map("profile_completeness")

  // Brand Settings
  primaryColor   String?  @default("#F97316") @map("primary_color")
  secondaryColor String?  @default("#14B8A6") @map("secondary_color")
  defaultTaxRate Float?   @default(0) @map("default_tax_rate")
  invoiceTemplate String? @default("classic") @map("invoice_template")
  quoteTemplate   String? @default("classic") @map("quote_template")

  /// FIN2: cash- vs accrual-basis accounting. MVP defaults to CASH per
  /// audit Phase 1; FIN5 settings UI flips this. See RevenuePostingService
  /// for the per-event posting recipes that branch on this flag.
  accountingBasis String @default("CASH") @map("accounting_basis")

  /// Optional default recipient for the "Send to accountant" action on
  /// Reports / Tax. When set, the Accountant Export ZIP can be emailed
  /// directly via Resend without re-typing the address each time.
  accountantEmail String? @map("accountant_email")

  // Business Autopilot Settings
  businessIntent   String?  @map("business_intent")    // Free-text description of business idea
  archetype        String?  @map("archetype")          // LOCAL_SERVICE, DIGITAL_PRODUCT, AGENCY, CLINIC, ECOMMERCE
  industry         String?  @map("industry")           // Auto-inferred from intent
  revenueModel     String?  @map("revenue_model")      // SUBSCRIPTION, ONE_TIME, RETAINER, USAGE_BASED
  budgetRange      String?  @map("budget_range")       // LOW, MEDIUM, HIGH
  timeCommitment   String?  @map("time_commitment")    // MINIMAL, PART_TIME, FULL_TIME
  teamSize         String?  @map("team_size")          // SOLO, SMALL_TEAM, GROWING
  autopilotEnabled Boolean  @default(true) @map("autopilot_enabled")
  autopilotStage   String?  @map("autopilot_stage")    // SETUP, LAUNCHING, OPERATING, MAINTENANCE
  
  // Compliance & Health
  complianceStatus String?  @map("compliance_status")  // GREEN, YELLOW, RED
  complianceData   Json?    @map("compliance_data")    // { itemId: boolean, ... }
  lastHealthCheck  DateTime? @map("last_health_check")

  // CRM Relationship-Health thresholds (override defaults per business)
  // Shape: { hot, warm, cold, atRiskClientDays } in days
  crmHealthThresholds Json?  @map("crm_health_thresholds")

  // Sequence attribution window (days). Used to attribute won deals back to
  // sequence enrollments. Defaults to 14 days when null.
  crmAttributionWindowDays Int? @map("crm_attribution_window_days")

  // Module Relationships
  members          Membership[]
  contacts         Contact[]
  accounts         Account[]
  deals            Deal[]
  dealStages       DealStage[]
  wonLostReasons   WonLostReason[]
  invoices         Invoice[]
  quotes           Quote[]
  products         Product[]
  bookings         Booking[]
  contactEvents    ContactEvent[]
  publicVisitorEvents PublicVisitorEvent[]
  publicEvents        PublicEvent[]
  publicVisitors      PublicVisitor[]
  presenceDailyStats  PresenceDailyStat[]
  presenceInsightSnapshot PresenceInsightSnapshot?
  contactChannelStats ContactChannelStat[]
  contactNotes     ContactNote[]
  contactTasks     ContactTask[]
    contactImports   ContactImport[]
    contactMedia     ContactMedia[]
    playbooks        ContactPlaybook[]
  services         Service[]
  staff            StaffMember[]
  socialPosts      SocialPost[]
  socialConns      SocialConnection[]
  socialEngagements SocialEngagement[]
  automations      Automation[]
  projects         Project[]
  projectTasks     ProjectTask[]
  projectTemplates ProjectTemplate[]
  sites            Site[]
  autopilotTasks   AutopilotTask[]
  delegationLoops  DelegationLoop[]
  ingestionItems   IngestionItem[]
  delegationLoopRuns DelegationLoopRun[]
  notifications    Notification[]
  subscriptions    Subscription[]
  activities       Activity[]
  expenses         Expense[]
  expenseCategories ExpenseCategory[]
  expenseBudgets   ExpenseBudget[]
  recurringInvoices RecurringInvoice[]
  recurringExpenses RecurringExpense[]
  emailCampaigns   EmailCampaign[]
  emailContacts    EmailCampaignContact[]
  leadForms        LeadForm[]
  leadSubmissions  LeadFormSubmission[]
  googleFormMappings GoogleFormMapping[]
  businessTemplates BusinessTemplateUsage[]
  courses          Course[]
  courseEnrollments CourseEnrollment[]
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  cohorts          Cohort[]
  cohortMembers    CohortMember[]
  landingPages     LandingPage[]
  webhooks         Webhook[]
  aiUsageLogs      AiUsageLog[]
  marketplaceListings MarketplaceListing[]
  shippingZones    ShippingZone[]
  warehouses       Warehouse[]
  inventoryStocks  InventoryStock[]
  stockMovements   StockMovement[]
  shipments        Shipment[]
  customsDeclarations CustomsDeclaration[]
  preOrders        PreOrder[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  marketplaceOrders MarketplaceOrder[]
  fulfillmentRoutes FulfillmentRoute[]
  promoCodes       PromoCode[]
  crmSequences      CrmSequence[]
  crossModuleWorkflows CrossModuleWorkflow[]
  scheduledAgentJobs   ScheduledAgentJob[]
  customerNotificationLogs CustomerNotificationLog[]
  apiKeys              ApiKey[]
  guidanceProfile      BusinessGuidanceProfile?
  guidanceAssessments  GuidanceAssessment[]
  revenueActions       RevenueAction[]
  financeActionItems   FinanceActionItem[]
  supportTickets       SupportTicket[]
  orgUnits             OrgUnit[]
  jobRoles             JobRole[]
  orgAssignments       OrgAssignment[]
  delegationRules      DelegationRule[]
  businessRules        BusinessRule[]
  businessSignals      BusinessSignal[]
  healthSnapshots      BusinessHealthSnapshot[]

  // Finance OS (FIN1)
  financialAccounts     FinancialAccount[]
  chartOfAccounts       ChartOfAccount[]
  financialTransactions FinancialTransaction[]
  ledgerEntries         LedgerEntry[]
  bankTransactions      BankTransaction[]
  reconciliations       Reconciliation[]
  taxLiabilities        TaxLiability[]
  taxRates              TaxRate[]
  bankRules             BankRule[]
  recurringJournalEntries RecurringJournalEntry[]
  creditNotes           CreditNote[]
  accountingPeriods     AccountingPeriod[]
  bankConnections       BankConnection[]
  exchangeRates         ExchangeRate[]
  fixedAssets           FixedAsset[]
  deliveryNotes         DeliveryNote[]
  stockCounts           StockCount[]
  receipts              Receipt[]

  // Finance OS (FIN5) — settings stored on the business row.
  // (accountingBasis declared above as part of FIN2; FIN5 settings UI flips it.)
  /// Fiscal-year start month (1=Jan ... 12=Dec). Default 1.
  fiscalYearStartMonth  Int?     @default(1) @map("fiscal_year_start_month")
  /// Default FinancialAccount.id used when posting Cash movements.
  defaultCashAccountId  String?  @map("default_cash_account_id")
  /// Default FinancialAccount.id for Accounts Receivable target.
  defaultArAccountId    String?  @map("default_ar_account_id")
  /// Default FinancialAccount.id for Accounts Payable target.
  defaultApAccountId    String?  @map("default_ap_account_id")
  /// Default FinancialAccount.id for Tax Payable holding account.
  defaultTaxAccountId   String?  @map("default_tax_account_id")

  // Business Builder
  businessPlans        BusinessPlan[]

  // Document Engine
  profileVersions      BusinessProfileVersion[]
  documentInstances    DocumentInstance[]
  documentChangeLogs   DocumentChangeLog[]
  orgStandards         OrgStandard[]
  reviewTasks          ReviewTask[]

  // AI Output Templates
  outputTemplates      OutputTemplate[]

  // Intake Submissions
  intakeSubmissions    IntakeSubmission[]

  // Qualification Journeys
  qualificationJourneys QualificationJourney[]

  // Storefront → Revenue (S2)
  revenueAttributions       RevenueAttribution[]
  storefrontConversionDays  StorefrontConversionDaily[]

  // Community Relationships & Transactions
  sentQuoteRequests       CommunityQuoteRequest[] @relation("SentQuoteRequests")
  receivedQuoteRequests   CommunityQuoteRequest[] @relation("ReceivedQuoteRequests")
  sentReferrals           CommunityReferral[]     @relation("SentReferrals")
  receivedReferrals       CommunityReferral[]     @relation("ReceivedReferrals")
  sentCollaborations      CommunityCollaboration[] @relation("SentCollaborations")
  receivedCollaborations  CommunityCollaboration[] @relation("ReceivedCollaborations")
  sentMessages            BusinessMessage[]       @relation("SentMessages")
  receivedMessages        BusinessMessage[]       @relation("ReceivedMessages")
  savedByOthers           SavedBusiness[]         @relation("SavedByOthers")
  mySavedBusinesses       SavedBusiness[]         @relation("MySavedBusinesses")
  reviewsGiven            CommunityReview[]       @relation("ReviewsGiven")
  reviewsReceived         CommunityReview[]       @relation("ReviewsReceived")
  reputation              BusinessReputation?     @relation("BusinessReputation")

  // Flow AI Bot Sessions
  flowSessions         FlowSession[]

  // AI Business Office
  aiExecutionLogs      AiExecutionLog[]
  aiApprovalItems      AiApprovalItem[]
  aiMemories           AiMemory[]
  aiMemoryEmbeddings   AiMemoryEmbedding[]
  aiPlans              AiPlan[]
  autopilotSettings    AutopilotSettings?
  agentTriggers        AgentTrigger[]
  journeyInstances     JourneyInstance[]
  conversationThreads  ConversationThread[]
  businessGoals        BusinessGoal[]
  projectPlans         ProjectPlan[]

  // Keyflow Command notes (polymorphic notes attached to any module item)
  keyflowNotes         KeyflowNote[]

  // Freelancer Hardening (Phases 2-6)
  retainerAgreements   RetainerAgreement[]
  portalAccessTokens   PortalAccess[]

  // Unified Communications Engine
  channelConnections   ChannelConnection[]
  outboundContent      OutboundContent[]

  // WhatsApp Inbox
  whatsappContacts     WhatsAppContact[]
  whatsappMessages     WhatsAppMessage[]
  conversationAiInsights ConversationAIInsight[]
  contactInsightSnapshots ContactInsightSnapshot[]

  // SEO Operations Engine
  seoPages          SeoPage[]
  seoKeywords       SeoKeyword[]
  seoIssues         SeoIssue[]
  contentBriefs     ContentBrief[]

  // Presence editor (S3): Draft/Preview/Published page composition
  sitePageDraft     SitePageDraft?
  sitePagePublished SitePagePublished?

  // Mission 2: Supplier connections
  supplierConnections  SupplierConnection[]

  // Network Connections (Community Phase 1)
  networkConnectionsFrom NetworkConnection[] @relation("NetworkConnectionFrom")
  networkConnectionsTo   NetworkConnection[] @relation("NetworkConnectionTo")

  // Endorsements (Trust & Reputation)
  endorsementsGiven    Endorsement[] @relation("EndorsementFrom")
  endorsementsReceived Endorsement[] @relation("EndorsementTo")

  // Direct Messaging & Collaboration (Community Phase 2)
  conversationsAsA       Conversation[]         @relation("ConversationParticipantA")
  conversationsAsB       Conversation[]         @relation("ConversationParticipantB")
  sentDirectMessages     DirectMessage[]        @relation("DirectMessageSender")
  collabRequestsFrom     CollaborationRequest[] @relation("CollabRequestFrom")
  collabRequestsTo       CollaborationRequest[] @relation("CollabRequestTo")
  communityNotifications CommunityNotification[]

  // Match Feedback (Community Phase 4)
  matchFeedbackGiven    MatchFeedback[] @relation("MatchFeedbackFrom")
  matchFeedbackReceived MatchFeedback[] @relation("MatchFeedbackTo")

  // Relationship Insight Dismissals
  relationshipInsightDismissals          RelationshipInsightDismissal[] @relation("RelationshipInsightDismissalFrom")
  relationshipInsightDismissalsAsTarget  RelationshipInsightDismissal[] @relation("RelationshipInsightDismissalTo")

  // Network Activity & Growth (Community Phase 5)
  opportunitiesPosted        Opportunity[]            @relation("OpportunityPoster")
  opportunityApplications    OpportunityApplication[] @relation("OpportunityApplicant")
  partnerProgramsInitiated   PartnerProgram[]         @relation("PartnerProgramInitiator")
  partnerProgramsReceived    PartnerProgram[]         @relation("PartnerProgramPartner")
  profileViewsGiven          ProfileView[]            @relation("ProfileViewer")
  profileViewsReceived       ProfileView[]            @relation("ProfileViewed")
  networkActivities          NetworkActivity[]        @relation("NetworkActivityActor")
  resourceDownloadsGiven     ResourceDownload[]       @relation("ResourceDownloader")

  // Customer notification preferences (JSON: { booking_confirmed: true, ... })
  notificationPreferences Json? @default("{}") @map("notification_preferences")

  // Gmail Integration for sending quotes/invoices
  gmailEmail        String?   @map("gmail_email")
  gmailAccessToken  String?   @map("gmail_access_token")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailTokenExpiry  DateTime? @map("gmail_token_expiry")

  // Google Calendar Integration for syncing bookings
  calendarEmail        String?   @map("calendar_email")
  calendarAccessToken  String?   @map("calendar_access_token")
  calendarRefreshToken String?   @map("calendar_refresh_token")
  calendarTokenExpiry  DateTime? @map("calendar_token_expiry")
  calendarId           String?   @map("calendar_id")
  calendarSyncDirection String   @default("two_way") @map("calendar_sync_direction")
  calendarSyncEnabled   Boolean  @default(true) @map("calendar_sync_enabled")
  /// Per-event-type sync toggles + visibility:
  /// { booking, contact_task, invoice_due, quote_expiry, content_post, pullExternal, defaultVisibility, lastResyncAt, lastResyncError, consecutiveErrors }
  calendarSyncSettings  Json?    @map("calendar_sync_settings")
  calendarSyncConflicts CalendarSyncConflict[]
  calendarEvents        CalendarEvent[]

  // Google Drive Integration for document viewing/editing
  driveEmail        String?   @map("drive_email")
  driveAccessToken  String?   @map("drive_access_token")
  driveRefreshToken String?   @map("drive_refresh_token")
  driveTokenExpiry  DateTime? @map("drive_token_expiry")

  driveSyncCursor   DriveSyncCursor?
  driveIntakeFiles  DriveIntakeFile[]

  // Connector Message Intake Gate
  messageIntakeEnabled Boolean @default(false) @map("message_intake_enabled")
  messageIntakes      MessageIntake[]

  // Google Forms Integration
  formsEmail        String?   @map("forms_email")
  formsAccessToken  String?   @map("forms_access_token")
  formsRefreshToken String?   @map("forms_refresh_token")
  formsTokenExpiry  DateTime? @map("forms_token_expiry")

  // Google Contacts Integration (ongoing sync)
  contactsEmail        String?   @map("contacts_email")
  contactsAccessToken  String?   @map("contacts_access_token")
  contactsRefreshToken String?   @map("contacts_refresh_token")
  contactsTokenExpiry  DateTime? @map("contacts_token_expiry")
  contactsLastSyncAt   DateTime? @map("contacts_last_sync_at")
  contactsSyncToken    String?   @map("contacts_sync_token")

  // Microsoft / Outlook Contacts Integration (M6)
  msContactsEmail        String?   @map("ms_contacts_email")
  msContactsAccessToken  String?   @map("ms_contacts_access_token")
  msContactsRefreshToken String?   @map("ms_contacts_refresh_token")
  msContactsTokenExpiry  DateTime? @map("ms_contacts_token_expiry")
  msContactsLastSyncAt   DateTime? @map("ms_contacts_last_sync_at")
  msContactsDeltaLink    String?   @map("ms_contacts_delta_link")

  // Email signature parsing settings (M6)
  signatureParsingEnabled Boolean @default(false) @map("signature_parsing_enabled")

  // Google Business Profile
  bpEmail         String?   @map("bp_email")
  bpAccessToken   String?   @map("bp_access_token")
  bpRefreshToken  String?   @map("bp_refresh_token")
  bpTokenExpiry   DateTime? @map("bp_token_expiry")
  bpAccountId     String?   @map("bp_account_id")
  bpLocationId    String?   @map("bp_location_id")

  // Unified Google account preference (single email across services)
  googleSuiteEmail String? @map("google_suite_email")

  // Inventory Spreadsheet Sync
  inventoryLinkedSheetId   String?   @map("inventory_linked_sheet_id")
  inventoryLinkedSheetName String?   @map("inventory_linked_sheet_name")
  inventoryLastSyncAt      DateTime? @map("inventory_last_sync_at")

  // Store Settings
  storeEnabled      Boolean @default(true) @map("store_enabled")
  onboardingComplete Boolean @default(false) @map("onboarding_complete")

  // Booking Reminder (minutes before appointment to send reminder email)
  bookingReminderMins Int @default(60) @map("booking_reminder_mins")

  // Privacy / GDPR settings (M7)
  forgetGraceDays      Int     @default(7) @map("forget_grace_days")
  defaultForgetReason  String? @map("default_forget_reason")
  contactAuditEntries  ContactAuditEntry[]
  contactExportJobs    ContactExportJob[]
  contactForgetRequests ContactForgetRequest[]

  // Business Hours (JSON: { "mon": { "open": "09:00", "close": "17:00", "closed": false }, ... })
  businessHours Json? @map("business_hours")

  // Data Quality (M6)
  dataQualityStaleDays Int @default(180) @map("data_quality_stale_days")
  dataQualityLastRunAt DateTime? @map("data_quality_last_run_at")
  dataQualityIssues    ContactDataIssue[]

  // Field for UI/UX: Gamification, Onboarding, etc.
  metaData  Json?     @default("{}") @map("meta_data")

  // AI Match Recommendations
  matchesAsSource  BusinessMatch[] @relation("BusinessMatchSource")
  matchesAsTarget  BusinessMatch[] @relation("BusinessMatchTarget")

  // AI Suggestion Tracking (Phase 4 follow-up)
  aiSuggestionEventsTriggered AiSuggestionEvent[] @relation("AiSuggestionEventFrom")
  aiSuggestionEventsReceived  AiSuggestionEvent[] @relation("AiSuggestionEventTo")

  // Phase 10: Customer Journey & Growth Intelligence
  customerJourneys     CustomerJourney[]
  journeyTouchpoints   JourneyTouchpoint[]
  attributionResults   AttributionResult[]
  growthInsights       GrowthInsight[]

  // KEY-1: Business Blueprint (operating DNA)
  blueprint            BusinessBlueprint?

  // Phase 1 MD: Commercial Document Templates
  commercialDocumentTemplates CommercialDocumentTemplate[]

  // Phase 1 MD: Procurement Requests
  procurementRequests ProcurementRequest[]

  // Phase 1 MD: KEY Commands
  keyCommands          KeyCommand[]
  commandItems         CommandItem[]

  // OS-2 through OS-7: Business Knowledge Graph, Governance, Finance, Operations, Marketing, Strategy
  entityLinks          BusinessEntityLink[]
  businessRisks        BusinessRisk[]
  cashReserveBuckets   CashReserveBucket[]
  workflowTemplates    WorkflowTemplate[]
  workflowRuns         WorkflowRun[]
  sopDocuments         SopDocument[]
  marketingCampaignPlans MarketingCampaignPlan[]
  businessInitiatives  BusinessInitiative[]

  // Phase 0: Operating Kernel — Business Event Log, Evidence, Assignment, Content, Calls, Approvals, Assets
  businessEvents       BusinessEvent[]
  evidenceFiles        Evidence[]
  contentRequests      ContentRequest[]
  contentDeliveryPackages ContentDeliveryPackage[]
  callLogs             CallLog[]
  approvalRequests     ApprovalRequest[]
  assets               Asset[]
  authorityGrants      AuthorityGrant[]
  timeEntries          TimeEntry[]

  // Analytics & Growth Engine
  businessSnapshots    BusinessSnapshot[]
  maturityScores       MaturityScore[]
  projections          Projection[]

  // Patch 3: Market Strategy & Intelligence
  marketStrategy       MarketStrategy?
  competitors          Competitor[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("businesses")
}

model MarketStrategy {
  id              String   @id @default(cuid())
  businessId      String   @unique @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  swot            Json?    @map("swot")
  pestle          Json?    @map("pestle")
  positioning     Json?    @map("positioning")
  launchPlan      Json?    @map("launch_plan")
  analysisSummary Json?    @map("analysis_summary")
  generatedAt     DateTime? @map("generated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("market_strategies")
}

model Competitor {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  threatLevel String?  @map("threat_level")
  strengths   String[]
  weaknesses  String[]
  positioning String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("competitors")
}

model DriveSyncCursor {
  id           String   @id @default(cuid())
  businessId   String   @unique @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lastSyncAt   DateTime @default("1970-01-01T00:00:00.000Z") @map("last_sync_at")
  pageToken    String?  @map("page_token")
  status       String   @default("idle") // idle | running | error
  errorMessage String?  @map("error_message")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("drive_sync_cursors")
}

model DriveIntakeFile {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  driveFileId     String   @map("drive_file_id")
  name            String
  mimeType        String   @map("mime_type")
  webViewLink     String?  @map("web_view_link")
  size            Int?
  modifiedTime    DateTime @map("modified_time")
  status          String   @default("pending") // pending | extracted | reviewing | approved | rejected | error
  confidence      Float?
  documentType    String?  @map("document_type")
  extractedData   Json?    @map("extracted_data")
  proposedActions Json?    @map("proposed_actions")
  errorMessage    String?  @map("error_message")
  detectedAt      DateTime @default(now()) @map("detected_at")
  processedAt     DateTime? @map("processed_at")

  @@unique([businessId, driveFileId])
  @@index([businessId, status])
  @@index([businessId, modifiedTime])
  @@map("drive_intake_files")
}

model MessageIntake {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectorType   String   @map("connector_type") // whatsapp | gmail | meta_social | sms
  sourceChannel   String   @map("source_channel") // whatsapp | email | sms | instagram | messenger
  externalId      String?  @map("external_id")
  from            String
  fromName        String?  @map("from_name")
  to              String?
  subject         String?
  body            String
  rawPayload      Json?    @map("raw_payload")
  contactId       String?  @map("contact_id")
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  threadId        String?  @map("thread_id")
  thread          ConversationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  status          String   @default("pending") // pending | extracted | reviewing | approved | rejected | error
  confidence      Float?
  intentType      String?  @map("intent_type")
  riskTier        Int      @default(1)
  extractedData   Json?    @map("extracted_data")
  proposedActions Json?    @map("proposed_actions")
  errorMessage    String?  @map("error_message")
  detectedAt      DateTime @default(now()) @map("detected_at")
  processedAt     DateTime? @map("processed_at")

  @@unique([businessId, sourceChannel, externalId])
  @@index([businessId, status])
  @@index([businessId, contactId])
  @@map("message_intakes")
}

model IngestionItem {
  id                    String    @id @default(cuid())
  businessId            String    @map("business_id")
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceType            String    @map("source_type")
  sourceConnectorType   String    @map("source_connector_type")
  externalId            String?   @map("external_id")
  contactId             String?   @map("contact_id")
  contact               Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status                String    @default("pending")

  rawPayload            Json      @map("raw_payload")
  summary               String?
  subject               String?
  body                  String?
  toDestination         String?   @map("to_destination")
  receivedAt            DateTime? @map("received_at")
  attachments           Json?     @map("attachments")
  fromName              String?   @map("from_name")
  fromEmail             String?   @map("from_email")
  fromPhone             String?   @map("from_phone")
  fromExternalId        String?   @map("from_external_id")
  dedupeHash            String?   @map("dedupe_hash")
  intentType            String?   @map("intent_type")
  confidence            Float?
  extractedData         Json?     @map("extracted_data")
  proposedActions       Json?     @map("proposed_actions")
  userFeedback          Json?     @map("user_feedback")
  executedResults       Json?     @map("executed_results")
  errorMessage          String?   @map("error_message")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([businessId, sourceType, externalId])
  @@unique([businessId, dedupeHash])
  @@index([businessId, status])
  @@index([businessId, sourceType])
  @@index([businessId, createdAt])
  @@index([businessId, contactId])
  @@map("ingestion_items")
}

model Membership {
  id   String @id @default(cuid())
  role String // "OWNER", "ADMIN", "STAFF"

  permissionScopes Json?    @map("permission_scopes")
  maxApprovalTier  Int      @default(0) @map("max_approval_tier")

  // L4 Manager — capacity tracking
  dailyCapacityHours Float? @default(8) @map("daily_capacity_hours")
  skills Skill[]

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orgAssignments OrgAssignment[]

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("memberships")
}

model TeamActivityLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  module     String
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  title      String
  detail     String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, userId])
  @@index([businessId, module])
  @@map("team_activity_logs")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String  @map("business_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([businessId])
  @@map("push_subscriptions")
}

// ---
// MODULE 1b: ORGANIZATIONAL STRUCTURE
// ---
model OrgUnit {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  type        String  @default("DEPARTMENT") // BRANCH | DEPARTMENT | DIVISION | TEAM | WAREHOUSE
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  managerId   String? @map("manager_id") // membershipId of manager
  parentId    String? @map("parent_id")
  parent      OrgUnit? @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  children    OrgUnit[] @relation("OrgHierarchy")
  assignments OrgAssignment[]
  bookings    Booking[]
  supportTickets SupportTicket[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([businessId, type])
  @@map("org_units")
}

model JobRole {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  level       Int     @default(0) // hierarchy level 0-10
  permissions Json?   // { module: "read|write|admin", ... }
  defaultApprovalTier Int @default(0) @map("default_approval_tier")
  color       String? @default("#64748b")

  assignments OrgAssignment[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("job_roles")
}

model OrgAssignment {
  id            String  @id @default(cuid())
  businessId    String  @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  membershipId  String  @map("membership_id")
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId        String  @map("user_id") // denormalized for quick lookups
  orgUnitId     String  @map("org_unit_id")
  orgUnit       OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  jobRoleId     String? @map("job_role_id")
  jobRole       JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  reportsToId   String? @map("reports_to_id") // another OrgAssignment id
  reportsTo     OrgAssignment? @relation("ReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports OrgAssignment[] @relation("ReportsTo")

  isPrimary     Boolean @default(true) @map("is_primary")
  startedAt     DateTime @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([businessId, membershipId])
  @@index([businessId, orgUnitId])
  @@index([businessId, userId])
  @@map("org_assignments")
}

model DelegationRule {
  id              String @id @default(cuid())
  businessId      String @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  delegatorId     String @map("delegator_id") // OrgAssignment id
  delegateId      String @map("delegate_id")  // OrgAssignment id
  scope           String // module name or "ALL"
  maxTier         Int    @map("max_tier")
  activeFrom      DateTime @default(now()) @map("active_from")
  activeUntil     DateTime? @map("active_until")
  reason          String?
  isActive        Boolean @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([businessId, delegatorId])
  @@index([businessId, scope])
  @@map("delegation_rules")
}

// ---
// MODULE 2: CRM (RELATIONSHIP INTELLIGENCE)
// ---
model Contact {
  id        String   @id @default(cuid())
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String?
  emailNormalized String? @map("email_normalized")
  phone     String?
  phoneNormalized String? @map("phone_normalized")
  status    String   @default("LEAD")
  source    String?
  tags      String[] @default([])
  custom    Json?    @default("{}")
  displayName  String?  @map("display_name")
  secondaryEmail  String? @map("secondary_email")
  secondaryPhone  String? @map("secondary_phone")
  whatsappNumber  String? @map("whatsapp_number")
  preferredChannel String? @map("preferred_channel")
  bestChannel           String?   @map("best_channel")
  bestChannelConfidence Float?    @map("best_channel_confidence")
  bestTimeWindowJson    Json?     @map("best_time_window_json")
  bestSignalUpdatedAt   DateTime? @map("best_signal_updated_at")
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  state        String?
  postalCode   String? @map("postal_code")
  country      String?
  timezone     String?
  companyName String? @map("company_name")
  jobTitle    String? @map("job_title")
  department  String?
  industry    String?
  ownerId        String? @map("owner_id")
  visibility     String  @default("TEAM") @map("visibility")
  lifecycleStage String? @map("lifecycle_stage")
  sourceDetail   String? @map("source_detail")
  segment        String?
  language       String?
  marketingOptIn Boolean? @map("marketing_opt_in")
  doNotContact   Boolean? @map("do_not_contact")
  notesInternal  String?  @map("notes_internal")
  ageGroup       String?  @map("age_group")
  relationshipType    String?   @map("relationship_type")
  pipelineStage       String?   @map("pipeline_stage")
  relationshipHealth  String?   @map("relationship_health")
  lastContactedAt     DateTime? @map("last_contacted_at")
  nextActionAt        DateTime? @map("next_action_at")
  nextActionType      String?   @map("next_action_type")
  priority            String?
  favorite            Boolean?  @default(false)
  archivedAt          DateTime? @map("archived_at")

  // Persists the most recent MergeOperation that touched this row (either
  // as primary or as duplicate). Both contacts in a merge get the same id,
  // which lets revertMerge — and any downstream auditor — locate the
  // operation deterministically without scanning by time.
  lastMergeId         String?   @map("last_merge_id")
  mergedIntoId        String?   @map("merged_into_id")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  quotes   Quote[]
  invoices Invoice[]
    bookings Booking[]
    events   ContactEvent[]
    notes    ContactNote[]
    tasks    ContactTask[]
    importRecords ContactImportContact[]
    media         ContactMedia[]
    playbooks     ContactPlaybook[]
    auditEntries  ContactAuditEntry[]
    exportJobs    ContactExportJob[]
    forgetRequest ContactForgetRequest?
    recurringInvoices RecurringInvoice[]
    sequenceEnrollments CrmSequenceEnrollment[]
    shares              ContactShare[]
  listMembers         ContactListMember[]
  momentum            ContactMomentum[]
  ingestionItems      IngestionItem[]
  channelStats        ContactChannelStat[]
  momentumSnapshots   ContactMomentumSnapshot[]
  momentumRecommendations MomentumRecommendation[]
  externalMappings    ContactExternalMapping[]
  deals               Deal[]
  accountId           String?  @map("account_id")
  account             Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  customerJourney     CustomerJourney?
  journeyTouchpoints  JourneyTouchpoint[]
  whatsappContacts    WhatsAppContact[]
  conversationInsights ConversationAIInsight[]
  messageIntakes      MessageIntake[]
  relationshipsFrom   ContactRelationship[] @relation("ContactRelationshipFrom")
  relationshipsTo     ContactRelationship[] @relation("ContactRelationshipTo")
  financialTransactions FinancialTransaction[]
  insightSnapshot      ContactInsightSnapshot?
  supportTickets       SupportTicket[]
  conversationThreads  ConversationThread[]

  createdAt DateTime  @default(now()) @map("created_at")
  leadScore        Int?      @map("lead_score")
  lastInteractionAt DateTime? @map("last_interaction_at")

  // Contact Intelligence Engine (Phase 1 MD)
  conversionProbability Float? @map("conversion_probability")
  lifetimeValue    Float?    @map("lifetime_value")
  averageSpend     Float?    @map("average_spend")
  paymentReliability Int?    @map("payment_reliability")
  bookingFrequency Int?      @map("booking_frequency")
  cancellationRate Float?    @map("cancellation_rate")
  responsivenessScore Int?   @map("responsiveness_score")
  preferredServices Json?    @map("preferred_services")
  sentimentScore   Float?    @map("sentiment_score")
  referralLikelihood Int?    @map("referral_likelihood")
  followUpPriority String?   @map("follow_up_priority")
  nextBestAction   String?   @map("next_best_action")
  riskFlags        Json?     @map("risk_flags")
  opportunities    Json?     @map("opportunities")

  // Data Quality (M6)
  dataQualityScore   Int?      @map("data_quality_score")
  dataQualityCheckedAt DateTime? @map("data_quality_checked_at")
  lastVerifiedAt     DateTime? @map("last_verified_at")
  dataIssues         ContactDataIssue[]

  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  // Full-text search (PostgreSQL tsvector) — managed by trigger, not Prisma
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, leadScore])
  @@index([businessId, deletedAt])
  @@index([businessId, deletedAt, status])
  @@index([businessId, deletedAt, createdAt])
  @@index([businessId, lastMergeId])
  @@index([businessId, dataQualityScore])
  @@index([businessId, relationshipType])
  @@index([businessId, pipelineStage])
  @@index([businessId, priority])
  @@index([businessId, nextActionAt])
  @@index([businessId, archivedAt])
  @@index([businessId, ownerId])
  @@index([businessId, visibility])
  @@index([businessId, accountId])
  contactTags       ContactTag[]
  customFieldValues ContactCustomFieldValue[]

  @@unique([businessId, emailNormalized])
  @@unique([businessId, phoneNormalized])
  @@map("contacts")
}

model CustomFieldDefinition {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  name         String
  label        String
  type         String
  description  String?
  placeholder  String?
  options      Json?    // { options: [{ label, value }] } for SELECT / MULTI_SELECT
  defaultValue Json?    @map("default_value")
  required     Boolean  @default(false)
  order        Int      @default(0)
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  values       ContactCustomFieldValue[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, archivedAt])
  @@map("custom_field_definitions")
}

model ContactCustomFieldValue {
  id           String   @id @default(cuid())
  contactId    String   @map("contact_id")
  definitionId String   @map("definition_id")
  value        Json?

  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([contactId, definitionId])
  @@index([contactId])
  @@index([definitionId])
  @@map("contact_custom_field_values")
}

model Tag {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  color       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  contacts    ContactTag[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("tags")
}

model ContactTag {
  contactId String  @map("contact_id")
  tagId     String  @map("tag_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
  @@map("contact_tags")
}

/// Account / Company rollup. Multiple contacts and deals can belong to a single
/// account so we can surface company-level KPIs (lifetime revenue, deal value,
/// communication frequency, etc.). Flat structure for v1 — no parent/subsidiary.
model Account {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name              String
  /// Lower-cased domain extracted from website (used for de-dupe / email matching).
  domain            String?
  industry          String?
  /// Free-text size band: SOLO | SMALL | MEDIUM | LARGE | ENTERPRISE.
  size              String?
  website           String?
  primaryContactId  String?  @map("primary_contact_id")
  ownerUserId       String?  @map("owner_user_id")
  tags              String[] @default([])
  notes             String?

  contacts          Contact[]
  deals             Deal[]

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([businessId, domain])
  @@index([businessId, name])
  @@index([businessId, industry])
  @@index([businessId, ownerUserId])
  @@index([businessId, deletedAt])
  @@map("accounts")
}

model DealStage {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  position    Int     @default(0)
  color       String?
  category    String  @default("OPEN") // OPEN | WON | LOST
  isDefault   Boolean @default(false) @map("is_default")
  archivedAt  DateTime? @map("archived_at")

  deals       Deal[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([businessId, slug])
  @@index([businessId, position])
  @@map("deal_stages")
}

model Deal {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId       String   @map("contact_id")
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId       String?  @map("account_id")
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  title           String
  description     String?
  companyName     String?  @map("company_name")
  value           Float?
  currency        String   @default("TTD")

  stageId         String   @map("stage_id")
  stage           DealStage @relation(fields: [stageId], references: [id])

  status          String   @default("OPEN") // OPEN | WON | LOST
  probability     Int?     // 0-100
  ownerUserId     String?  @map("owner_user_id")
  source          String?
  sourceDetail    String?  @map("source_detail")
  tags            String[] @default([])
  notes           String?

  expectedCloseAt DateTime? @map("expected_close_at")
  wonAt           DateTime? @map("won_at")
  lostAt          DateTime? @map("lost_at")
  lossReason      String?   @map("loss_reason")
  lastStageChangedAt DateTime? @map("last_stage_changed_at")

  // Deal intelligence (M3)
  healthScore        Int?      @map("health_score")
  healthScoreAt      DateTime? @map("health_score_at")
  healthBreakdown    Json?     @map("health_breakdown")
  bottleneckFlag     Boolean   @default(false) @map("bottleneck_flag")
  bottleneckAt       DateTime? @map("bottleneck_at")
  wonLostReasonId    String?   @map("won_lost_reason_id")
  wonLostReason      WonLostReason? @relation(fields: [wonLostReasonId], references: [id])
  wonLostReasonNotes String?   @map("won_lost_reason_notes")

  // Optional links
  quoteId         String?  @map("quote_id")
  invoiceId       String?  @map("invoice_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([businessId, status])
  @@index([businessId, stageId])
  @@index([businessId, ownerUserId])
  @@index([businessId, expectedCloseAt])
  @@index([contactId])
  @@index([businessId, accountId])
  @@index([businessId, deletedAt])
  @@index([businessId, bottleneckFlag])
  @@map("deals")
}

model ContactRelationship {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  fromContactId String   @map("from_contact_id")
  toContactId   String   @map("to_contact_id")
  type          String
  since         DateTime?
  note          String?

  fromContact Contact @relation("ContactRelationshipFrom", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("ContactRelationshipTo", fields: [toContactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([fromContactId, toContactId, type])
  @@index([businessId])
  @@index([businessId, type])
  @@index([fromContactId])
  @@index([toContactId])
  @@map("contact_relationships")
}

model ContactShare {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")
  userId     String   @map("user_id")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user       User     @relation("UserContactShares", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@index([businessId, userId])
  @@index([contactId])
  @@map("contact_shares")
}

/// Persistent data-quality issues detected by the nightly scanner. One row per
/// (contact, kind) so we never duplicate the same issue. The recommendedFix
/// payload is consumed by the bulk-fix UI and the "Clean my contacts" wizard.
model ContactDataIssue {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  contactId     String   @map("contact_id")
  kind          String   // invalid_email | invalid_phone | missing_required | stale_data | suspected_duplicate
  severity      String   @default("medium") // low | medium | high
  field         String?  // contact field this issue refers to (e.g. "email")
  message       String
  recommendedFix Json?   @map("recommended_fix")
  status        String   @default("open") // open | resolved | dismissed
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?   @map("resolved_by")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@unique([contactId, kind])
  @@index([businessId, status])
  @@index([businessId, kind, status])
  @@index([businessId, severity, status])
  @@map("contact_data_issues")
}

model WonLostReason {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  kind        String   // WON | LOST
  label       String
  slug        String
  position    Int      @default(0)
  isDefault   Boolean  @default(false) @map("is_default")
  archivedAt  DateTime? @map("archived_at")

  deals       Deal[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([businessId, kind, slug])
  @@index([businessId, kind, position])
  @@map("won_lost_reasons")
}

model ContactExternalMapping {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")
  source     String
  externalId String   @map("external_id")

  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([businessId, source, externalId])
  @@index([contactId])
  @@map("contact_external_mappings")
}

model ContactSyncAudit {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  contactId    String?  @map("contact_id")
  source       String   // google_contacts | outlook_contacts | signature
  externalId   String?  @map("external_id")
  action       String   // imported | updated | deleted | conflict_resolved | enriched_from_signature | created_from_signature
  resolution   String?  // most_recent_write_wins | local_kept | external_kept | merged
  fieldsChanged String[] @default([]) @map("fields_changed")
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([businessId, source, createdAt])
  @@index([businessId, contactId])
  @@map("contact_sync_audits")
}

model CalendarSyncConflict {
  id              String   @id @default(cuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId       String?  @map("booking_id")
  externalEventId String?  @map("external_event_id")
  conflictType    String   @map("conflict_type") // overlap | external_only | booking_only | mismatch
  summary         String
  externalSummary String?  @map("external_summary")
  bookingStart    DateTime? @map("booking_start")
  bookingEnd      DateTime? @map("booking_end")
  externalStart   DateTime? @map("external_start")
  externalEnd     DateTime? @map("external_end")
  status          String   @default("open") // open | resolved | dismissed
  resolution      String?  // keep_keyflow | keep_external | dismissed
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@map("calendar_sync_conflicts")
}

/// CalendarEvent — canonical projection of every scheduled / due / planned
/// record across the product. See packages/shared/src/calendar-events.ts
/// for the legal values of `type`, `module`, `status`, `priority`,
/// `visibility`, `syncStatus`, and `sourceType`.
model CalendarEvent {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title       String
  description String?

  /// One of CALENDAR_EVENT_TYPES (e.g. BOOKING, INVOICE_DUE, ...)
  type        String
  /// One of CALENDAR_EVENT_MODULES (e.g. BOOKINGS, REVENUE, ...)
  module      String

  startAt     DateTime  @map("start_at")
  endAt       DateTime? @map("end_at")
  allDay      Boolean   @default(false) @map("all_day")
  timezone    String?

  /// One of CALENDAR_EVENT_STATUSES
  status      String    @default("SCHEDULED")
  /// One of CALENDAR_EVENT_PRIORITIES
  priority    String    @default("NORMAL")
  color       String?
  /// One of CALENDAR_EVENT_VISIBILITIES
  visibility  String    @default("TEAM")

  /// Origin model identifier (one of CALENDAR_SOURCE_TYPES)
  sourceType  String    @map("source_type")
  /// Primary key of the origin row
  sourceId    String    @map("source_id")
  sourceUrl   String?   @map("source_url")

  contactId   String?   @map("contact_id")
  staffId     String?   @map("staff_id")
  assigneeId  String?   @map("assignee_id")

  amount      Float?
  currency    String?

  meta        Json?

  /// One of CALENDAR_SYNC_STATUSES
  syncStatus       String    @default("LOCAL") @map("sync_status")
  googleEventId    String?   @map("google_event_id")
  googleCalendarId String?   @map("google_calendar_id")
  lastSyncedAt     DateTime? @map("last_synced_at")
  syncError        String?   @map("sync_error")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, startAt])
  @@index([businessId, module, startAt])
  @@index([businessId, type, startAt])
  @@index([businessId, contactId])
  @@index([businessId, staffId])
  @@index([businessId, syncStatus])
  @@map("calendar_events")
}

