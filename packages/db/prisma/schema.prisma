generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// This is your datasource, pointing to your Supabase Postgres DB
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---
// MODULE 1: IDENTITY & ACCOUNTS
// ---
model User {
  id        String  @id @default(cuid()) // Corresponds to Supabase auth.users.id
  email     String  @unique
  name      String?
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")
  role      String  @default("USER") // USER | SUPER_ADMIN

  businesses Membership[]
  sessions   Session[]

  aiExecutionLogs    AiExecutionLog[]    @relation("UserAiExecutionLogs")
  aiApprovalItems    AiApprovalItem[]    @relation("UserAiApprovalItems")
  aiApprovalResolutions AiApprovalItem[] @relation("UserAiApprovalResolutions")
  aiPlans            AiPlan[]            @relation("UserAiPlans")

  @@map("users")
}

model Business {
  id       String  @id @default(cuid())
  name     String
  ownerId  String  @map("owner_id")
  slug     String? @unique
  timezone String  @default("America/Port_of_Spain")
  currency String  @default("TTD")

  // Business Profile
  logoUrl      String?  @map("logo_url")
  tagline      String?
  description  String?
  address      String?
  city         String?
  country      String?
  phone        String?
  email        String?
  website      String?

  // Social Handles
  facebook     String?
  instagram    String?
  twitter      String?
  linkedin     String?
  tiktok       String?
  youtube      String?
  whatsapp     String?

  // Community Profile
  headline          String?
  bio               String?
  skills            String[] @default([])
  businessStage     String?  @map("business_stage")       // IDEA, STARTUP, GROWTH, ESTABLISHED, SCALING
  interests         String[] @default([])
  profileCompleteness Int    @default(0) @map("profile_completeness")

  // Brand Settings
  primaryColor   String?  @default("#F97316") @map("primary_color")
  secondaryColor String?  @default("#14B8A6") @map("secondary_color")
  defaultTaxRate Float?   @default(0) @map("default_tax_rate")
  invoiceTemplate String? @default("classic") @map("invoice_template")

  // Business Autopilot Settings
  businessIntent   String?  @map("business_intent")    // Free-text description of business idea
  archetype        String?  @map("archetype")          // LOCAL_SERVICE, DIGITAL_PRODUCT, AGENCY, CLINIC, ECOMMERCE
  industry         String?  @map("industry")           // Auto-inferred from intent
  revenueModel     String?  @map("revenue_model")      // SUBSCRIPTION, ONE_TIME, RETAINER, USAGE_BASED
  budgetRange      String?  @map("budget_range")       // LOW, MEDIUM, HIGH
  timeCommitment   String?  @map("time_commitment")    // MINIMAL, PART_TIME, FULL_TIME
  teamSize         String?  @map("team_size")          // SOLO, SMALL_TEAM, GROWING
  autopilotEnabled Boolean  @default(true) @map("autopilot_enabled")
  autopilotStage   String?  @map("autopilot_stage")    // SETUP, LAUNCHING, OPERATING, MAINTENANCE
  
  // Compliance & Health
  complianceStatus String?  @map("compliance_status")  // GREEN, YELLOW, RED
  complianceData   Json?    @map("compliance_data")    // { itemId: boolean, ... }
  lastHealthCheck  DateTime? @map("last_health_check")

  // Module Relationships
  members          Membership[]
  contacts         Contact[]
  invoices         Invoice[]
  quotes           Quote[]
  products         Product[]
  bookings         Booking[]
  contactEvents    ContactEvent[]
  contactNotes     ContactNote[]
  contactTasks     ContactTask[]
    contactImports   ContactImport[]
    contactMedia     ContactMedia[]
    playbooks        ContactPlaybook[]
  services         Service[]
  staff            StaffMember[]
  socialPosts      SocialPost[]
  socialConns      SocialConnection[]
  automations      Automation[]
  projects         Project[]
  projectTasks     ProjectTask[]
  projectTemplates ProjectTemplate[]
  sites            Site[]
  autopilotTasks   AutopilotTask[]
  notifications    Notification[]
  subscriptions    Subscription[]
  activities       Activity[]
  expenses         Expense[]
  expenseCategories ExpenseCategory[]
  expenseBudgets   ExpenseBudget[]
  recurringInvoices RecurringInvoice[]
  emailCampaigns   EmailCampaign[]
  emailContacts    EmailCampaignContact[]
  leadForms        LeadForm[]
  leadSubmissions  LeadFormSubmission[]
  businessTemplates BusinessTemplateUsage[]
  courses          Course[]
  courseEnrollments CourseEnrollment[]
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  cohorts          Cohort[]
  cohortMembers    CohortMember[]
  landingPages     LandingPage[]
  webhooks         Webhook[]
  aiUsageLogs      AiUsageLog[]
  marketplaceListings MarketplaceListing[]
  shippingZones    ShippingZone[]
  warehouses       Warehouse[]
  inventoryStocks  InventoryStock[]
  stockMovements   StockMovement[]
  shipments        Shipment[]
  customsDeclarations CustomsDeclaration[]
  preOrders        PreOrder[]
  purchaseOrders   PurchaseOrder[]
  marketplaceOrders MarketplaceOrder[]
  fulfillmentRoutes FulfillmentRoute[]
  promoCodes       PromoCode[]
  crmSequences      CrmSequence[]
  crossModuleWorkflows CrossModuleWorkflow[]
  scheduledAgentJobs   ScheduledAgentJob[]
  customerNotificationLogs CustomerNotificationLog[]
  apiKeys              ApiKey[]
  guidanceProfile      BusinessGuidanceProfile?
  guidanceAssessments  GuidanceAssessment[]

  // Business Builder
  businessPlans        BusinessPlan[]

  // Document Engine
  profileVersions      BusinessProfileVersion[]
  documentInstances    DocumentInstance[]
  documentChangeLogs   DocumentChangeLog[]
  orgStandards         OrgStandard[]
  reviewTasks          ReviewTask[]

  // AI Output Templates
  outputTemplates      OutputTemplate[]

  // Intake Submissions
  intakeSubmissions    IntakeSubmission[]

  // Flow AI Bot Sessions
  flowSessions         FlowSession[]

  // AI Business Office
  aiExecutionLogs      AiExecutionLog[]
  aiApprovalItems      AiApprovalItem[]
  aiMemories           AiMemory[]
  aiPlans              AiPlan[]

  // Unified Communications Engine
  channelConnections   ChannelConnection[]
  outboundContent      OutboundContent[]

  // Mission 2: Supplier connections
  supplierConnections  SupplierConnection[]

  // Customer notification preferences (JSON: { booking_confirmed: true, ... })
  notificationPreferences Json? @default("{}") @map("notification_preferences")

  // Gmail Integration for sending quotes/invoices
  gmailEmail        String?   @map("gmail_email")
  gmailAccessToken  String?   @map("gmail_access_token")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailTokenExpiry  DateTime? @map("gmail_token_expiry")

  // Google Calendar Integration for syncing bookings
  calendarEmail        String?   @map("calendar_email")
  calendarAccessToken  String?   @map("calendar_access_token")
  calendarRefreshToken String?   @map("calendar_refresh_token")
  calendarTokenExpiry  DateTime? @map("calendar_token_expiry")
  calendarId           String?   @map("calendar_id")

  // Google Drive Integration for document viewing/editing
  driveEmail        String?   @map("drive_email")
  driveAccessToken  String?   @map("drive_access_token")
  driveRefreshToken String?   @map("drive_refresh_token")
  driveTokenExpiry  DateTime? @map("drive_token_expiry")

  // Inventory Spreadsheet Sync
  inventoryLinkedSheetId   String?   @map("inventory_linked_sheet_id")
  inventoryLinkedSheetName String?   @map("inventory_linked_sheet_name")
  inventoryLastSyncAt      DateTime? @map("inventory_last_sync_at")

  // Store Settings
  storeEnabled      Boolean @default(true) @map("store_enabled")
  onboardingComplete Boolean @default(false) @map("onboarding_complete")

  // Booking Reminder (minutes before appointment to send reminder email)
  bookingReminderMins Int @default(60) @map("booking_reminder_mins")

  // Business Hours (JSON: { "mon": { "open": "09:00", "close": "17:00", "closed": false }, ... })
  businessHours Json? @map("business_hours")

  // Field for UI/UX: Gamification, Onboarding, etc.
  metaData  Json?     @default("{}") @map("meta_data")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("businesses")
}

model Membership {
  id   String @id @default(cuid())
  role String // "OWNER", "ADMIN", "STAFF"

  permissionScopes Json?    @map("permission_scopes")
  maxApprovalTier  Int      @default(0) @map("max_approval_tier")

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("memberships")
}

model TeamActivityLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  module     String
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  title      String
  detail     String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, userId])
  @@index([businessId, module])
  @@map("team_activity_logs")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---
// MODULE 2: CRM (RELATIONSHIP INTELLIGENCE)
// ---
model Contact {
  id        String   @id @default(cuid())
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String?
  emailNormalized String? @map("email_normalized")
  phone     String?
  phoneNormalized String? @map("phone_normalized")
  status    String   @default("LEAD")
  source    String?
  tags      String[] @default([])
  custom    Json?    @default("{}")
  displayName  String?  @map("display_name")
  secondaryEmail  String? @map("secondary_email")
  secondaryPhone  String? @map("secondary_phone")
  whatsappNumber  String? @map("whatsapp_number")
  preferredChannel String? @map("preferred_channel")
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  state        String?
  postalCode   String? @map("postal_code")
  country      String?
  timezone     String?
  companyName String? @map("company_name")
  jobTitle    String? @map("job_title")
  department  String?
  industry    String?
  ownerId        String? @map("owner_id")
  lifecycleStage String? @map("lifecycle_stage")
  sourceDetail   String? @map("source_detail")
  segment        String?
  language       String?
  marketingOptIn Boolean? @map("marketing_opt_in")
  doNotContact   Boolean? @map("do_not_contact")
  notesInternal  String?  @map("notes_internal")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  quotes   Quote[]
  invoices Invoice[]
    bookings Booking[]
    events   ContactEvent[]
    notes    ContactNote[]
    tasks    ContactTask[]
    importRecords ContactImportContact[]
    media         ContactMedia[]
    playbooks     ContactPlaybook[]
    recurringInvoices RecurringInvoice[]
    sequenceEnrollments CrmSequenceEnrollment[]
  listMembers         ContactListMember[]
  momentum            ContactMomentum[]
  momentumSnapshots   ContactMomentumSnapshot[]
  momentumRecommendations MomentumRecommendation[]

  createdAt DateTime  @default(now()) @map("created_at")
  leadScore        Int?      @map("lead_score")
  lastInteractionAt DateTime? @map("last_interaction_at")

  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, leadScore])
  @@index([businessId, deletedAt])
  @@index([businessId, deletedAt, status])
  @@index([businessId, deletedAt, createdAt])
  @@unique([businessId, emailNormalized])
  @@unique([businessId, phoneNormalized])
  @@map("contacts")
}

model ContactEvent {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")
  type       String
  data       Json
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id")
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, contactId])
  @@index([businessId, contactId, type])
  @@index([businessId, type, createdAt])
  @@map("contact_events")
}

model ContactNote {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String   @map("contact_id")
  authorId   String?  @map("author_id")
  body       String
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, contactId])
  @@index([businessId, createdAt])
  @@map("contact_notes")
}

model ContactTask {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  contactId   String   @map("contact_id")
  assigneeId  String?  @map("assignee_id")
  title       String
  dueDate     DateTime? @map("due_date")
  status      String    @default("OPEN")
  priority    String    @default("NORMAL")
  remindAt    DateTime? @map("remind_at")
  completedAt DateTime? @map("completed_at")
  source      String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, contactId])
  @@index([businessId, status, dueDate])
  @@index([businessId, assigneeId, status])
  @@map("contact_tasks")
}

model ContactImport {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  sourceType    String   @map("source_type")
  sourceUrl     String?  @map("source_url")
  originalName  String?  @map("original_name")
  status        String   @default("PENDING")
  totalRows     Int?     @map("total_rows")
  processedRows Int?     @map("processed_rows")
  headerMapping Json?    @map("header_mapping")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  completedAt   DateTime? @map("completed_at")

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  records  ContactImportContact[]

  @@index([businessId, createdAt])
  @@map("contact_imports")
}

model ContactImportContact {
  id        String   @id @default(cuid())
  importId  String   @map("import_id")
  contactId String?  @map("contact_id")
  rawData   Json     @map("raw_data")
  status    String   @default("PENDING")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  import ContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id])

  @@index([importId])
  @@index([contactId])
  @@map("contact_import_contacts")
}

model ContactMedia {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  contactId  String?  @map("contact_id")
  type       String
  url        String
  ocrText    String?  @map("ocr_text")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id])

  @@index([businessId, contactId])
  @@map("contact_media")
}

model ContactPlaybook {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  contactId     String   @map("contact_id")
  type          String   // 'default' | 'medical' | 'coaching' | etc.
  schemaVersion String   @map("schema_version")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")
  lastUsedAt    DateTime? @map("last_used_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([businessId, contactId])
  @@map("contact_playbooks")
}

model ContactList {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  description String?
  color       String?
  type        String   @default("MANUAL")
  filters     Json?
  contactIds  String[] @map("contact_ids")
  members     ContactListMember[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("contact_lists")
}

model ContactListMember {
  id        String      @id @default(cuid())
  listId    String      @map("list_id")
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String      @map("contact_id")
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now()) @map("added_at")

  @@unique([listId, contactId])
  @@index([contactId])
  @@map("contact_list_members")
}

// ---
// MODULE 3: COMMERCE (QUOTES, INVOICES, PAYMENTS)
// ---
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("TTD") // Caribbean localization
  category    String   @default("SERVICE") // SERVICE, PRODUCT, PACKAGE
  duration    Int?     // Duration in minutes (for services)
  imageUrl    String?  @map("image_url")
  sku         String?  // Stock keeping unit
  isActive    Boolean  @default(true) @map("is_active")

  // Mission 2: Fulfillment & inventory extensions
  fulfillmentModel  String?  @map("fulfillment_model")   // local_stock, dropship, preorder, manual, hybrid
  inventoryMode     String?  @map("inventory_mode")      // tracked, untracked, virtual
  compareAtPrice    Float?   @map("compare_at_price")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relationships
  quoteItems      QuoteItem[]
  invoiceItems    InvoiceItem[]
  projectTemplate ProjectTemplate? // Link to a project template
  marketplaceListings MarketplaceListing[]
  inventoryStocks InventoryStock[]
  preOrders       PreOrder[]
  orderItems      MarketplaceOrderItem[]
  variants        ProductVariant[]
  sourceLinks     ProductSourceLink[]
  costProfile     ProductCostProfile?
  marginSnapshots MarginSnapshot[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@map("products")
}

model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @map("quote_number")
  status      String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  subtotal    Float    @default(0)
  taxRate     Float?   @default(0) @map("tax_rate")
  taxAmount   Float?   @default(0) @map("tax_amount")
  discountType  String?  @map("discount_type") // PERCENT or FIXED
  discountValue Float?   @default(0) @map("discount_value")
  discountAmount Float?  @default(0) @map("discount_amount")
  total       Float
  currency    String   @default("TTD")
  notes       String?
  issueDate   DateTime @default(now()) @map("issue_date")
  expiryDate  DateTime? @map("expiry_date")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String   @map("contact_id")
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY: Do not delete quote if contact is deleted

  items     QuoteItem[]
  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@unique([businessId, quoteNumber])
  @@index([businessId, contactId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float   @map("unit_price")
  total       Float

  quoteId   String   @map("quote_id")
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade) // Safe to cascade
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction) // DATA INTEGRITY: Keep item history

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @map("invoice_number")
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, VOID, OVERDUE, FAILED
  subtotal      Float    @default(0)
  taxRate       Float?   @default(0) @map("tax_rate")
  taxAmount     Float?   @default(0) @map("tax_amount")
  discountType  String?  @map("discount_type") // PERCENTAGE or FIXED
  discountValue Float?   @default(0) @map("discount_value")
  discountAmount Float?  @default(0) @map("discount_amount")
  total         Float
  currency      String   @default("TTD")
  notes         String?
  issueDate     DateTime @default(now()) @map("issue_date")
  dueDate       DateTime? @map("due_date")
  paidAt        DateTime? @map("paid_at")
  sentAt        DateTime? @map("sent_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String   @map("contact_id")
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY

  items        InvoiceItem[]
  payments     Payment[]
  paymentLinks PaymentLink[]
  booking      Booking?
  quote    Quote?    @relation(fields: [quoteId], references: [id], onUpdate: NoAction, onDelete: NoAction) // DATA INTEGRITY
  quoteId  String?   @unique @map("quote_id")

  campaignId String?       @map("campaign_id")
  campaign   EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@unique([businessId, invoiceNumber])
  @@index([businessId, contactId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float   @map("unit_price")
  total       Float

  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Safe to cascade
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction) // DATA INTEGRITY

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(cuid())
  amount            Float
  currency          String
  status            String   // PENDING, SUCCESSFUL, FAILED
  provider          String   // "wipay", "paypal", "cash", "bank_transfer", "card"
  method            String?  @default("card") // card, cash, bank_transfer, paypal, wipay, check, other
  providerPaymentId String   @unique @map("provider_payment_id")
  reference         String?
  notes             String?
  recordedBy        String?  @map("recorded_by")
  createdAt         DateTime @default(now()) @map("created_at")

  businessId String  @map("business_id")
  invoiceId  String  @map("invoice_id")
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: NoAction)

  @@index([businessId, invoiceId])
  @@map("payments")
}

model PaymentLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  businessId String  @map("business_id")
  active    Boolean  @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([businessId])
  @@map("payment_links")
}

// ---
// MODULE 4: BOOKINGS (SCHEDULING & TIME)
// ---
model StaffMember {
  id   String @id @default(cuid())
  name String

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  services       Service[]
  bookings       Booking[]
  availabilities Availability[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@map("staff_members")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int // Duration in minutes
  price       Float // Price for this service
  bufferMins  Int?    @map("buffer_mins")
  leadTimeMins Int?   @map("lead_time_mins")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  bookings Booking[]
  staff    StaffMember[] // Staff who can perform this service

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId])
  @@map("services")
}

model Availability {
  id        String @id @default(cuid())
  dayOfWeek Int    @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime String @map("start_time") // "HH:MM"
  endTime   String @map("end_time") // "HH:MM"

  staffId String      @map("staff_id")
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade) // Safe to cascade

  @@index([staffId])
  @@map("availabilities")
}

model Booking {
  id        String   @id @default(cuid())
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED

  businessId String      @map("business_id")
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String      @map("contact_id")
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: NoAction) // DATA INTEGRITY
  serviceId  String      @map("service_id")
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: NoAction) // DATA INTEGRITY
  staffId    String?      @map("staff_id")
  staff      StaffMember? @relation(fields: [staffId], references: [id], onDelete: NoAction) // DATA INTEGRITY

  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onUpdate: NoAction, onDelete: NoAction) // DATA INTEGRITY

  notes           String?
  calendarEventId String? @map("calendar_event_id")
  reminderSentAt  DateTime? @map("reminder_sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId, staffId, startTime, endTime])
  @@index([businessId, contactId])
  @@map("bookings")
}

// ---
// MODULE 5: SOCIAL INTELLIGENCE
// ---
model SocialConnection {
  id             String   @id @default(cuid())
  platform       String // "FACEBOOK", "INSTAGRAM", "LINKEDIN", "TWITTER"
  platformId     String?  @map("platform_id")
  accountName    String?  @map("account_name")
  profilePicture String?  @map("profile_picture")
  token          String
  refreshToken   String?  @map("refresh_token")
  expiresAt      DateTime? @map("expires_at")
  scopes         String?
  status         String   @default("CONNECTED") // CONNECTED, EXPIRED, ERROR

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([businessId, platform])
  @@index([businessId])
  @@map("social_connections")
}

model SocialPost {
  id          String   @id @default(cuid())
  content     String
  mediaUrls   String[] @map("media_urls")
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, POSTED, FAILED
  scheduledAt DateTime? @map("scheduled_at")
  postedAt    DateTime? @map("posted_at")
  channelIds  String[] @default([]) @map("channel_ids")
  publishResults Json?  @map("publish_results")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@index([businessId, status, scheduledAt])
  @@map("social_posts")
}

// ---
// MODULE 5B: UNIFIED COMMUNICATIONS ENGINE
// ---
model ChannelConnection {
  id            String   @id @default(cuid())
  provider      String   // META, GOOGLE, WHATSAPP, MANUAL
  label         String?
  accountEmail  String?  @map("account_email")
  token         String?
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime? @map("expires_at")
  scopes        String?
  providerMeta  Json?    @map("provider_meta")
  healthState   String   @default("Connected") // Connected, NeedsRefresh, Expired, MissingPermission, DestinationMissing, Disabled, Error
  healthMessage String?  @map("health_message")
  lastCheckedAt DateTime? @map("last_checked_at")

  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  destinations  ChannelDestination[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, provider])
  @@map("channel_connections")
}

model ChannelDestination {
  id             String   @id @default(cuid())
  connectionId   String   @map("connection_id")
  connection     ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform       String   // FACEBOOK_PAGE, INSTAGRAM_BUSINESS, EMAIL, WHATSAPP
  platformId     String?  @map("platform_id")
  displayName    String?  @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  capabilities   String[] @default([]) // supports_text_post, supports_image_post, supports_video_post, supports_campaign_email, etc.
  isActive       Boolean  @default(true) @map("is_active")
  destinationMeta Json?   @map("destination_meta")

  businessId     String   @map("business_id")

  deliveries     OutboundDelivery[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@index([connectionId])
  @@index([businessId])
  @@index([businessId, platform])
  @@map("channel_destinations")
}

model OutboundContent {
  id            String   @id @default(cuid())
  contentType   String   @default("social_post") @map("content_type") // social_post, campaign_email, direct_message
  subject       String?
  body          String?
  status        String   @default("Draft") // Draft, Scheduled, Queued, Sending, Sent, PartiallyFailed, Failed, Cancelled
  scheduledAt   DateTime? @map("scheduled_at")
  timezone      String   @default("America/Port_of_Spain")
  publishedAt   DateTime? @map("published_at")
  contentMeta   Json?    @map("content_meta")

  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  variants      OutboundVariant[]
  deliveries    OutboundDelivery[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([businessId, status])
  @@index([businessId, contentType])
  @@index([businessId, scheduledAt])
  @@map("outbound_content")
}

model OutboundVariant {
  id            String   @id @default(cuid())
  contentId     String   @map("content_id")
  content       OutboundContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform      String   // FACEBOOK_PAGE, INSTAGRAM_BUSINESS, EMAIL, WHATSAPP, DEFAULT
  textBody      String?  @map("text_body")
  htmlBody      String?  @map("html_body")
  mediaUrls     String[] @default([]) @map("media_urls")
  variantMeta   Json?    @map("variant_meta")

  deliveries    OutboundDelivery[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([contentId])
  @@index([contentId, platform])
  @@map("outbound_variants")
}

model OutboundDelivery {
  id              String   @id @default(cuid())
  contentId       String   @map("content_id")
  content         OutboundContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  variantId       String?  @map("variant_id")
  variant         OutboundVariant? @relation(fields: [variantId], references: [id])
  destinationId   String   @map("destination_id")
  destination     ChannelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  contactId       String?  @map("contact_id")
  recipientEmail  String?  @map("recipient_email")
  recipientPhone  String?  @map("recipient_phone")
  status          String   @default("Queued") // Queued, Scheduled, Sending, Sent, Published, Failed, RetryPending, Cancelled
  scheduledAt     DateTime? @map("scheduled_at")
  sentAt          DateTime? @map("sent_at")
  externalPostId  String?  @map("external_post_id")
  externalUrl     String?  @map("external_url")
  errorCode       String?  @map("error_code")
  errorMessage    String?  @map("error_message")
  retryCount      Int      @default(0) @map("retry_count")
  maxRetries      Int      @default(3) @map("max_retries")
  nextRetryAt     DateTime? @map("next_retry_at")
  resultSnapshot  Json?    @map("result_snapshot")

  businessId      String   @map("business_id")

  events          DeliveryEvent[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@index([businessId])
  @@index([businessId, status])
  @@index([contentId])
  @@index([destinationId])
  @@index([contactId])
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@map("outbound_deliveries")
}

model DeliveryEvent {
  id          String   @id @default(cuid())
  deliveryId  String   @map("delivery_id")
  delivery    OutboundDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type") // attempt, success, failure, retry_scheduled, cancelled
  statusBefore String? @map("status_before")
  statusAfter  String? @map("status_after")
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  resultData   Json?   @map("result_data")
  attemptNumber Int?   @map("attempt_number")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([deliveryId])
  @@index([deliveryId, eventType])
  @@map("delivery_events")
}

// ---
// MODULE 6: MARKETING AUTOMATION & PROJECTS
// ---
model Automation {
  id      String  @id @default(cuid())
  name    String
  trigger String  // "invoice.paid", "booking.created"
  enabled Boolean @default(true)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  actionData Json? @map("action_data")
  condition  String?   @map("condition")
  lastRunAt  DateTime? @map("last_run_at")
  runCount   Int       @default(0) @map("run_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId, trigger])
  @@map("automations")
}

model CrossModuleWorkflow {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workflowKey String  @map("workflow_key")
  enabled     Boolean @default(true)
  config      Json?

  lastRunAt DateTime? @map("last_run_at")
  runCount  Int       @default(0) @map("run_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@unique([businessId, workflowKey])
  @@index([businessId])
  @@map("cross_module_workflows")
}

model ScheduledAgentJob {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  jobType    String   @map("job_type")
  entityId   String   @map("entity_id")
  checkpoint String
  status     String   @default("PENDING")
  payload    Json?
  scheduledFor DateTime @map("scheduled_for")
  executedAt   DateTime? @map("executed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@unique([businessId, entityId, checkpoint])
  @@index([status, scheduledFor])
  @@map("scheduled_agent_jobs")
}

model Activity {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  module     String   // "crm", "commerce", "bookings", "social", "automation"
  action     String   // "created", "updated", "paid", "published", "executed"
  entityType String   @map("entity_type") // "contact", "invoice", "booking", "post", "playbook"
  entityId   String?  @map("entity_id")
  title      String
  detail     String?
  icon       String?
  tone       String?  // "success", "info", "warning", "danger"
  data       Json?
  contactId  String?  @map("contact_id")

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, module])
  @@map("activities")
}

model Project {
  id          String @id @default(cuid())
  name        String
  description String?
  status      String @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, ARCHIVED
  priority    String @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  color       String?

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tasks      ProjectTask[]

  contactId  String?  @map("contact_id")
  invoiceId  String?  @map("invoice_id")
  bookingId  String?  @map("booking_id")
  dueDate    DateTime? @map("due_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@index([businessId, status])
  @@map("projects")
}

model ProjectTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  dueDate     DateTime? @map("due_date")
  priority    String   @default("NORMAL")
  sortOrder   Int      @default(0) @map("sort_order")
  assigneeId  String?  @map("assignee_id")

  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId])
  @@index([businessId])
  @@map("project_tasks")
}

model ProjectTemplate {
  id   String @id @default(cuid())
  name String

  taskTitles Json @map("task_titles") // Store the list of tasks to create as JSON

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productId String?  @unique @map("product_id") // Link template to a *single* product
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("project_templates")
}

// ---
// MODULE 7: WEBSITE & DIGITAL PRESENCE (MVP: Social Links Page)
// ---
model Site {
  id        String @id @default(cuid())
  subdomain String @unique // e.g., "keyflow.app/@myclinic"

  // MVP: Simple JSON for "Social Links" page
  // e.g., { "title": "My Clinic", "links": [{"name": "Website", "url": "..."}] }
  siteData Json? @map("site_data")

  businessId String   @unique @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  @@map("sites")
}

// ---
// MODULE 8: BUSINESS AUTOPILOT
// ---
model AutopilotTask {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  
  title       String
  description String?
  category    String   // SETUP, LEGAL, MARKETING, SALES, OPERATIONS, FINANCE
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, AWAITING_APPROVAL, COMPLETED, SKIPPED, AUTO_EXECUTED
  
  // Autopilot execution
  autoExecutable Boolean  @default(false) @map("auto_executable")
  executedAt     DateTime? @map("executed_at")
  executedBy     String?   @map("executed_by") // USER, SYSTEM, AI
  
  // Approval flow
  requiresApproval Boolean  @default(false) @map("requires_approval")
  approvalData     Json?    @map("approval_data") // What the user needs to approve
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  
  // Scheduling
  scheduledFor DateTime? @map("scheduled_for")
  dueDate      DateTime? @map("due_date")
  
  // Linking to related entities
  relatedType  String?  @map("related_type") // CONTACT, INVOICE, BOOKING, etc.
  relatedId    String?  @map("related_id")
  
  // AI-generated context
  aiContext    Json?    @map("ai_context")
  
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  
  @@index([businessId, status])
  @@index([businessId, scheduledFor])
  @@map("autopilot_tasks")
}

// ---
// NOTIFICATIONS
// ---
model Notification {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  data       Json?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, read, createdAt])
  @@map("notifications")
}

model CustomerNotificationLog {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId      String?  @map("contact_id")
  type           String
  recipientEmail String   @map("recipient_email")
  recipientName  String?  @map("recipient_name")
  subject        String
  status         String   @default("QUEUED")
  messageId      String?  @map("message_id")
  error          String?
  templateData   Json?    @map("template_data")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, type])
  @@index([businessId, status])
  @@map("customer_notification_logs")
}

// ---
// SUBSCRIPTIONS & BILLING
// ---
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan       String   @default("FREE") // FREE, FLOW, KEYFLOW
  status     String   @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELLED, EXPIRED
  currency   String   @default("TTD") // TTD or USD

  priceMonthly  Float    @default(0) @map("price_monthly")
  trialEndsAt   DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelledAt   DateTime? @map("cancelled_at")

  // Payment gateway info
  gateway           String? // wipay, paypal
  gatewaySubId      String? @map("gateway_sub_id")
  gatewayCustomerId String? @map("gateway_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  payments  SubscriptionPayment[]

  @@index([businessId, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  businessId     String   @map("business_id")

  amount         Float
  currency       String   @default("TTD")
  method         String   // wipay, paypal, bank_transfer, cash, manual
  status         String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  reference      String?
  notes          String?
  gateway        String?
  gatewayTxnId   String?  @map("gateway_txn_id")

  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@index([subscriptionId])
  @@map("subscription_payments")
}

model AiUsageLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  feature    String
  model      String   @default("gpt-5.2")
  promptTokens   Int  @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")
  totalTokens    Int  @default(0) @map("total_tokens")
  estimatedCost  Float @default(0) @map("estimated_cost")
  creditsUsed    Int   @default(1) @map("credits_used")

  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([businessId, feature])
  @@map("ai_usage_logs")
}

// ---
// MODULE 9: EXPENSE TRACKING (ProfitLens)
// ---
model ExpenseCategory {
  id         String   @id @default(cuid())
  name       String
  icon       String?
  color      String?
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  budgets    ExpenseBudget[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  currency    String   @default("TTD")
  date        DateTime @default(now())
  vendor      String?
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  paymentMethod String? @map("payment_method")
  tags        String[] @default([])
  isRecurring Boolean  @default(false) @map("is_recurring")
  recurringFrequency String? @map("recurring_frequency")

  categoryId String?          @map("category_id")
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  projectId  String?  @map("project_id")
  contactId  String?  @map("contact_id")
  serviceId  String?  @map("service_id")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
