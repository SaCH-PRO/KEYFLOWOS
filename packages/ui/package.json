{
  "name": "@keyflow/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/components/button.tsx",
      "default": "./src/components/button.tsx"
    },
    "./card": {
      "types": "./src/components/card.tsx",
      "default": "./src/components/card.tsx"
    },
    "./badge": {
      "types": "./src/components/badge.tsx",
      "default": "./src/components/badge.tsx"
    },
    "./drawer": {
      "types": "./src/components/drawer.tsx",
      "default": "./src/components/drawer.tsx"
    },
    "./input": {
      "types": "./src/components/input.tsx",
      "default": "./src/components/input.tsx"
    },
    "./dialog": {
      "types": "./src/components/dialog.tsx",
      "default": "./src/components/dialog.tsx"
    }
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 -c .storybook",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test-runner": "0.24.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "8.6.14"
  }
}
