    },
    {
      "id": "r0.invoices.detail_malformed_bearer",
      "method": "GET",
      "path": "/commerce/businesses/native-dast-business/invoices/native-dast-invoice",
      "headers": { "authorization": "Bearer definitely-not-a-valid-token" },
