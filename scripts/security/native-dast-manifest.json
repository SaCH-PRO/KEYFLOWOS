      "protected": true
    },
    {
      "id": "r0.payments.record_malformed_bearer",
      "method": "POST",
      "path": "/commerce/businesses/native-dast-business/invoices/native-dast-invoice/payments",
      "headers": { "content-type": "application/json", "authorization": "Bearer definitely-not-a-valid-token" },
      "body": { "amount": 1, "method": "CASH", "reference": "native-dast-probe" },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.payments.record_jwt_alg_none",
      "method": "POST",
      "path": "/commerce/businesses/native-dast-business/invoices/native-dast-invoice/payments",
      "headers": { "content-type": "application/json" },
      "bearer_jwt": { "signing": "none", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "body": { "amount": 1, "method": "CASH", "reference": "native-dast-probe" },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.payments.record_jwt_wrong_key",
      "method": "POST",
      "path": "/commerce/businesses/native-dast-business/invoices/native-dast-invoice/payments",
      "headers": { "content-type": "application/json" },
      "bearer_jwt": { "signing": "random-key", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "body": { "amount": 1, "method": "CASH", "reference": "native-dast-probe" },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.payments.tenant_list",
      "method": "GET",
      "path": "/commerce/businesses/native-dast-business/payments",
      "expected_status": [401],
      "protected": true
    },
    {
      "id": "r0.payments.tenant_list_malformed_bearer",
      "method": "GET",
      "path": "/commerce/businesses/native-dast-business/payments",
      "headers": { "authorization": "Bearer definitely-not-a-valid-token" },
      "expected_status": [401],
      "protected": true,
