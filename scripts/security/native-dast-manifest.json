{
  "schema_version": 1,
  "description": "Native DAST probes (V1-13-SEC-NATIVE-DAST). Every protected route probed here is AuthGuard-first, so an anonymous call and a call carrying a credential authentication must refuse (malformed bearer, alg none, wrong key, expired, wrong audience, foreign issuer) must answer 401 and nothing else: a 403 there means authentication accepted the caller and a business guard refused it, which a verifier bypass also produces (review SEC-DAST-1). The env-key tokens are signed with SUPABASE_JWT_SECRET, the key the server verifies with, so the expired, wrong-audience and foreign-issuer probes reach the exp, aud and iss checks; the valid-token control (no iss: the server runs NODE_ENV=test with no SUPABASE_URL) must answer 403 from BusinessGuard, which also proves the server holds that key (review SEC-DAST-2). A 404 means the route is absent and proves nothing. Run against a locally started server only: node scripts/security/native-dast.mjs scripts/security/native-dast-manifest.json with NATIVE_DAST_BASE_URL set to a loopback URL and SUPABASE_JWT_SECRET set to the server's value.",
  "base_url_env": "NATIVE_DAST_BASE_URL",
  "probes": [
    {
      "id": "public.healthz",
      "method": "GET",
      "path": "/healthz",
      "expected_status": [200],
      "body_must_include": ["\"status\":\"ok\""]
    },
    {
      "id": "r0.contacts.list",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "expected_status": [401],
      "protected": true
    },
    {
      "id": "r0.contacts.list_malformed_bearer",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "headers": { "authorization": "Bearer definitely-not-a-valid-token" },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_alg_none",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "none", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_wrong_key",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "random-key", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_expired",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "env-key", "key_env": "SUPABASE_JWT_SECRET", "exp_in_s": -3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_wrong_audience",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "env-key", "key_env": "SUPABASE_JWT_SECRET", "exp_in_s": 3600, "claims": { "aud": "native-dast-not-authenticated", "role": "authenticated" } },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_foreign_issuer",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "env-key", "key_env": "SUPABASE_JWT_SECRET", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated", "iss": "https://native-dast.invalid/auth/v1" } },
      "expected_status": [401],
      "protected": true,
      "invalid_credential": true
    },
    {
      "id": "r0.contacts.list_jwt_valid_non_member",
      "method": "GET",
      "path": "/crm/businesses/native-dast-business/contacts",
      "bearer_jwt": { "signing": "env-key", "key_env": "SUPABASE_JWT_SECRET", "exp_in_s": 3600, "claims": { "aud": "authenticated", "role": "authenticated" } },
      "expected_status": [403],
      "protected": true
    },
    {
      "id": "r0.invoices.list",
      "method": "GET",
      "path": "/commerce/businesses/native-dast-business/invoices",
      "expected_status": [401],
      "protected": true
    },
    {
