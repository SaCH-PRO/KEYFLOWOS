# ============================================================================
# KEYFLOWOS — production environment template
# Copy to .env.production, fill in, keep OUT of git.
# Used by: docker compose --env-file .env.production -f docker-compose.production.yml
# ============================================================================

# ── Domains (DNS: A records → your VPS IP) ──────────────────────────────────
DOMAIN=keyflowos.com
API_DOMAIN=api.keyflowos.com
LIVEKIT_DOMAIN=livekit.keyflowos.com

APP_URL=https://keyflowos.com
PUBLIC_API_URL=https://api.keyflowos.com
PUBLIC_LIVEKIT_WS_URL=wss://livekit.keyflowos.com

# ── Core secrets (generate: openssl rand -hex 32) ───────────────────────────
POSTGRES_PASSWORD=
ADMIN_JWT_SECRET=
BYOK_ENCRYPTION_SECRET=
MINIO_ROOT_USER=keyflow
MINIO_ROOT_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=

# ── Auth (Supabase project) ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
E2B_API_KEY=

# ── LiveKit (generate: openssl rand -hex 12 / 24) ───────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Google Suite OAuth (redirect: https://api.keyflowos.com/connect/google-suite/callback) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.keyflowos.com/connect/google-suite/callback
GOOGLE_STATE_SECRET=

# ── Meta (Facebook/Instagram/Messenger) ─────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_SOCIAL_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── WhatsApp Business ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Chatwoot L1 desk (optional; enable with --profile chatwoot) ─────────────
CHATWOOT_URL=https://chat.keyflowos.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_BUSINESS_ID=
CHATWOOT_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_WINDOW_MS=60000
