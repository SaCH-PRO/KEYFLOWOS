# Ignore environment variables
.env
.env.local

# Environment dumps exported from hosting dashboards (Render, Fly, Railway, ...).
# These hold live credentials — service-role keys, database URLs, JWT secrets —
# and must never be committed. `.env.example` and *.env.template stay tracked
# because they contain placeholders only.
render-env.txt
*-env.txt
env-dump*.txt
.env.backup
.env.production
.env.*.local

# Ignore build output
.next/
dist/
**/dist/

# Ignore node modules
node_modules/

# Early coverage
.early.coverage

# Secret files
attached_assets/client_secret*
*.json.bak

# OS files
.DS_Store
Thumbs.db

# Prisma
packages/db/prisma/*.db
packages/db/src/generated/client/

# Logs
*.log

# Build-time release marker (written by .replit build / start-prod.sh)
.deploy-version
.turbo/cache/
controllers_audit.txt
controllers_chunk_*
screenshot-home.png

# Agent worktrees — transient, never part of the repo
.claude/worktrees/
*.tsbuildinfo

# Cross-session guard runtime state (machine-local; see .claude/hooks/README.md)
.claude/coordination/
.claude/settings.local.json

# agent-control worker runtime state (locks, logs, processed-directive cursor)
.agent-control/.worker/

# Local artifact directories, at any depth. This covers the project thread
# harvester's output (scripts/intelligence/README-project-thread-harvester.md),
# which holds exported conversation text and must stay local wherever the
# harvester is run from; the harvester refuses an --output inside the work
# tree that git does not ignore.
**/.artifacts/

# Python bytecode. CPython folds constant expressions when it compiles, so the
# harvester test's fixture fragments ("sk_" + "live_" + ...) become whole
# secret-shaped literals in its .pyc: never commit one.
__pycache__/
*.py[cod]
