{
  "name": "keyflowos-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --stream -r dev",
    "build": "pnpm --filter @keyflow/db run db:generate && pnpm --filter server build && pnpm --filter web build",
    "build:all": "pnpm run build",
    "start": "pnpm run --parallel --stream start:server start:web",
    "start:all": "pnpm run start",
    "start:server": "pnpm --filter server start",
    "start:web": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter db run db:generate",
    "db:push": "pnpm --filter db exec prisma db push",
    "db:studio": "pnpm --filter db exec prisma studio",
    "ui:dev": "pnpm --filter ui exec storybook dev -p 6006",
    "test:db:soft-delete": "pnpm --filter db exec tsx --env-file .env src/test-soft-delete.ts",
    "verify:up": "bash scripts/verify-up.sh",
    "monitor:uptime": "bash scripts/uptime-monitor.sh",
    "start:prod": "bash scripts/start-prod.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.31",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "prisma": "^5.13.0",
    "tsx": "^4.20.6",
    "turbo": "latest",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "^2.8.32",
      "axios": "^1.13.5",
      "undici": "^6.24.0",
      "rollup": "^4.59.0",
      "effect": "^3.20.0",
      "defu": "^6.1.5",
      "qs": "^6.14.2",
      "follow-redirects": "^1.16.0",
      "dompurify": "^3.4.0",
      "postcss": "^8.5.10",
      "ajv": "^8.18.0",
      "smol-toml": "^1.6.1",
      "multer": "^2.1.1",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "file-type@>=13.0.0 <21.3.2": "^21.3.2",
      "uuid@<14.0.0": "^14.0.0"
    }
  },
  "dependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.11",
    "@swc/helpers": "^0.5.18",
    "@swc/register": "^0.1.10",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "openai": "^6.17.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "ts-node": "^10.9.2"
  }
}
