{
  "name": "keyflowos-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "start:all": "turbo run start",
    "start:server": "turbo run start --filter=server",
    "start:web": "turbo run start --filter=web",
    "lint": "turbo run lint",
    "test:unit": "turbo run test:unit",
    "test:smoke": "turbo run test:smoke",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate",
    "db:push": "pnpm --filter db exec prisma db push",
    "db:migrate": "pnpm --filter db exec prisma migrate dev",
    "db:deploy": "pnpm --filter db exec prisma migrate deploy",
    "db:seed": "pnpm --filter db exec tsx --env-file ../../.env prisma/seed.ts",
    "db:reset": "pnpm --filter db exec prisma migrate reset --force --skip-generate",
    "db:studio": "pnpm --filter db exec prisma studio",
    "ui:dev": "pnpm --filter ui exec storybook dev -p 6006",
    "test:db:soft-delete": "pnpm --filter db exec tsx --env-file .env src/test-soft-delete.ts",
    "verify:up": "bash scripts/verify-up.sh",
    "monitor:uptime": "bash scripts/uptime-monitor.sh",
    "start:prod": "bash scripts/start-prod.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.31",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.5.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.2.5",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": "20.18.1",
    "pnpm": "9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "patchedDependencies": {
      "next@16.2.4": "patches/next@16.2.4.patch"
    },
    "overrides": {
      "baseline-browser-mapping": "^2.8.32",
      "axios": "^1.13.5",
      "undici": "^6.24.0",
      "rollup": "^4.59.0",
      "effect": "^3.20.0",
      "defu": "^6.1.5",
      "qs": "^6.14.2",
      "follow-redirects": "^1.16.0",
      "dompurify": "^3.4.0",
      "postcss": "^8.5.10",
      "ajv": "^8.18.0",
      "@eslint/eslintrc>ajv": "^6.12.6",
      "eslint>ajv": "^6.12.6",
      "smol-toml": "^1.6.1",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "file-type@>=13.0.0 <21.3.2": "^21.3.2",
      "uuid@<9.0.0": "^9.0.1"
    }
  },
  "dependencies": {
    "@sentry/nestjs": "^10.53.1",
    "@sentry/nextjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.11",
    "@swc/helpers": "^0.5.18",
    "@swc/register": "^0.1.10",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "ts-node": "^10.9.2"
  }
}
